# ============== 依赖 ==============
node_modules/

# =============== 环境变量（含密钥，绝不入库）===============
.env
.env.local
.env.*.local
.env.*
!.env.example

# =============== 日志 ===============
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============== 运行时数据 ===============
# Docker MySQL 数据卷（含 .sock / .pid / binlog 等）
data/mysql/
# Docker uploads 持久化（用户上传文件）
data/uploads/
# 本机运行时上传文件
/uploads/
# 业务数据库备份（数据库结构和迁移脚本仍入库）
/sql/backup-*.sql
# 旧 SQLite（已弃用）
data/radio.db*
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm
*.sock
*.pid

# =============== 构建产物 ===============
dist/
admin-web/dist/
# 云函数打包产物，由 cloud/scripts/sync.js 从正式源码生成
/miniprogram/cloudfunctions/api/
*.tsbuildinfo

# =============== Docker / 证书（自签证书含私钥，不入库）===============
deploy/certs/

# =============== 测试覆盖 ===============
coverage/
.nyc_output/

# =============== IDE / 系统 ===============
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
# 微信开发者工具的本机配置
/miniprogram/project.private.config.json

# =============== 调试 / 临时文件（下划线开头 = 本机排查垃圾）===============
_*
# 管理接口共用的正式源码，不属于临时文件
!/cloud/cloudfunctions/api/handlers/admin/_kit.js
!/cloud/cloudfunctions/api/handlers/admin/_people.js
radio-deploy.tar.gz
uploads.tar.gz
radio_data.sql
# 可复跑验证脚本的输出；脚本本身仍入库
/scripts/*-output.txt
# 设计验证截图；设计源码和实际引用资源仍入库
/design-preview/*.png
/preview/student-login-v*/shots/

# =============== 备份目录 ===============
admin-web/_backup/

# =============== 阶段 8 数据迁移产物 ===============
# 导出的待导入数据（含密码哈希等敏感字段，绝不入库）
cloud/migration/out/
# 云开发控制台导出的云库快照（校验用，同样是全量业务数据）
cloud/migration/cloud-dump/

# =============== Python（脚本）==============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# =============== Node ===============
jspm_packages/
.pnpm-store/
