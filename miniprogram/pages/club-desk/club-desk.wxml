<!-- pages/club-desk/club-desk.wxml -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev-l"></view>
    </view>
    <view class="navbar-title">广播通知</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">

    <!-- 社团抬头：头像可点换（换的是自己这一家，后端只认票据） -->
    <view class="club-org">
      <view class="avwrap" hover-class="pressed" bindtap="changeAvatar">
        <view class="club-av">
          <image wx:if="{{club.avatar}}" class="club-av-img" src="{{club.avatar}}" mode="aspectFill" />
          <block wx:else>{{initial}}</block>
        </view>
        <view class="avedit">
          <view class="cam"></view>
        </view>
      </view>
      <view class="grow">
        <view class="on1">{{club.name || '正在进入…'}}</view>
        <view class="on2" wx:if="{{club}}">密钥 {{club.mask}} · 负责人 {{club.ownerName || '未填'}}</view>
      </view>
      <view class="addbtn" hover-class="pressed" bindtap="goNew" aria-label="提报一条">
        <view class="plus"></view>
      </view>
    </view>

    <!-- 我的提交 -->
    <view class="sec-h">
      <text class="sec-t">我的提交 {{count.total}} 条</text>
      <text class="sec-l" bindtap="reload">刷新</text>
    </view>

    <view class="loading" wx:if="{{loading && !list.length}}">加载中……</view>

    <view class="empty" wx:elif="{{!list.length}}">还没有提报过，点右上角 + 写一条</view>

    <block wx:for="{{list}}" wx:key="id">

      <!-- 待审核：可改可撤 -->
      <view class="qcard" data-id="{{item.id}}" bindtap="goDetail">
        <view class="qtop">
          <view class="qt">{{item.title}}</view>
          <view class="st {{item.stCls}}">{{item.statusText}}</view>
        </view>
        <view class="qbody">{{item.body}}</view>
        <view class="qfoot">
          <text>{{item.timeText}} 提交</text>
          <text class="sp"></text>
          <text>{{item.charCount}} 字</text>
        </view>
        <view class="qacts" wx:if="{{item.canEdit}}" catchtap="noop">
          <view class="qa" data-id="{{item.id}}" catchtap="goEdit">修改</view>
          <view class="qa ghost" data-id="{{item.id}}" catchtap="withdraw">撤回</view>
        </view>
      </view>

    </block>

    <view class="switchclub" hover-class="pressed" bindtap="switchClub">换一个社团</view>

  </view>

  <view class="pb-safe"></view>
</view>

<!-- ═══ 调整头像：全屏层（不是新页面，关掉就回社团台） ═══
     ⚠️ 导航栏右上留给微信胶囊，这一层不往那儿放任何元素；关闭走左边 ✕ -->
<view class="crop" wx:if="{{cropOn}}">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="closeCrop" aria-label="关闭">
      <view class="xmark">
        <view class="xmark-a"></view>
        <view class="xmark-b"></view>
      </view>
    </view>
    <view class="navbar-title">调整头像</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="cr-body">
    <!-- 舞台：图绝对定位在正中，位移/缩放全靠内联 transform；圆洞是白色蒙版挖出来的 -->
    <view class="cr-stage" id="cropStage"
          bindtouchstart="onCropStart" catchtouchmove="onCropMove"
          bindtouchend="onCropEnd" bindtouchcancel="onCropEnd">
      <image class="cr-pic" src="{{cropSrc}}" style="{{cropStyle}}" mode="scaleToFill" />
      <view class="cr-hole" style="{{cropHoleStyle}}"></view>
    </view>

    <!-- 提示语 + 复位：一行，整体居中，就贴在裁剪框下沿 —— 不再单占一条滑杆 -->
    <view class="cr-tip">
      <text class="cr-tl">双指缩放 · 拖动移动</text>
      <text class="cr-reset" bindtap="resetCrop">复位</text>
    </view>

    <button class="btn btn-primary btn-block cr-done" bindtap="confirmCrop"
            loading="{{cropBusy}}" disabled="{{cropBusy}}">完成</button>
  </view>

  <!-- 真裁用的离屏画布（720×720 由 JS 定，CSS 只负责藏起来） -->
  <canvas type="2d" id="cropCanvas" class="cr-cv"></canvas>
</view>
