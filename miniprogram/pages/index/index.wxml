<!-- pages/index/index.wxml -->
<launch-mask id="launch" />

<view class="page">
  <!-- 顶部校舍线稿：与伙伴端 desk 欢迎带同一张图（campus-faded.png，渐隐已烘进 alpha），
       位置按调节台定稿：宽 542rpx / 上 35rpx / 右溢出 13rpx，不叠遮罩、不调亮度 -->
  <image class="brand-wm" src="/assets/campus-faded.png" mode="widthFix" aria-hidden="true" />

  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navreserve" style="height: {{navBarHeight}}px"></view>

  <view class="body {{tabMotion}}">

    <!-- 品牌头部（2026-11-01 去掉右上角「关于」i 按钮；「关于广播站」入口仍在「我的」页那条） -->
    <view class="brand-head">
      <image class="brand-logo" src="/assets/station-badge.png" mode="aspectFit" />
      <view class="stack">
        <view class="brand-name">菁悠广播站</view>
        <view class="brand-slogan">菁菁校园情，悠悠广播声</view>
      </view>
    </view>

    <!-- 欢迎卡（2026-11-01）：纯问候，不再显示直播状态。
         副行只说"下一次什么时候见"，四种情形由 index.js#nextLine 按节目数据算出来：
         在播 / 今天还有 / 明天还有 / 本周播完（→ 下周见） -->
    <view class="well">
      <view class="well-hi">{{welcomeHi}}</view>
      <view class="well-line" wx:if="{{welcomeLine}}">{{welcomeLine}}</view>
      <view class="well-foot" hover-class="pressed" bindtap="goSubmit" role="button" aria-label="去投稿">
        <text class="well-go">立即投稿</text>
        <text class="well-ar">→</text>
      </view>
    </view>

    <!-- 本周点歌排期（后台开关 home_song_schedule 服务端把关，关 → visible=false 整块不渲染） -->
    <view class="section" wx:if="{{schedule.visible}}">
      <view class="section-head">
        <text class="t-section">本周点歌排期</text>
        <text class="t-range">{{schedule.rangeText}}</text>
      </view>
      <view class="card-flush" wx:if="{{schedule.hasAny}}">
        <block wx:for="{{schedule.days}}" wx:key="date" wx:for-item="day">
          <view class="sched-day-wrap {{day.isToday ? 'sched-today' : ''}}">
            <view class="sched-day-head">
              <text class="sched-day-name">{{day.weekday}}</text>
              <text class="sched-day-date">{{day.monthDay}}</text>
              <view class="tag-today" wx:if="{{day.isToday}}">今天</view>
            </view>
            <view class="sched-row" wx:for="{{day.songs}}" wx:key="index" wx:for-item="song">
              <view class="sched-when">
                <text class="sched-time">{{song.time}}</text>
                <text class="sched-period">{{song.period}}</text>
              </view>
              <view class="grow sched-song">{{song.title}}</view>
            </view>
            <view class="sched-none" wx:if="{{day.empty}}">今日暂无点歌</view>
          </view>
        </block>
        <view class="sched-foot">排期每周日 18:00 定稿 · 由广播站审核排定</view>
      </view>
      <view class="card-flush" wx:else>
        <view class="empty sched-empty">
          <view>本周排期尚未发布</view>
          <view class="sched-empty-sub">广播站每周日 18:00 定稿后在此展示</view>
        </view>
      </view>
    </view>

    <!-- 本周节目单 -->
    <view class="section">
      <view class="section-head">
        <text class="t-section">本周节目单</text>
        <text class="t-link" hover-class="pressed" bindtap="goPrograms">查看全部</text>
      </view>
      <view class="card-flush" wx:if="{{weekly.length}}">
        <view
          class="card-row"
          wx:for="{{weekly}}"
          wx:key="id"
          hover-class="row-hover"
          data-id="{{item.id}}"
          bindtap="goProgramDetail"
        >
          <text class="row-time">{{item.broadcastTime}}</text>
          <view class="stack grow">
            <text class="t-strong">{{item.title}}</text>
            <text class="t-cap">{{item.host || '主持人未定'}}</text>
          </view>
          <view class="chev-r"></view>
        </view>
      </view>
      <view class="card-flush" wx:else>
        <view class="empty" style="padding: 48rpx 40rpx;">本周暂无节目</view>
      </view>
    </view>

    <!-- 校园公告 -->
    <view class="section">
      <view class="section-head">
        <text class="t-section">校园公告</text>
        <text class="t-link" hover-class="pressed" bindtap="goNotices">全部公告</text>
      </view>
      <view class="card-flush" wx:if="{{notices.length}}">
        <view
          class="card-row"
          wx:for="{{notices}}"
          wx:key="id"
          hover-class="row-hover"
          data-id="{{item.id}}"
          bindtap="goNoticeDetail"
        >
          <view class="tag tag-top" wx:if="{{item.isTop === 1}}">置顶</view>
          <text class="grow notice-txt">{{item.title}}</text>
          <view class="chev-r"></view>
        </view>
      </view>
      <view class="card-flush" wx:else>
        <view class="empty" style="padding: 48rpx 40rpx;">暂无公告</view>
      </view>
    </view>

  </view>

  <!-- 给固定 tabBar 留位 -->
  <view class="pb-tabbar"></view>
</view>
