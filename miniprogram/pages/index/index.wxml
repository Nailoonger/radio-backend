<view class="container">
  <!-- 站徽头部 -->
  <view class="brand-header">
    <image src="/assets/station-logo.jpg" class="brand-logo" mode="aspectFit" />
    <view class="brand-info">
      <view class="brand-name">菁悠广播站</view>
      <view class="brand-slogan">菁菁校园情，悠悠广播声</view>
    </view>
  </view>

  <!-- 正在直播 -->
  <view class="card live-card" wx:if="{{currentProgram}}">
    <view class="live-badge">● 正在直播</view>
    <view class="title">{{currentProgram.title}}</view>
    <view class="subtitle">主持人：{{currentProgram.host || '未知'}}</view>
    <view class="subtitle">播出时间：{{currentProgram.broadcastTime}}</view>
    <view class="program-desc" wx:if="{{currentProgram.desc}}">{{currentProgram.desc}}</view>
    <button class="btn-primary" bindtap="goSubmit" style="margin-top: 24rpx;">我要投稿</button>
  </view>

  <view class="card live-card-empty" wx:elif="{{!loading}}">
    <view class="title">暂无直播</view>
    <view class="subtitle">点歌或投稿，一旦被选中即可在节目中播出</view>
    <button class="btn-primary" bindtap="goSubmit" style="margin-top: 24rpx;">立即投稿</button>
  </view>

  <!-- 公告 -->
  <view class="card" wx:if="{{notices.length}}">
    <view class="title">📢 公告</view>
    <view
      class="notice-item"
      wx:for="{{notices}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goNoticeDetail"
    >
      <view class="notice-title">
        <text wx:if="{{item.isTop === 1}}" class="tag tag-pass">置顶</text>
        {{item.title}}
      </view>
    </view>
  </view>

  <!-- 本周节目单 -->
  <view class="card">
    <view class="title">📻 本周节目单</view>
    <view class="empty" wx:if="{{!weekly.length}}">暂无节目</view>
    <view
      class="program-item"
      wx:for="{{weekly}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goProgramDetail"
    >
      <view class="program-time">{{item.broadcastTime}}</view>
      <view class="program-title">{{item.title}}</view>
      <view class="subtitle">{{item.host || '主持人未定'}}</view>
    </view>
  </view>

  <!-- 介绍入口 -->
  <view class="card about-entry" bindtap="goAbout">
    <view class="title">📖 关于菁悠广播站</view>
    <view class="subtitle">了解我们的开播时间和团队</view>
  </view>
</view>
