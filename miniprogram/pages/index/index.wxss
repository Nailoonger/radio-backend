/* pages/index/index.wxss - 青蓝渐变 */
.brand-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.08);
}
.brand-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ecfeff;
  flex-shrink: 0;
  padding: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.2);
}
.brand-info { flex: 1; min-width: 0; }
.brand-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #0f172a;
  line-height: 1.3;
}
.brand-slogan {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}
.live-card {
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #6366f1 100%);
  color: #fff;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}
.live-card::before {
  content: '';
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
}
.live-card .title,
.live-card .subtitle {
  color: #fff;
}
.live-badge {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  margin-bottom: 12rpx;
  backdrop-filter: blur(8rpx);
}
.live-card .btn-primary {
  background: #fff;
  color: #0891b2;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.program-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.95;
}
.notice-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}
.notice-item:last-child {
  border-bottom: none;
}
.notice-title {
  font-size: 28rpx;
  color: #1e293b;
}
.program-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}
.program-item:last-child {
  border-bottom: none;
}
.program-time {
  color: #0891b2;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}
.program-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
}
.about-entry {
  text-align: center;
  background: linear-gradient(135deg, #ecfeff, #eff6ff);
  border: 1rpx solid #bae6fd;
}
