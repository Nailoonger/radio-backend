/* pages/index/index.wxss */

/* ══════════ 顶部校舍线稿（2026-11-01，照搬伙伴端 pages-partner/desk 那张） ══════════
 * 图 = /assets/campus-faded.png（双向渐隐已烘进 alpha，所以这里不加重叠 mask、不设 opacity，
 *      小程序对 mask-image 支持不稳，敢加就会整块消失）。
 * 参数由调节台 preview/index-bg-tuner-v1 定稿：宽 282px / 上 18px / 右溢出 7px。
 * ⚠️ 本页 .page 是 app.wxss 的 flex column，水印改成 absolute 后不参与布局；
 *    内容三块（状态栏 / 让位区 / 正文）必须抬到 z-index:2，否则会被水印盖住。 */
.page {
  position: relative;
  overflow: hidden;
}
.brand-wm {
  position: absolute;
  top: 35rpx;      /* 18px */
  right: -13rpx;   /* 右溢出 7px */
  width: 542rpx;   /* 282px，mode=widthFix ⇒ 高 308rpx ≈ 160px */
  height: auto;
  z-index: 0;
  pointer-events: none;
}
.statusbar,
.navreserve,
.body {
  position: relative;
  z-index: 2;
}

/* ══════════ 欢迎卡（2026-11-01 替掉原来的「正在直播 / 暂无直播」深色卡） ══════════
 * 只用问候语 + 一句"下一次什么时候见"，不显示任何直播状态。
 * 尺寸沿用原 .tile：--tile #272729 / 圆角 38rpx / 标题 50rpx。 */
.well {
  background: var(--tile);
  border-radius: 38rpx;
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}
.well-hi {
  font-size: 50rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: -0.8rpx;
  line-height: 1.3;
}
.well-line {
  font-size: 25rpx;
  color: #CCCCCC;
  line-height: 1.55;
  letter-spacing: 0.4rpx;
  margin-top: 12rpx;
}
/* 底部文字链：1rpx 的浅色分隔线 + 「立即投稿 →」，整条可点 */
.well-foot {
  display: flex;
  align-items: center;
  border-top: 2rpx solid rgba(255, 255, 255, 0.13);
  padding-top: 23rpx;
  margin-top: 27rpx;
}
.well-go {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.well-ar {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-left: 12rpx;
}

/* 节目单时间列 */
.row-time {
  flex: none;
  min-width: 150rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* 公告标题 */
.notice-txt { font-size: 27rpx; color: var(--ink); line-height: 1.45; }

/* 置顶标签：墨黑底白字（与筛选胶囊同一语言） */
.tag-top { background: var(--ink); color: #fff; }

/* 行按下反馈 */
.row-hover { background: rgba(0, 0, 0, 0.035); }
.pressed { opacity: 0.72; }

/* ══════════ 本周点歌排期（2026-09-21，preview/home-song-schedule-v2 落地） ══════════ */
/* 日期区间（区块标题右侧） */
.t-range {
  font-size: 23rpx;
  color: var(--muted);
  letter-spacing: 0.5rpx;
  font-variant-numeric: tabular-nums;
}

/* 一天一组；「今天」整组抬到强调色浅底上（圆角内嵌在卡里） */
.sched-day-wrap { padding: 0 0 4rpx; }
.sched-today {
  background: var(--accent-tint);
  border-radius: 24rpx;
  margin: 8rpx 16rpx 0;
}
.sched-day-head {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 24rpx 32rpx 6rpx;
}
.sched-day-name { font-size: 25rpx; font-weight: 600; color: var(--ink); }
.sched-day-date {
  font-size: 22rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
/* 「今天」小黑标（与置顶标签同一语言，尺寸更小一号） */
.tag-today {
  font-size: 20rpx;
  font-weight: 500;
  background: var(--ink);
  color: #fff;
  border-radius: var(--r-pill);
  padding: 5rpx 15rpx;
  line-height: 1.35;
}

/* 排期行：左侧时间列（时刻 + 时段上下两行），右侧歌名 */
.sched-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 14rpx 32rpx;
  border-top: 1rpx solid var(--divider);
}
.sched-today .sched-row { border-top-color: rgba(0, 102, 204, 0.10); }
.sched-when { flex: none; width: 150rpx; display: flex; flex-direction: column; }
.sched-time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}
.sched-period { font-size: 20rpx; color: var(--muted); letter-spacing: 1rpx; }
.sched-song {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 今天组里一天还没歌的小字 */
.sched-none {
  font-size: 23rpx;
  color: var(--soft);
  padding: 4rpx 32rpx 20rpx;
}
/* 卡底定稿说明 */
.sched-foot {
  padding: 12rpx 32rpx 19rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--soft);
  letter-spacing: 1rpx;
}
/* 空态（定稿前） */
.sched-empty { padding: 69rpx 40rpx; }
.sched-empty-sub { font-size: 22rpx; color: var(--soft); margin-top: 10rpx; }
