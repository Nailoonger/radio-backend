/* pages/index/index.wxss */

/* 头部右侧「关于」按钮里的 info 图形 */
.i-dot {
  width: 7rpx; height: 7rpx;
  border-radius: var(--r-pill);
  background: var(--ink);
}
.i-stem {
  width: 7rpx; height: 24rpx;
  border-radius: 4rpx;
  background: var(--ink);
}

/* 深色卡上的简介，最多两行 */
.tile-desc {
  font-size: 25rpx;
  color: #CCCCCC;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 节目单时间列 */
.row-time {
  flex: none;
  min-width: 150rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* 公告标题 */
.notice-txt { font-size: 27rpx; color: var(--ink); line-height: 1.45; }

/* 置顶标签：墨黑底白字（与筛选胶囊同一语言） */
.tag-top { background: var(--ink); color: #fff; }

/* 行按下反馈 */
.row-hover { background: rgba(0, 0, 0, 0.035); }
.pressed { opacity: 0.72; }
