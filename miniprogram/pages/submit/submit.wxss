.type-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.06);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.2s;
}
.tab.active {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}
.tab.disabled {
  background: #f1f5f9;
  color: #94a3b8;
  box-shadow: none;
  pointer-events: auto;  /* 仍可点击，给提示 */
}
.closed-tag {
  font-size: 22rpx;
  margin-left: 8rpx;
  opacity: 0.8;
}
.form-row {
  margin-bottom: 24rpx;
}
.form-row:last-child {
  margin-bottom: 0;
}
.label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.required {
  color: #ef4444;
  margin-left: 4rpx;
}
.input {
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}
.input:focus {
  border-color: #06b6d4;
  background: #fff;
}
.textarea {
  width: 100%;
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 160rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}
.textarea:focus {
  border-color: #06b6d4;
  background: #fff;
}
.textarea.large {
  min-height: 320rpx;
}
.tips {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}
