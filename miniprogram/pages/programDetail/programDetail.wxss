/* pages/programDetail/programDetail.wxss */

.intro { color: var(--ink-2); line-height: 1.6; }

/* ---- 留言 ---- */
.comments { display: flex; flex-direction: column; gap: 32rpx; }
.cmt { display: flex; gap: 24rpx; }
.cmt-avatar-wrap {
  width: 72rpx; height: 72rpx; flex: none;
  border-radius: var(--r-pill);
  overflow: hidden;
  background: var(--divider);
}
.cmt-avatar { width: 100%; height: 100%; }
.cmt-avatar-fallback {
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 500; color: var(--muted);
}
.cmt-name { font-size: 25rpx; font-weight: 500; color: var(--ink); }
.cmt-content { font-size: 27rpx; color: var(--ink-2); line-height: 1.55; }

/* ---- 底部留言输入栏（固定） ---- */
.pb-inputbar {
  flex: none;
  height: calc(150rpx + constant(safe-area-inset-bottom));
  height: calc(150rpx + env(safe-area-inset-bottom));
}
.input-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 40rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
  border-top: 2rpx solid var(--divider);
}
.send {
  flex: none;
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  background: var(--accent);
  border-radius: var(--r-pill);
  padding: 18rpx 34rpx;
  line-height: 1.2;
}
.send-off { background: var(--soft); }
.pressed { opacity: 0.72; }
