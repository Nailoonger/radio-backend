.content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #444;
  white-space: pre-wrap;
  margin-top: 16rpx;
}

.brand-hero {
  text-align: center;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #6366f1 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.25);
}
.brand-hero-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff;
  padding: 6rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}
.brand-hero-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 20rpx;
}
.brand-hero-slogan {
  font-size: 22rpx;
  opacity: 0.85;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}
