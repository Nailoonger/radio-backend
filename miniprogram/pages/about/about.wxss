/* pages/about/about.wxss */

/* 底部留白 */
.body { padding-bottom: 80rpx; }

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 16rpx;
}
.brand-logo-lg { width: 200rpx; height: 200rpx; }
.en { letter-spacing: 3rpx; }

.info { padding: 40rpx 36rpx; display: flex; flex-direction: column; gap: 36rpx; }
.info-block { display: flex; flex-direction: column; gap: 16rpx; }
.info-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--ink-2);
  word-break: break-all;
  white-space: pre-wrap;
}
.divider { height: 2rpx; background: var(--divider); }

.pressed { opacity: 0.72; }
