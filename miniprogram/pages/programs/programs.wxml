<!-- pages/programs/programs.wxml -->
<view class="page {{enter ? 'enter' : ''}}">

  <!-- ============ 骨架层（2026-11-13 · preview/loading-skeleton-v1） ============
       照真实版式：导航 → 标题 → 两组（组头 + 3 行卡）。箭头、组头文字照常显示（结构件）。 -->
  <view class="sklayer {{skOut ? 'sklayer-out' : ''}}" wx:if="{{sk}}">
    <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
    <view class="navbar">
      <view class="navbar-back"></view>
      <view class="navbar-title">节目单</view>
      <view class="navbar-spacer"></view>
    </view>
    <view class="body">
      <view class="stack">
        <view class="t-page">节目单</view>
        <view class="t-sub">未来 7 天的节目安排，点击可查看详情</view>
      </view>
      <view class="section" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="section-head">
          <view class="t-section"><view class="sk" style="width:200rpx"></view></view>
        </view>
        <view class="card-flush">
          <view class="card-row" wx:for="{{[1,2,3]}}" wx:for-item="r" wx:for-index="ri" wx:key="*this">
            <view class="sk" style="width:84rpx"></view>
            <view class="grow">
              <view class="sk" style="width:52%"></view>
              <view class="sk" style="width:220rpx;margin-top:14rpx"></view>
            </view>
            <view class="chev-r"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev-l"></view>
    </view>
    <view class="navbar-title">节目单</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body" wx:if="{{!sk || skOut}}">

    <view class="stack in i0">
      <view class="t-page">节目单</view>
      <view class="t-sub">未来 7 天的节目安排，点击可查看详情</view>
    </view>

    <!-- 骨架取代了原来那行「加载中……」（2026-11-13） -->
    <view class="empty" wx:if="{{!loading && !groups.length}}">未来一周暂无节目安排</view>

    <block wx:if="{{!loading && groups.length}}">
      <view class="section in i{{index > 6 ? 7 : index + 1}}" wx:for="{{groups}}" wx:for-item="g" wx:key="date">
        <view class="section-head">
          <text class="t-section">{{g.label}}</text>
        </view>
        <view class="card-flush">
          <view
            class="card-row"
            wx:for="{{g.list}}"
            wx:for-item="p"
            wx:key="id"
            hover-class="row-hover"
            data-id="{{p.id}}"
            bindtap="goDetail"
          >
            <text class="row-time">{{p.broadcastTime}}</text>
            <view class="stack grow">
              <view class="between">
                <text class="t-strong">{{p.title}}</text>
                <view class="live-flag" wx:if="{{p.isLive === 1}}">
                  <view class="dot-live"></view>
                  <text>直播中</text>
                </view>
              </view>
              <text class="t-cap">{{p.host || '主持人未定'}}</text>
            </view>
            <view class="chev-r"></view>
          </view>
        </view>
      </view>
      <view class="t-micro footnote">节目如有临时调整，以广播站当日通知为准</view>
    </block>

  </view>
</view>
