/* pages/memberDetail/memberDetail.wxss */

/* 底部留白，避免最后一张卡贴到屏幕底 */
.body { padding-bottom: 60rpx; }

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0 8rpx;
}
.hero-photo-wrap {
  width: 220rpx; height: 220rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background: var(--parchment);
  margin-bottom: 12rpx;
}
.hero-photo { width: 100%; height: 100%; }
/* 没传照片时的首字兜底（墨底白字圆） */
.hero-photo-fallback {
  display: flex; align-items: center; justify-content: center;
  background: var(--ink); color: #ffffff;
  font-size: 64rpx; font-weight: 600;
}

/* 信息行 */
.info { padding: 12rpx 32rpx; }
.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 32rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--divider);
}
.info-row:last-child { border-bottom: none; }
.info-label { flex: none; font-size: 27rpx; color: var(--muted); }
.info-value {
  font-size: 27rpx;
  color: var(--ink);
  text-align: right;
  line-height: 1.5;
  word-break: break-all;
}
.info-programs { align-items: flex-end; }
.motto { color: var(--ink-2); }

.pressed { opacity: 0.72; }
