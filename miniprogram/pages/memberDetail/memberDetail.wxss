.hero {
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #6366f1 100%);
  padding: 60rpx 32rpx 40rpx;
  border-radius: 24rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(6, 182, 212, 0.25);
}
.hero-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #fff;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}
.hero-name {
  font-size: 44rpx;
  font-weight: bold;
}
.hero-role {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  display: inline-block;
}

.row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.row:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  color: #64748b;
  font-size: 26rpx;
  flex-shrink: 0;
}
.value {
  flex: 1;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.6;
}
.motto {
  white-space: pre-wrap;
  color: #475569;
  font-style: italic;
}

.program-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  margin: 6rpx 8rpx 6rpx 0;
  background: linear-gradient(135deg, #ecfeff, #eff6ff);
  color: #0891b2;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: 1rpx solid #bae6fd;
}

.empty, .loading {
  padding: 120rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}
