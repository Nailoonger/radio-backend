.hero {
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #6366f1 100%);
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  color: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(6, 182, 212, 0.2);
}
.hero-title { font-size: 40rpx; font-weight: bold; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.role-bar {
  white-space: nowrap;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.06);
}
.role-tab {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #64748b;
  background: transparent;
}
.role-tab.active {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: #fff;
  font-weight: 500;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin: 20rpx 8rpx 12rpx;
  display: flex;
  align-items: center;
}
.group-title::before {
  content: '';
  display: inline-block;
  width: 6rpx; height: 24rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  margin-right: 12rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.member-cell {
  width: calc((100% - 32rpx) / 3);
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.06);
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ecfeff;
  margin: 0 auto 12rpx;
  display: block;
}
.name {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.role {
  font-size: 22rpx;
  color: #0891b2;
  margin-top: 4rpx;
}
.grade {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loading, .empty {
  padding: 80rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}
