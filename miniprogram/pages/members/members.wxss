/* pages/members/members.wxss */

/* 顶层 tab：社干 / 部门人员 —— 用全局滑动分段控件 .segment（app.wxss），
 * 指示器宽度/位移在 wxml 内联传入 */

/* 模块开关关闭时的页内提示条（.body 的 gap 已负责上下间距） */
.paused {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 26rpx 30rpx;
  border-radius: 24rpx;
  background: #FAEEDA;
  border: 2rpx solid #FAC775;
}
.paused-title {
  font-size: 27rpx;
  font-weight: 500;
  color: #854F0B;
  line-height: 1.3;
}
.paused-desc {
  font-size: 23rpx;
  color: #BA7517;
  line-height: 1.5;
}

/* 横向滚动的筛选条：负 margin 抵消 .body 的左右内边距，让胶囊能顶到屏幕边 */
.filters-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 0 -40rpx;
}
.filters {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 40rpx;
}

/* 成员网格：3 列
 * 注意：calc((100% - 40rpx) / 3) 在真机上会因亚像素取整把第三张卡挤到下一行，
 * 这里留 1rpx 余量。 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 36rpx 20rpx;
}
.mcard {
  position: relative;          /* 社干角标的定位基准 */
  width: calc((100% - 40rpx) / 3 - 1rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.mphoto-wrap {
  width: 100%;
  height: 0;
  padding-bottom: 100%;          /* 1:1 圆角方图（用 padding 撑高，image 是替换元素不适合） */
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--parchment);
  position: relative;
}
.mphoto {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}
/* 没传照片时的首字兜底（与全站头像机制一致：墨底白字） */
.mphoto-fallback {
  display: flex; align-items: center; justify-content: center;
  background: var(--ink); color: #ffffff;
  font-size: 56rpx; font-weight: 600; letter-spacing: 0;
}
.mname {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.3;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mrole {
  font-size: 22rpx;
  color: var(--accent);
  line-height: 1.3;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mgrade {
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.3;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mcard-hover { opacity: 0.72; }

.footnote { text-align: center; }

/* 部门小标题 + 人数 */
.t-section-meta {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 400;
}
