/* pages/club-code/club-code.wxss */
@import "../../styles/club.wxss";

.code-body { padding-top: 40rpx; }

/* ══════ 社团轮播（弧形旋转木马） ══════
 * 依据 preview/notice-hub-v5 · s-code 屏，1px(设计) × 1.923 换算：
 *   86px→166rpx  74px→142rpx  94px→181rpx  142px→273rpx  196px→377rpx  780px→1500rpx
 */
.car {
  position: relative;
  height: 258rpx;
  perspective: 1500rpx;
  perspective-origin: 50% 50%;
}
.car-stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  transform-style: preserve-3d;
}
.car-i {
  position: absolute;
  left: -83rpx;
  top: -83rpx;
  width: 166rpx;
  height: 166rpx;
  border-radius: 50%;
  background: #fff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  /* transform / opacity / z-index 由 js 按位次写进 style，这里只管过渡 */
  transition: transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.62s;
  box-shadow: 0 23rpx 50rpx -27rpx rgba(15, 28, 46, 0.4), 0 0 0 2rpx rgba(0, 0, 0, 0.05);
}
/* 关过渡：① 首帧落位（整排叠在中心，不关会补间成一次从中间散开）
           ② 转过半个圆的那枚瞬移屏外那一帧（不关就横穿整个正面） */
.car-stage.nt .car-i,
.car-i.nt { transition: none; }

/* ⚠️ 这里不写 border-radius：圆形由外层 .car-i（白圆盘 + overflow:hidden）负责削。
   图片只按源图比例缩到圆盘里（宽高在 onAvLoad 里算），比例对上了 aspectFill 就不裁内容。
   写死 142×142 的方块会把竖图上下切掉（2026-11-09 学生会那张就是这么被切的）。 */
.car-img { display: block; max-width: 142rpx; max-height: 142rpx; }
/* 没上传过徽标：社团名首字，同样圆形 */
.car-fb {
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  background: var(--accent-tint);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.car-nm {
  /* ⚠️ `.body` 是 flex column 且 gap: 34rpx —— 名称属于轮播本身，不该跟它隔 34rpx。
     这里抵掉 gap，净留 4rpx（原型是 2px）。不加这句，徽标和名称之间会空出 34px。 */
  margin-top: -30rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.4rpx;
  line-height: 1.3;
  min-height: 34rpx;
}

.car-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  margin: 34rpx 0 30rpx;
}

/* ══════ 六格 ══════ */
.codebox {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}
.cell {
  width: 88rpx; height: 108rpx;
  border-radius: 22rpx;
  background: var(--parchment);
  color: var(--ink);
  font-size: 40rpx; font-weight: 700;
  letter-spacing: 0;
  display: flex; align-items: center; justify-content: center;
  font-variant-numeric: tabular-nums;
}
/* 当前格：描边是「光标在这儿」的状态含义，不是装饰 */
.cell.cur { box-shadow: inset 0 0 0 3rpx var(--accent); }

.codeinput {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  width: 100%; height: 100%;
  opacity: 0;
  font-size: 40rpx;
}

/* ══════ 粘贴 ══════ */
.pastebar { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.paste {
  font-size: 23rpx;
  color: var(--accent);
  padding: 10rpx 6rpx;
}

.hintline {
  font-size: 23rpx;
  color: var(--red-fg);
  text-align: center;
  margin-top: 8rpx;
  min-height: 34rpx;
}

.enter { margin-top: 26rpx; }
