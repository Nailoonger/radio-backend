/* app.wxss — 菁悠广播站 · 设计系统 v2
 * 依据：Ardot 设计稿「菁悠广播站 · 小程序改版方案」（fileId 726404665321310）
 *
 * 三条硬规则：
 *   1. 全局只有一个强调色 --accent，所有"可点"的东西都用它
 *   2. 不用任何装饰性渐变、不用彩色投影
 *   3. 深色卡（--tile）是视觉主角，其余信息一律退到羊皮纸（--parchment）
 *
 * 尺寸换算：设计稿按 390pt 宽出图，1px(设计) ≈ 1.923rpx；正文 15px → 28rpx。
 */

page {
  /* ---- 色板 ---- */
  --ink: #1D1D1F;
  --ink-2: #333333;
  --muted: #7A7A7A;
  --soft: #C7C7CC;
  --hairline: #E0E0E0;
  --divider: #F0F0F0;
  --parchment: #F5F5F7;
  --canvas: #FFFFFF;
  --tile: #272729;
  --tile-2: #3A3A3C;
  --accent: #0066CC;
  --accent-on-dark: #2997FF;
  --live: #FF453A;

  --amber-bg: #FEF3C7;
  --amber-fg: #8A6100;
  --green-bg: #E7F5EC;
  --green-fg: #1E7A46;
  --red-bg: #FDE8E8;
  --red-fg: #B42318;

  /* 强调色浅底：点歌 v2 的「已补位·待审」胶囊与「窗口开放中」状态条用它 */
  --accent-tint: #EAF3FD;

  /* ---- 圆角 ---- */
  --r-card: 34rpx;
  --r-input: 23rpx;
  --r-pill: 9999rpx;

  /* ---- 动效曲线（2026-10-01 补）----
     ⚠️ 登录页从 v2 起就写了 `transition: … var(--ease)`，但设计系统里一直没有
        这个变量 ⇒ **整条 transition 声明失效**（聚焦输入框时描边的过渡其实从没生效过，
        而且是静默的：不报错、截图也看不出来）。这里补上真实定义，而不是把那两处删掉。 */
  --ease: cubic-bezier(0.4, 0, 0.2, 1);

  /* ---- 投影阶梯（2026-10-01 加） ----
     L1「白卡大投影」：不引入新颜色，纯靠海拔差当焦点 —— 白卡浮在羊皮纸灰上。
     普通卡 = 第 1 档；L1 白卡 = 第 3 档（比普通卡重两档）。
     ⚠️ 全部是纯黑透明（三通道极差 0）—— 属中性投影，不是彩色投影。 */
  --sh-card: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  --sh-lift: 0 16rpx 44rpx -16rpx rgba(0, 0, 0, 0.16), 0 4rpx 12rpx -4rpx rgba(0, 0, 0, 0.06);

  /* ---- 间距阶梯 ---- */
  --s1: 8rpx;
  --s2: 16rpx;
  --s3: 25rpx;
  --s4: 34rpx;
  --s5: 50rpx;
  --s6: 64rpx;

  background: var(--canvas);
  color: var(--ink);
  /* 字体栈：真机走系统中文（iOS 苹方 / 安卓 MiSans）；Windows 工具里没有苹方，
   * 依次尝试鸿蒙 / 小米 / 思源，都没有才退到雅黑（雅黑小字号发闷，是工具里显挤的主因） */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans SC",
               "MiSans", "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue",
               "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ============ 文字层级（只有 5 档，不要临时加） ============ */
.t-page    { font-size: 54rpx; font-weight: 600; letter-spacing: -0.8rpx; line-height: 1.25; }
.t-title   { font-size: 42rpx; font-weight: 600; letter-spacing: -0.6rpx; line-height: 1.3; }
.t-section { font-size: 32rpx; font-weight: 600; letter-spacing: -0.7rpx; line-height: 1.35; }
.t-strong  { font-size: 30rpx; font-weight: 500; line-height: 1.4; }
.t-body    { font-size: 28rpx; line-height: 1.5; }
/* 小字号中文加一点点字距，可读性明显更好（设计稿同级文本均为 0.5px 左右） */
.t-sub     { font-size: 25rpx; color: var(--muted); line-height: 1.5; letter-spacing: 0.5rpx; }
.t-cap     { font-size: 23rpx; color: var(--muted); line-height: 1.5; letter-spacing: 0.5rpx; }
.t-micro   { font-size: 21rpx; color: var(--muted); line-height: 1.45; letter-spacing: 0.5rpx; }
.t-link    { font-size: 25rpx; color: var(--accent); }
.t-on-dark { color: var(--canvas); }
.t-dim     { color: #CCCCCC; }
/* 可点元素的按下反馈：此前只有 submit.wxss 定义了它，其它页写 hover-class="pressed" 等于没有反馈 */
.pressed   { opacity: 0.72; }

/* ============ 页面骨架 ============ */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--canvas);
}
/* 自定义导航：让出状态栏 */
.statusbar { width: 100%; flex: none; }
/* 再让出右上角微信胶囊那一行（44px） */
.navreserve { height: 88rpx; flex: none; }

/* 非 tab 页的标题栏（替原来的原生导航） */
.navbar {
  height: 88rpx;
  flex: none;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  gap: 16rpx;
}
.navbar-back {
  width: 72rpx; height: 72rpx; flex: none;
  border-radius: var(--r-pill);
  background: var(--parchment);
  display: flex; align-items: center; justify-content: center;
}
.navbar-back-icon { width: 36rpx; height: 36rpx; }
.navbar-title { flex: 1; text-align: center; font-size: 30rpx; font-weight: 600; }
.navbar-spacer { width: 72rpx; flex: none; }

/* 正文容器 */
.body {
  flex: 1;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}
/* 给固定 tabBar 留位 */
.pb-tabbar {
  flex: none;
  height: calc(190rpx + constant(safe-area-inset-bottom));
  height: calc(190rpx + env(safe-area-inset-bottom));
}

/* ============ 通用排布 ============ */
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.stack { display: flex; flex-direction: column; }

/* ============ 卡片 ============ */
.card {
  background: var(--parchment);
  border-radius: var(--r-card);
  padding: 32rpx;
}
/* 列表型卡片：行自带内边距，卡片只留上下 8rpx */
.card-flush {
  background: var(--parchment);
  border-radius: var(--r-card);
  padding: 8rpx 0;
}
.card-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 18rpx 32rpx;
}

/* ============ 按钮 ============ */
button::after { border: none; }
/* 微信默认 button 是「固定宽度 + auto margin 居中」，且默认样式的优先级
 * 比单个类名高（会压过 .btn-block 的 width:100%），必须用元素+类选择器压回去。
 * 普通按钮回到内容宽（flex 行内当 flex-item 用），需要铺满的加 .btn-block。 */
button.btn {
  display: block;
  width: auto;
  margin-left: 0;
  margin-right: 0;
}
.btn {
  font-size: 30rpx;
  border-radius: var(--r-pill);
  padding: 22rpx 44rpx;
  text-align: center;
  line-height: 1.2;
  border: none;
}
.btn-primary { background: var(--accent); color: #fff; font-weight: 600; }
.btn-primary[disabled] { background: #B9D2EE; color: #fff; }
.btn-ghost {
  background: transparent;
  color: var(--accent-on-dark);
  border: 2rpx solid var(--accent-on-dark);
  font-weight: 500;
}
.btn-on-tile { background: #fff; color: var(--accent); font-weight: 600; }
/* 铺满：声明在 button.btn 之后，同优先级下后者生效 */
button.btn-block,
.btn-block { width: 100%; font-size: 32rpx; padding: 30rpx 0; }
/* 底部固定操作区（投稿页用）。左右 40rpx 与 .body 一致，这样按钮和 tabBar 胶囊等宽 */
.bottom-cta { flex: none; padding: 16rpx 40rpx 28rpx; }

/* ============ 标签 / 状态 ============ */
.tag {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--r-pill);
  padding: 8rpx 22rpx;
  line-height: 1.35;
}
.tag-pending { background: var(--amber-bg); color: var(--amber-fg); }
.tag-pass    { background: var(--green-bg); color: var(--green-fg); }
.tag-reject  { background: var(--red-bg);   color: var(--red-fg); }
/* v2 第 4 态「候补中」：中性灰 —— 不是失败也不是通过，只是还在排队 */
.tag-queued  { background: var(--divider);  color: var(--ink-2); }
/* v2 第 5 态「已补位 · 待审」：占着位、还没人审，是唯一需要管理员尽快动手的状态，给强调色浅底 */
.tag-promoted { background: var(--accent-tint); color: var(--accent); }

/* ══════════ 协议版新增的 3 个状态胶囊（docs/song-protocol.md）══════════
 * 派生 status 从 5 个扩到 8 个（4 保留为 v2 遗留），这里只补缺的三种：
 *   6 已通过 · 待排期 —— 审核过了、等系统排位（与 .tag-promoted 同色，但语义收敛成「等排期」）
 *   5 已播放         —— 正常播完，历史态，填灰不抢眼
 *   7 已取消         —— 学生自己撤的，用描边避免在列表里看着像成功
 * 描边款补了 padding 差额（2rpx 边框 vs 基础款无边框），保证三种胶囊视觉等高。 */
.tag-acc     { background: var(--accent-tint); color: var(--accent); }
.tag-mute    { background: var(--divider);     color: var(--muted); }
.tag-outline {
  background: #fff;
  border: 2rpx solid var(--hairline);
  color: var(--muted);
  padding: 6rpx 20rpx;
}

/* ============ 点歌时间窗口状态条（v2，常驻；投稿页与我的投稿页共用） ============
 * 两行结构：第一行是「规则」（每周六 18:00 – 周日 18:00，稳定不变），
 * 第二行是「此刻状态 + 倒计时」（变化，开放中走强调色）。
 * 一行塞不下 —— 390px 下规则串 + 倒计时必然折行，且规则稳定、状态易变，分开讲更清楚。 */
.win-bar {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 20rpx 26rpx; border-radius: 20rpx;
  background: var(--parchment);
}
/* 开放中只换底色（平色，不是渐变）+ 圆点变强调色 */
.win-bar.open { background: var(--accent-tint); }
.win-dot {
  width: 12rpx; height: 12rpx; margin-top: 9rpx; flex: none;
  border-radius: var(--r-pill); background: var(--soft);
}
.win-bar.open .win-dot { background: var(--accent); }
.win-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.win-txt { font-size: 25rpx; color: var(--ink-2); }
.win-sub { font-size: 23rpx; color: var(--muted); letter-spacing: 0.5rpx; }
.win-bar.open .win-sub { color: var(--accent); font-weight: 600; }
/* 直播小圆点 */
.dot-live {
  width: 14rpx; height: 14rpx; flex: none;
  border-radius: var(--r-pill);
  background: var(--live);
}
/* 深色卡上的浅色小标签 */
.chip {
  font-size: 21rpx;
  font-weight: 500;
  color: #CCCCCC;
  background: var(--tile-2);
  border-radius: var(--r-pill);
  padding: 12rpx 24rpx;
  letter-spacing: 1rpx;
}

/* ============ 筛选胶囊 ============ */
.filter { font-size: 25rpx; font-weight: 500; border-radius: var(--r-pill); padding: 14rpx 28rpx; color: var(--muted); background: var(--divider); }
.filter.on { color: #fff; background: var(--ink); }

/* ============ 分段控件（胶囊内嵌白块） ============ */
/* 白色高亮块做成滑动指示器（与 tabBar 同一套模式）：
 * .segment 定位基准，指示器的宽度/位移由页面按自己的格数内联传入 */
.segment {
  position: relative;
  display: flex;
  background: var(--divider);
  border-radius: var(--r-pill);
  padding: 8rpx;
}
.segment-indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  border-radius: var(--r-pill);
  background: #fff;
  transition: transform 360ms cubic-bezier(0.22, 0.61, 0.36, 1);
}
.segment-item {
  position: relative;          /* 文字压在指示器上面 */
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
  padding: 16rpx 0;
  border-radius: var(--r-pill);
  line-height: 1.2;
  transition: color 240ms ease;
}
.segment-item.on { color: var(--ink); font-weight: 600; }

/* ============ 深色卡（直播 / 节目头） ============ */
.tile {
  background: var(--tile);
  border-radius: 38rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.tile-title { font-size: 50rpx; font-weight: 600; color: #fff; letter-spacing: -0.8rpx; line-height: 1.3; }
.tile-meta { font-size: 25rpx; color: #CCCCCC; letter-spacing: 0.5rpx; }
.tile-status { display: flex; align-items: center; gap: 16rpx; font-size: 23rpx; font-weight: 500; color: #CCCCCC; }
.tile-actions { display: flex; gap: 20rpx; margin-top: 4rpx; }
.tile-chips { display: flex; gap: 16rpx; }

/* ============ 表单 ============ */
.form { background: var(--parchment); border-radius: var(--r-card); padding: 34rpx; display: flex; flex-direction: column; gap: 34rpx; }
.field { display: flex; flex-direction: column; gap: 16rpx; }
.field-label { font-size: 25rpx; font-weight: 500; color: var(--muted); }
/* ⚠️ 微信 input 组件自带默认高度，如果只加上下 padding 不设 height，
 *    内容区会被挤成负数，占位文字直接被裁掉一半。
 *    单行输入统一用「固定高 + 行高居中」，不要上下 padding。 */
.input {
  background: #fff;
  border-radius: var(--r-input);
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.input-sm { height: 76rpx; line-height: 76rpx; padding: 0 26rpx; }
/* 多行 textarea：恢复行高、保留上下 padding。
 * .input-area / .input-area-lg 各自都带全行高和内边距，单独用哪个都不会漏。 */
.input-area { height: 176rpx; line-height: 1.5; padding: 24rpx 28rpx; }
.input-area-lg { height: 300rpx; line-height: 1.5; padding: 24rpx 28rpx; }
.ph { color: var(--soft); }

/* ============ 空态 / 加载 ============ */
.empty { padding: 140rpx 40rpx; text-align: center; color: var(--soft); font-size: 26rpx; }
.loading { padding: 120rpx 0; text-align: center; color: var(--soft); font-size: 26rpx; }

/* ============ 图标（由 scripts 从设计稿 SVG 栅格化生成） ============ */
.ic { flex: none; }
.ic-16 { width: 32rpx; height: 32rpx; }
.ic-18 { width: 36rpx; height: 36rpx; }
.ic-20 { width: 40rpx; height: 40rpx; }
.chev { width: 32rpx; height: 32rpx; flex: none; }

/* ============ tab 页通用头部 ============ */
.brand-head { display: flex; align-items: center; gap: 28rpx; }
.brand-logo { width: 88rpx; height: 88rpx; flex: none; }
.brand-name { font-size: 42rpx; font-weight: 600; letter-spacing: -0.6rpx; line-height: 1.25; }
/* 设计稿里口号有 1.2px 字距（≈2.3rpx），漏了会显得挤 */
.brand-slogan { font-size: 25rpx; color: var(--muted); margin-top: 6rpx; letter-spacing: 2rpx; }
.icon-btn {
  width: 80rpx; height: 80rpx; flex: none;
  border-radius: var(--r-pill);
  background: var(--parchment);
  display: flex; align-items: center; justify-content: center;
}

/* 区块标题行 */
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.section { display: flex; flex-direction: column; }

/* ============ CSS 画的通用小图标（免素材） ============ */
/* 右箭头：旋转 45° 的方框，只留上、右两条边 */
.chev-r {
  width: 18rpx; height: 18rpx; flex: none;
  border-top: 4rpx solid var(--soft);
  border-right: 4rpx solid var(--soft);
  transform: rotate(45deg);
}
/* 左箭头（返回键用）：只留下、左两条边 */
.chev-l {
  width: 20rpx; height: 20rpx; flex: none;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/* 多行截断 */
.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Tab 内容轻推淡入；只挂 body，避免移动固定导航、弹层和启动遮罩。 */
.tab-content-prepare { opacity: .6; }
.tab-content-right { animation: tabContentRight 400ms cubic-bezier(.22,.61,.36,1) both; }
.tab-content-left { animation: tabContentLeft 400ms cubic-bezier(.22,.61,.36,1) both; }
@keyframes tabContentRight {
  from { opacity: .6; transform: translateX(20rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes tabContentLeft {
  from { opacity: .6; transform: translateX(-20rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* ============================================================
   加载骨架 + 进场（2026-11-13 · preview/loading-skeleton-v1、v2 落地）
   ------------------------------------------------------------
   两种写法，别混：
     · 纯骨架   <view class="sk-row h-title"><view class="sk" style="width:400rpx"></view></view>
     · 同构     <view class="sk-row"><view class="sk" style="width:300rpx"></view>
                  <text>真文字</text></view>     ← 数据到了把 .sk 删掉即可，行高由 .sk-row 决定
   零位移的前提是 .sk 不参与行高计算 —— 见下面 ⚠️⚠️。
   ============================================================ */

/* 骨架行：高度由 line-height 决定，块只挂在基线上，不撑行盒 */
.sk-row { display: block; }
.sk-row.h-page  { line-height: 1.25; }
.sk-row.h-title { line-height: 1.3; }
.sk-row.h-sec   { line-height: 1.35; }
.sk-row.h-body  { line-height: 1.5; }

/* 骨架块。
   ⚠️⚠️ vertical-align 必须是 baseline：用 middle 会让 inline-block 撑高行盒
   （实测某一行多出 4px，数据落地时整页往下跳）。baseline 对齐时块只从基线往上长，
   行盒仍由 line-height 决定 ⇒ 换成真文字零位移。
   top 用 relative 微调视觉居中 —— relative 不参与布局，不影响高度。 */
.sk {
  display: inline-block;
  vertical-align: baseline;
  position: relative;
  top: .16em;
  height: .62em;
  /* flex:none —— 骨架块经常被放进 flex 行（.msl / .ebrow / .mod-f），
     不写它会被当成可压缩项挤扁，宽度最后全靠运气 */
  flex: none;
  border-radius: 6rpx;
  background-color: #EAEAED;
  /* ⚠️ 必须裁：块内亮带超出块边界的部分要切掉 —— 光只在骨架里走，不在页面上扫。
     实测：空的 inline-block 加 overflow:hidden 后基线仍在底边，
     行盒高度与块位置跟 visible 相比差 0.00px ⇒ 不会破坏「骨架↔真内容零位移」的 baseline 对齐
     （探针 _opfit/sk-baseline.html，7 组对照）。 */
  overflow: hidden;
}
/* 底色分三档：#EAEAED 白底 / #E2E2E7 羊皮纸底（#EAEAED 在 #F5F5F7 上几乎看不见）/
   rgba(255,255,255,.24) 深底 */
.sk.sk-p { background-color: #E2E2E7; }
.sk.sk-d { background-color: rgba(255, 255, 255, .24); }
/* 胶囊 / 圆盘 / 方角小件 */
.sk.sk-r { border-radius: 9999rpx; }
.sk.sk-c { border-radius: 50%; }
.sk.sk-sq { border-radius: 8rpx; }

/* ── 骨架排版件（2026-11-16）：只给**尺寸与排布**，不给色 ──
   ⚠️ 这里再写 background / border-radius，就等于把 .sk 的底色和块内扫光一起压掉
      （同特异性、页面样式写在后 ⇒ 静默生效、页面看着像一排不动的灰条）。
   高度按真实字号的字面高给：标题 42rpx→30rpx，正文/时间 23~30rpx→22rpx。 */
.sk-l { height: 30rpx; top: 0; }   /* 标题行 / 正文行 */
.sk-s { height: 22rpx; top: 0; }   /* 时间、来源、计数 */
/* 多行正文：flex 列 + gap，行距 = 真实的 line-height 差，落地时纵向不跳 */
.sk-para { display: flex; flex-direction: column; gap: 22rpx; }
.sk-hd   { display: flex; flex-direction: column; gap: 26rpx; }
/* 进 flex 列后基线微调没意义了，行距完全由 gap 决定 ⇒ 归零，免得整段下移 4rpx */
.sk-para .sk, .sk-hd .sk { top: 0; }

/* ══════════ 块内扫光（2026-11-16 v3 定案 · preview/loading-skeleton-v3）══════════
   光**只在这个灰块内部**从左缘进、右缘出，扫完接下一轮。页面底色（卡片之间、卡片外侧）
   上一条光带都不出现 —— 靠上面的 overflow:hidden 物理裁掉，不是靠"注意别扫出去"。
   ⚠️ 只动 transform 一个属性 ⇒ 全程合成层，主线程零参与，不重绘不重排。
   ⚠️⚠️ 别改回整层光带（`.sklayer::after` 铺一条扫过去）：那会扫到页面底色，等于擦屏幕，v2 已否。
   ⚠️ 也别改回每个块 `background-position` 动画：那块与块不同步，还每帧重绘背景，v1 已否。
   窄块（角标 / 小胶囊）靠 min-width 兜底：亮带比块还宽时被裁成一整块亮一下，这不是 bug。 */
.sk::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 60%;
  min-width: 64rpx;
  background: linear-gradient(100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, .88) 50%,
    rgba(255, 255, 255, 0) 100%);
  transform: translate3d(-100%, 0, 0);
  will-change: transform;
  animation: skInner 1.4s linear infinite;
  pointer-events: none;
}
@keyframes skInner {
  from { transform: translate3d(-100%, 0, 0); }
  to   { transform: translate3d(170%, 0, 0); }
}

/* 骨架层：盖住首屏。⚠️ 用 fixed 不是 absolute —— absolute 会跟着页面滚，
   用户往下滑就滑到「还没画骨架的空白」上。z-index 25 < 底栏 30，底栏仍可点。 */
.sklayer {
  position: fixed;
  left: 0; right: 0; top: 0;
  height: 100vh;
  z-index: 25;
  background: var(--canvas);   /* 学生端白页；伙伴端页面自己覆盖成 #F5F5F7 */
  overflow: hidden;
  transition: opacity .12s linear;
}
.sklayer-out { opacity: 0; pointer-events: none; }

/* ============ 进场：一行一个单元，从上到下依次顶出来 ============
   规则：一个视觉行 = 一个入场单元（两列网格同一行的两张卡同时，不一张接一张 ——
   否则一高一低错开半个节拍，看着像加载乱了）。行间隔 55ms、单行 340ms。
   ⚠️ 只动 transform + opacity，绝不做 height / margin 动画（逐帧重排，卡片一多就掉帧）。
   ⚠️ fill-mode 用 backwards 不用 both：动画被系统禁用时 both 会停在 from（opacity:0）
       ⇒ 整屏空白；backwards 结束后回到元素默认的可见状态，最坏情况只是没有动画。 */
@keyframes cardIn {
  from { opacity: 0; transform: translate3d(0, 28rpx, 0) scale(.985); }
  to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}
.enter .in { animation: cardIn 340ms cubic-bezier(.22, 1, .36, 1) backwards; }
/* 延迟用类，不用 CSS 变量：wxml 内联自定义属性在部分安卓 WebView 上不保证生效 */
.enter .in.i0 { animation-delay: 0ms; }
.enter .in.i1 { animation-delay: 55ms; }
.enter .in.i2 { animation-delay: 110ms; }
.enter .in.i3 { animation-delay: 165ms; }
.enter .in.i4 { animation-delay: 220ms; }
.enter .in.i5 { animation-delay: 275ms; }
.enter .in.i6 { animation-delay: 330ms; }
.enter .in.i7 { animation-delay: 385ms; }

/* 系统开「减少动态效果」：块内扫光停、进场不做。
   （亮带停在 from 位置 = 完全在块左缘外，等于不可见；骨架块本身有底色，不会消失。
     进场用 backwards 也不会停在透明帧） */
@media (prefers-reduced-motion: reduce) {
  .sk::after { animation: none; }
  .enter .in { animation: none; }
}
