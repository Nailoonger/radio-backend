<!-- pages-admin/review/review.wxml -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">投稿 & 点歌审核</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <!-- 三段筛选：待审核 / 已通过 / 已驳回 -->
    <view class="filters">
      <view class="fl {{tabIndex === index ? 'on' : ''}}"
            wx:for="{{tabs}}" wx:key="*this"
            data-idx="{{index}}" bindtap="switchTab">
        <text>{{item}}</text>
        <text class="n">{{counts[index]}}</text>
      </view>
    </view>

    <!-- 首次加载 -->
    <view class="hint-note" wx:if="{{loading && list.length === 0}}">正在加载……</view>

    <!-- 空状态 -->
    <view class="hint-note" wx:elif="{{list.length === 0}}">
      {{tabIndex === 0 ? '暂时没有待审核的投稿' : (tabIndex === 1 ? '还没有已通过的投稿' : '还没有已驳回的投稿')}}
    </view>

    <block wx:else>
      <view class="list">
        <view class="item" hover-class="item-hover"
              wx:for="{{list}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onItemTap">
          <view class="i-top">
            <text class="i-kind {{item.isArticle ? 'art' : ''}}">{{item.typeText}}</text>
            <text class="i-name">{{item.title}}</text>
          </view>
          <view class="i-note" wx:if="{{item.note}}">{{item.note}}</view>
          <view class="i-meta">{{item.meta}}</view>

          <!-- 待审：两个动作；其余状态只给结论 -->
          <view class="i-act" wx:if="{{item.reviewStatus === 0}}">
            <button class="btn-sm btn-pass" hover-class="pressed"
                    catchtap="onApprove" data-id="{{item.id}}">通过</button>
            <button class="btn-sm btn-quiet" hover-class="pressed"
                    catchtap="onReject" data-id="{{item.id}}">驳回</button>
          </view>
          <view class="i-act" wx:else>
            <!-- ⚠️ 内容必须写在同一行：<text> 会保留换行，拆行写会多出一个空行把胶囊撑高 -->
            <text class="tag {{item.tagClass}}">{{item.tagText}}</text>
          </view>
        </view>
      </view>

      <view class="hint-note" wx:if="{{hasMore}}">上滑加载更多</view>
      <view class="hint-note" wx:elif="{{list.length >= 6}}">没有更多了</view>
    </block>
  </view>
</view>
