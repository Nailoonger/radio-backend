/* 伙伴端原生小程序登录，单列手机布局；浅色浮层及中性阴影。 */
page {
  background: var(--parchment, #F5F5F7);
}
.partner-login-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: var(--parchment, #F5F5F7);
}
.login-backdrop {
  position: absolute;
  inset: 0 0 auto;
  height: 690rpx;
  pointer-events: none;
}
.login-backdrop-image {
  display: block;
  width: 100%;
  height: 100%;
}
.login-status-space, .login-nav, .login-brand, .login-panel {
  position: relative;
  z-index: 1;
}
.login-nav {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-nav-title {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
  padding: 0 170rpx;
  white-space: nowrap;
}
button.login-back {
  position: absolute;
  left: 22rpx;
  top: 0;
  width: 88rpx;
  height: 44px;
  min-height: 44px;
  line-height: 40px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 9999rpx;
  background: rgba(255,255,255,.8);
  color: var(--accent, #0066CC);
  font-size: 50rpx;
  font-weight: 400;
}
.login-brand {
  margin: 26rpx 42rpx 0;
  min-height: 66rpx;
  display: flex;
  align-items: center;
}
.login-badge {
  width: 66rpx;
  height: 66rpx;
  flex: none;
  padding: 5rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: rgba(255,255,255,.94);
  box-shadow: 0 5rpx 18rpx rgba(0,0,0,.05);
}
.login-brand-copy {
  margin-left: 18rpx;
}
.login-station {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
.login-brand-en {
  display: block;
  margin-top: 4rpx;
  color: #5E685C;
  font-size: 15rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
}
.login-partner-tag {
  margin-left: auto;
  padding: 7rpx 18rpx;
  border-radius: 9999rpx;
  background: rgba(255,255,255,.9);
  color: #5E685C;
  font-size: 21rpx;
  line-height: 1.5;
}
.login-panel {
  margin: 270rpx 32rpx 0;
  padding: 42rpx 36rpx 20rpx;
  background: rgba(255,255,255,.97);
  border: 1rpx solid rgba(255,255,255,.9);
  border-radius: 48rpx;
  box-shadow: 0 20rpx 60rpx -20rpx rgba(0,0,0,.16);
  box-sizing: border-box;
}
.login-kicker {
  display: flex;
  align-items: center;
  color: #727970;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}
.login-kicker-dot {
  flex: none;
  width: 9rpx;
  height: 9rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--accent, #0066CC);
}
.login-title {
  display: block;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.4;
}
.login-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted, #7A7A7A);
}
.login-form { margin-top: 40rpx; }
.login-field + .login-field { margin-top: 28rpx; }
.login-label {
  display: block;
  margin-bottom: 14rpx;
  color: #4D544D;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.5;
}
.login-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #E1E6E0;
  border-radius: 24rpx;
  background: #F7F8F5;
  color: var(--ink, #1D1D1F);
  font-size: 29rpx;
}
.login-placeholder { color: #9A9F99; font-size: 25rpx; }
.login-password-row { position: relative; }
.login-password-input { padding-right: 114rpx; }
button.login-password-toggle {
  position: absolute;
  right: 5rpx;
  top: 4rpx;
  width: 96rpx;
  height: 88rpx;
  min-height: 44px;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: var(--accent, #0066CC);
  font-size: 23rpx;
  font-weight: 400;
}
.login-help-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}
.login-help-row > text {
  flex: 1;
  min-width: 0;
  font-size: 19rpx;
  color: #92998F;
  line-height: 1.5;
}
button.login-help, button.login-student {
  flex: none;
  min-height: 44px;
  line-height: 44px;
  width: auto;
  margin: 0;
  padding: 0 4rpx 0 12rpx;
  border: 0;
  border-radius: 16rpx;
  background: transparent;
  color: var(--accent, #0066CC);
  font-size: 21rpx;
  font-weight: 400;
}
.login-error {
  display: block;
  margin: 8rpx 0 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  color: #B42318;
  background: #FDE8E8;
  font-size: 23rpx;
  line-height: 1.6;
  word-break: break-all;
}
button.login-submit {
  width: 100%;
  height: 100rpx;
  min-height: 44px;
  line-height: 100rpx;
  margin: 6rpx 0 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 26rpx;
  background: var(--accent, #0066CC);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
}
button.login-submit[disabled] {
  background: #98BDE2;
  color: #FFFFFF;
}
.login-submit-pressed { opacity: .82; }
.login-control-pressed { background: #EAF3FD !important; }
button.login-back::after, button.login-password-toggle::after,
button.login-help::after, button.login-student::after,
button.login-submit::after { border: 0; }
.login-account-note {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8B9388;
}
.login-panel-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 26rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #EDF0EA;
}
.login-panel-footer > text {
  font-size: 18rpx;
  color: #92998F;
  line-height: 1.6;
}
