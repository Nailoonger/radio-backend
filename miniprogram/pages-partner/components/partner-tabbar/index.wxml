<!-- 伙伴端底部导航 · 浮动白胶囊 dock（样式逐条量自 v151 .tabbar） -->
<view class="tb">
  <view wx:for="{{tabs}}"
        wx:key="id"
        class="ti {{item.on ? 'on' : ''}}"
        hover-class="ti-hover"
        data-id="{{item.id}}"
        bindtap="onTap">
    <view class="pill">
      <view class="iw">
        <image class="ic" src="/assets/partner/tab-{{item.icon}}{{item.on ? '-on' : ''}}.png" mode="aspectFit"/>
        <!-- 角标用 view 不用 text：text 是行内元件，flex 居中在部分基础库上不生效 -->
        <view wx:if="{{item.badge}}" class="bg {{item.badgeCls}}">{{item.badge}}</view>
      </view>
      <text class="lb">{{item.name}}</text>
    </view>
  </view>
</view>
