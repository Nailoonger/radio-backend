/* pages-partner/components/rules-sheet/index.wxss · v1（2026-11-02）
   只读弹层。颜色抄 app.wxss 的 token（带兜底值，组件里也照常生效）：
     #1D1D1F ink · #76767E muted · #F0F0F0 divider · #0066CC accent（只给「关闭」用）
   ⚠️ 不深色；圆角上 38rpx（与 planning 的 .sheet 同口径），下沿贴安全区。 */

.ro-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, .3);
  display: flex;
  align-items: flex-end;
}

.ro-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 38rpx 38rpx 0 0;
  padding-bottom: 28rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ro-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx 24rpx;
}
.ro-t { font-size: 36rpx; font-weight: 600; color: #1D1D1F; letter-spacing: -0.4rpx; }
.ro-x { font-size: 25rpx; color: #0066CC; }

.ro-list { padding: 0 36rpx; }
.ro-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 0;
}
.ro-row + .ro-row { border-top: 2rpx solid #F0F0F0; }
.ro-tx { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ro-nm { font-size: 28rpx; font-weight: 500; color: #1D1D1F; line-height: 1.4; }
.ro-st { margin-top: 6rpx; font-size: 22rpx; color: #76767E; line-height: 1.5; }
/* ⚠️ 数值不用强调色：它不可点，强调色是留给「能点的东西」的 */
.ro-v {
  flex: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-variant-numeric: tabular-nums;
}
.ro-v.off { color: #76767E; font-weight: 500; }

.ro-empty {
  padding: 36rpx 36rpx 34rpx;
  font-size: 23rpx;
  color: #76767E;
  text-align: center;
}
