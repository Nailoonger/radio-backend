<!-- pages-partner/leave/leave.wxml · v2（2026-11-01 只留「我的请假」）
     三个角色同一套：从我本周的班次里挑一场 + 写事由 → 提交；下面是我这周的请假。
     审批已拆出去：pages-partner/leave-review/（工作台「站内协作 · 请假审批」进）。
     接口：GET /partner/schedule/mine · GET /partner/leave/mine · POST /partner/leave · DELETE /partner/leave/:id -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">请假</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <!-- 周切换（2026-10-30 统一）：左右文字链 + 中间「本周 / 非本周」胶囊 + 月日，
         与值班时间代录、考勤、排班工作台四页同一套写法。 -->
    <view class="wk-nav">
      <text class="wk-b" bindtap="prevWeek">‹ 上一周</text>
      <view class="wk-mid">
        <text class="wk-tag {{isThisWeek ? 'on' : 'off'}}">{{isThisWeek ? '本周' : '非本周'}}</text>
        <text class="wk-c">{{weekText || '加载中'}}</text>
      </view>
      <text class="wk-b r {{isThisWeek ? 'off' : ''}}" bindtap="nextWeek">下一周 ›</text>
    </view>

    <view class="card">
      <view class="sec-h"><text class="sec-t">我要请假</text></view>
      <view class="hint-note" wx:if="{{shifts.length === 0}}">这一周没有你的班次，没什么可请</view>
      <view class="chips" wx:else>
        <view class="chip {{pickKey === item.key ? 'on' : ''}}"
              wx:for="{{shifts}}" wx:key="key"
              data-key="{{item.key}}" bindtap="pickShift">{{item.label}}</view>
      </view>
      <textarea class="ta" wx:if="{{shifts.length}}" value="{{reason}}" bindinput="onReason"
                placeholder="写一下事由（社干批的时候要看的）" placeholder-class="ph"
                maxlength="200" auto-height show-confirm-bar="{{false}}" />
      <button class="btn primary" wx:if="{{shifts.length}}" hover-class="pressed"
              bindtap="onSubmit" disabled="{{submitting}}">提交申请</button>
      <!-- 2026-11-01 陛下让删掉后半句「批完之后班表上那一格会空出来。」，只留已请次数 -->
      <view class="note">本月已请 {{monthUsed}} 次。</view>
    </view>

    <view class="sec-h2"><text class="sec-t">我这周的请假</text></view>
    <view class="hint-note" wx:if="{{mine.length === 0}}">这一周没请过假</view>
    <view class="rows" wx:else>
      <view class="row" wx:for="{{mine}}" wx:key="id">
        <view class="r-main">
          <text class="r-note">{{item.dayText}} {{item.slot}}</text>
          <text class="r-reason">{{item.reason}}</text>
          <text class="r-reject" wx:if="{{item.rejectReason}}">驳回理由：{{item.rejectReason}}</text>
        </view>
        <view class="r-right">
          <text class="tag {{item.tagCls}}">{{item.statusText}}</text>
          <text class="r-cancel" wx:if="{{item.status === 0}}" catchtap="onCancel" data-id="{{item.id}}">撤回</text>
        </view>
      </view>
    </view>
  </view>
</view>
