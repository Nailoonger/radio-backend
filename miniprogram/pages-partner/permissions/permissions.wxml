<!-- pages-partner/permissions/permissions.wxml · v1（2026-10-31 权限管理 · 超管）
     两层：全局总开关（.rows / switch）+ 按人分发（.prow / 两个胶囊）。
     浅色卡 + accent 强调，不用任何深色块。
     ⚠️ 文案全部来自接口的 meta（name / desc / deny），页面不硬编码权限名 —— 改词只改 _kit.js。 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">权限管理</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <view class="hint-note" wx:if="{{loading}}">正在加载……</view>
    <view class="hint-note" wx:elif="{{loadError}}">{{loadError}}</view>

    <block wx:else>
      <!-- 权限表还没建：不白屏、也不装没事。拨一下开关就会自动建好（见 permissions.js#upsert） -->
      <view class="intro" wx:if="{{buildNeeded}}">
        <text class="intro-t">权限表还没初始化</text>
        <text class="intro-d">不影响用：拨一下下面任意一个开关，会自动把这张表建好并保存。</text>
      </view>

      <view class="intro">
        <text class="intro-t">三个开关：进不进得了排班工作台、审核模块，以及能不能替别人代录。</text>
        <text class="intro-d">关掉之后，班表、考勤、请假照常能看；自己的可排时间也照常能填 —— 只是这几处进不去、替不了别人。</text>
      </view>

      <!-- ① 全局总开关：一刀切，所有人先吃它 -->
      <view class="sh"><text class="t">总开关</text><text class="n">对全体社干</text></view>
      <view class="rows">
        <view class="row" wx:for="{{meta}}" wx:key="key">
          <view class="r-main">
            <text class="r-name">{{item.name}}</text>
            <text class="r-sub">{{item.desc}}</text>
          </view>
          <switch class="sw" checked="{{global[item.key]}}" color="#0066CC"
                  data-key="{{item.key}}" bindchange="onGlobal" />
        </view>
      </view>
      <view class="note">
        {{global.schedule ? '社干可以进排班工作台' : '社干进不去排班工作台'}} ·
        {{global.review ? '可以进审核' : '进不去审核'}}
      </view>

      <!-- ② 按人分发：拨一下就是单独设，跟回全局要点右边那行小字 -->
      <view class="sh">
        <text class="t">分发给社干</text>
        <text class="n">{{count.managers}} 人</text>
      </view>

      <view class="rows" wx:if="{{people.length}}">
        <view class="prow" wx:for="{{people}}" wx:key="personId" wx:for-item="p">
          <view class="p-head">
            <text class="p-name">{{p.name}}</text>
            <text class="p-sub">{{p.username}}{{p.department ? ' · ' + p.department : ''}}</text>
            <text class="p-tag" wx:if="{{p.overridden}}">单独设置</text>
          </view>

          <!-- 三个胶囊一行：排班 / 审核 / 代录。胶囊文案与顺序都来自 meta（_kit 的 PERM_TEXT），
               不在页面里再列一遍 —— 加第四个开关时只改后端，这页自动跟上。 -->
          <view class="p-pills">
            <view class="pill {{p.eff[m.key] ? 'on' : ''}}" wx:for="{{meta}}" wx:key="key" wx:for-item="m"
                  hover-class="pressed"
                  data-id="{{p.personId}}" data-key="{{m.key}}" bindtap="onPerson">
              <text class="pill-n">{{m.short}}</text>
              <text class="pill-v">{{p.eff[m.key] ? '可用' : '不可用'}}</text>
            </view>
          </view>

          <!-- 只在这一位被单独设过时才给「跟回全局」，不到处都是链接 -->
          <view class="p-follow" wx:if="{{p.overridden}}">
            <block wx:for="{{meta}}" wx:key="key" wx:for-item="m">
              <text class="fl" wx:if="{{p.over[m.key] !== null}}" hover-class="pressed"
                    data-id="{{p.personId}}" data-key="{{m.key}}" bindtap="onFollow">{{m.short}}跟回全局</text>
            </block>
          </view>
        </view>
      </view>

      <view class="hint-note" wx:else>还没有社干账号。去「账号」里从学生名册把人拉进来。</view>

      <view class="note">
        总开关是默认值；单独拨过的社干以他自己那一格为准。
        被关掉的人会分别看到「{{denySchedule}}」「{{denyReview}}」「{{denyProxy}}」。
      </view>
    </block>
  </view>
</view>
