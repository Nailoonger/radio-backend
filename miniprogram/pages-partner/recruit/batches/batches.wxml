<!-- pages-partner/recruit/batches/batches.wxml · v2（2026-11-14 照 v174 V['recruit-batches']）
     ① 三段下划线标签（不是白药丸）② 点行进配置 ③ 行尾红字「删除」，归档行不给
     ④ 新建只在非归档段 ⑤ 每行三行字：名称+tag ／ 起止 ／ 一句补充 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">批次管理</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <!-- 三段下划线标签（v169 口径：选中蓝字 + 底下一根蓝短线） -->
    <view class="rc-layer">
      <view class="rc-stabs">
        <view class="rc-stab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key"
              data-tab="{{item.key}}" bindtap="onTab">{{item.label}}</view>
      </view>
    </view>

    <view class="rc-hint" wx:if="{{loading}}">正在加载……</view>

    <block wx:else>
      <view class="rc-layer">
        <view class="rc-rows" wx:if="{{rows.length}}">
          <view class="rc-row rc-row-top" wx:for="{{rows}}" wx:key="key" hover-class="pressed"
                data-i="{{index}}" bindtap="onOpen">
            <view class="grow">
              <view class="rc-t1">
                <b>{{item.title}}</b>
                <text class="rc-tag {{item.stateCls}}">{{item.stateText}}</text>
              </view>
              <text class="rc-t2">{{item.range}}</text>
              <text class="rc-t3 {{item.lineWarn ? 'warn' : ''}}">{{item.line}}</text>
            </view>
            <!-- 归档行不给删除（服务端也删不了） -->
            <view class="rc-del" wx:if="{{canManage && !item.archived}}" hover-class="pressed"
                  data-i="{{index}}" catchtap="onDel">删除</view>
            <view class="chev-r"></view>
          </view>
        </view>

        <view class="rc-blk" wx:else>
          <view class="rc-empty">
            <b>这个分段里还没有批次</b>
            <span>{{tab === 'live' ? '「新建招新批次」开一份草稿' : (tab === 'closed' ? '收满截止后才会出现在这里' : '归档前要先发布录取结果')}}</span>
          </view>
        </view>
      </view>

      <!-- 新建：归档段不摆（不然会被读成「新建一个归档批次」） -->
      <view class="rc-layer" wx:if="{{canManage && tab !== 'arch'}}">
        <button class="rc-btn rc-btn-primary" hover-class="pressed" bindtap="onNew">新建招新批次</button>
      </view>

      <view class="rc-layer">
        <view class="rc-note">{{tab === 'arch'
          ? '归档批次只读：名字、题目、报名记录都不能再改，只能看。'
          : (canManage
              ? '点批次进它的「批次配置」改名称 / 时间 / 固定信息 / 题目；行尾红色「删除」＝删这一个批次，要原样输入批次名称。'
              : '点批次进它的详情看报名与面试；新建、配置、发布、截止、归档、删除都只有超管能做。')}}</view>
      </view>
      <view class="rc-pad"></view>
    </block>
  </view>

  <!-- 新建：名称 + 开始日 + 截止日（其余在配置页里改） -->
  <view class="rc-mask" wx:if="{{sheet}}" bindtap="onSheetClose"></view>
  <view class="rc-sheet" wx:if="{{sheet}}">
    <view class="rc-sheet-hd">
      <text class="c" bindtap="onSheetClose">取消</text>
      <b>新建招新批次</b>
      <text class="k"></text>
    </view>
    <view class="rc-sheet-tip">建好是「草稿」：还没人能看到，配置页里补完固定信息与题目再发布。</view>
    <view class="rc-sheet-bd">
      <text class="rc-lb">批次名称</text>
      <input class="rc-inp" value="{{form.title}}" placeholder="例如：2026 年秋季招新"
             maxlength="100" bindinput="onTitle" />
      <view class="rc-frow">
        <view class="rc-fhalf">
          <text class="rc-lb">开始日（零点开）</text>
          <picker mode="date" value="{{form.start}}" bindchange="onStart">
            <view class="rc-inp">{{form.start || '选择日期'}}</view>
          </picker>
        </view>
        <view class="rc-fhalf">
          <text class="rc-lb">截止日（24 点关）</text>
          <picker mode="date" value="{{form.end}}" bindchange="onEnd">
            <view class="rc-inp">{{form.end || '选择日期'}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="rc-sheet-ft">
      <button class="plain" hover-class="pressed" bindtap="onSheetClose">取消</button>
      <button class="go" hover-class="pressed" bindtap="onCreate" disabled="{{creating}}">建草稿</button>
    </view>
  </view>

  <!-- 删除确认：有报名或已发布的批次要原样输入名称 -->
  <view class="rc-mask" wx:if="{{del}}" bindtap="onDelClose"></view>
  <view class="rc-sheet" wx:if="{{del}}">
    <view class="rc-sheet-hd">
      <text class="c" bindtap="onDelClose">取消</text>
      <b>删除批次</b>
      <text class="k"></text>
    </view>
    <view class="rc-sheet-tip">连同报名、查询码一起删，不可恢复。{{del.need ? '要原样输入批次名称。' : ''}}</view>
    <view class="rc-sheet-bd">
      <block wx:if="{{del.need}}">
        <text class="rc-lb">批次名称</text>
        <input class="rc-inp" value="{{delInput}}" placeholder="输入完整的批次名称" bindinput="onDelInput" />
        <view class="rc-sheet-note">要删的是「{{del.title}}」—— 一个字都不能差。</view>
      </block>
      <view class="rc-sheet-note" wx:else>这个批次还没发布过，点下面就能删。</view>
    </view>
    <view class="rc-sheet-ft">
      <button class="plain" hover-class="pressed" bindtap="onDelClose">取消</button>
      <button class="go" hover-class="pressed" bindtap="onDelOk" disabled="{{deleting}}">删除</button>
    </view>
  </view>
</view>
