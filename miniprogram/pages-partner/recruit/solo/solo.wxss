/* pages-partner/recruit/solo/solo.wxss · v1（2026-11-14）
   度量全在 styles/recruit.wxss（招新八屏共用），这里只放页面壳。 */
@import "../../../styles/recruit.wxss";

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--parchment);
}
.body {
  flex: 1;
  padding: 19rpx 35rpx 46rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}
.chev {
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--ink-2);
  border-bottom: 4rpx solid var(--ink-2);
  transform: rotate(45deg);
  flex: none;
}

/* 日期/时刻两列放宽：不要那么紧凑（页面级覆盖共享的 15rpx） */
.rc-frow { gap: 24rpx; }

/* 日期/时刻并排：rc-dd 自带的 margin-top 会把时刻胶囊推低一截（一高一低），这里归零 */
.rc-dd { margin-top: 0; }
