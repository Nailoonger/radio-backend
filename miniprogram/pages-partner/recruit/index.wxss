/* pages-partner/recruit/index.wxss · v2（2026-11-14）
   全部度量在 miniprogram/styles/recruit.wxss 里（招新八屏共用），这一页只放页面壳。
   壳：羊皮纸底 + 左右 35rpx（原型 .view padding 10 18 ⇒ 18px ≈ 35rpx），层间 23rpx。 */
@import "../../styles/recruit.wxss";

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--parchment);
}
.body {
  flex: 1;
  padding: 19rpx 35rpx 46rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}
.chev {
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--ink-2);
  border-bottom: 4rpx solid var(--ink-2);
  transform: rotate(45deg);
  flex: none;
}
