<!-- pages-partner/recruit/list/list.wxml · v2（2026-11-14 照 v174 V['recruit-list']）
     搜姓名 → 年级胶囊 → 三段下划线标签（带人数）→「录取状态」下面两个小胶囊 → 行。
     ⚠️ 搜索只筛已拉下来的行（服务端不收关键字），页脚明说，不装假。 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">报名列表</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <!-- ① 搜姓名 -->
    <view class="rc-layer">
      <view class="rc-srch {{kw ? 'has' : ''}}">
        <view class="mg"></view>
        <input value="{{kw}}" placeholder="搜姓名" confirm-type="search" bindinput="onKw" />
        <view class="clr" bindtap="onKwClear">✕</view>
      </view>
    </view>

    <!-- ② 年级：小方角胶囊 -->
    <view class="rc-layer" wx:if="{{gradeTags.length > 1}}">
      <view class="rc-ftags">
        <view class="rc-ftag {{grade === item.v ? 'on' : ''}}" wx:for="{{gradeTags}}" wx:key="v"
              data-v="{{item.v}}" bindtap="onGrade">{{item.label}}</view>
      </view>
    </view>

    <!-- ③ 三段下划线标签（带人数） -->
    <view class="rc-layer">
      <view class="rc-stabs">
        <view class="rc-stab {{tab === item.key ? 'on' : ''}}" wx:for="{{stabs}}" wx:key="key"
              data-tab="{{item.key}}" bindtap="onStab">
          <text>{{item.label}}</text>
          <text class="n">{{item.n}}</text>
        </view>
      </view>
      <!-- ④ 「录取状态」下面的两个小胶囊 -->
      <view class="rc-ftags" wx:if="{{tab === 'acc'}}">
        <view class="rc-ftag {{accTab === item.key ? 'on' : ''}}" wx:for="{{accStabs}}" wx:key="key"
              data-acc="{{item.key}}" bindtap="onAccTab">{{item.label}}<text class="n">{{item.n}}</text></view>
      </view>
    </view>

    <view class="rc-hint" wx:if="{{loading}}">正在加载……</view>
    <view class="rc-hint err" wx:elif="{{err}}">{{err}}</view>

    <block wx:else>
      <view class="rc-layer">
        <view class="rc-rows" wx:if="{{rows.length}}">
          <view class="rc-row rc-row-top" wx:for="{{rows}}" wx:key="id" hover-class="pressed"
                data-id="{{item.id}}" bindtap="onOpen">
            <view class="grow">
              <view class="rc-t1">
                <b>{{item.name}}</b>
                <text class="rc-tag {{item.statusCls}}">{{item.statusText}}</text>
              </view>
              <text class="rc-t2">{{item.grade}}{{item.className ? ' · ' + item.className : ''}}{{item.qq ? ' · QQ ' + item.qq : ''}}</text>
              <text class="rc-t3" wx:if="{{item.at}}">面试 {{item.at}}</text>
              <text class="rc-t3" wx:elif="{{item.created}}">{{item.created}} 提交</text>
            </view>
            <view class="chev-r"></view>
          </view>
        </view>

        <view class="rc-blk" wx:else>
          <view class="rc-empty">
            <b>没有符合条件的报名</b>
            <span>{{kw ? '换个姓名或年级试试' : (tab === 'submitted' ? '截止前只收不审，待审的都在这里' : (tab === 'interview' ? '还没人排进面试' : '还没有定下来的报名'))}}</span>
          </view>
        </view>
      </view>

      <view class="rc-pad"></view>
    </block>
  </view>
</view>
