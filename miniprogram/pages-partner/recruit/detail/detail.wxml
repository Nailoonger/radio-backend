<!-- pages-partner/recruit/detail.wxml · v1（2026-11-14 报名处理台）
     「录取决定」＝三个分开的胶囊（v172 口径），选中的浅蓝底蓝字，再点一次撤销。 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">报名审核</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <view class="hint-note" wx:if="{{loading}}">正在加载……</view>

    <block wx:elif="{{a}}">
      <!-- 这个人 -->
      <view class="card">
        <view class="card-hd">
          <text class="nm">{{a.name}}</text>
          <text class="tag {{a.status === 'accepted' ? 'tag-pass' : (a.status === 'rejected' ? 'tag-reject' : 'tag-pending')}}">{{a.statusText}}</text>
        </view>
        <view class="kv"><text class="k">年级班级</text><text class="v">{{a.grade}}{{a.className ? ' · ' + a.className : ''}}</text></view>
        <view class="kv"><text class="k">QQ 号</text><text class="v">{{a.qq || '—'}}</text></view>
        <view class="kv" wx:if="{{a.seq}}"><text class="k">面试序号</text><text class="v">第 {{a.seq}} 号</text></view>
        <view class="kv"><text class="k">报名于</text><text class="v">{{a.created}}</text></view>
        <view class="kv" wx:if="{{a.legacy}}"><text class="k">历史学号</text><text class="v">{{a.legacy}}</text></view>
      </view>

      <!-- 答案 -->
      <view class="card" wx:if="{{answers.length}}">
        <view class="card-hd"><text class="hd-t">报名表答案</text></view>
        <view class="qa" wx:for="{{answers}}" wx:key="key">
          <text class="q-no">{{item.no}}</text>
          <view class="q-main">
            <text class="q-t">{{item.title}}</text>
            <text class="q-v">{{item.val}}</text>
          </view>
        </view>
      </view>

      <!-- 面试安排 -->
      <view class="card">
        <view class="card-hd">
          <text class="hd-t">面试安排</text>
          <text class="hd-s" wx:if="{{interview && !interview.custom}}">跟随批次统一安排</text>
          <text class="hd-s" wx:elif="{{interview}}">单独配置</text>
        </view>
        <view class="kv" wx:if="{{interview}}">
          <text class="k">当前</text>
          <text class="v">{{interview.at ? interview.at : '未填时间'}}{{interview.location ? ' · ' + interview.location : ''}}</text>
        </view>
        <block wx:if="{{canReview}}">
          <view class="f-row">
            <view class="f-half">
              <text class="f-label">日期</text>
              <picker mode="date" value="{{atDate}}" bindchange="onDate">
                <view class="f-input">{{atDate || '选择'}}</view>
              </picker>
            </view>
            <view class="f-half">
              <text class="f-label">时刻</text>
              <picker mode="time" value="{{atTime}}" bindchange="onTime">
                <view class="f-input">{{atTime || '选择'}}</view>
              </picker>
            </view>
          </view>
          <text class="f-label mt">地点</text>
          <input class="f-input" value="{{atPlace}}" placeholder="例如：广播站（教学楼 3 层）" bindinput="onPlace" />
          <text class="f-label mt">说明（可空）</text>
          <input class="f-input" value="{{atNote}}" placeholder="例如：带一段自我介绍" bindinput="onItvNote" />
          <view class="row-btns">
            <button class="btn btn-primary flex1" hover-class="pressed" bindtap="onSaveItv" disabled="{{savingItv}}">保存面试安排</button>
            <button class="btn btn-ghost flex1" wx:if="{{interview && interview.custom}}" hover-class="pressed" bindtap="onClearItv">改回统一安排</button>
          </view>
        </block>
      </view>

      <!-- 录取决定：三个分开的胶囊 -->
      <view class="card" wx:if="{{canReview}}">
        <view class="card-hd"><text class="hd-t">录取决定</text><text class="hd-s">发布结果前都能改</text></view>
        <view class="pills">
          <button class="pill {{decided === 'accepted' ? 'on' : ''}}" data-d="accepted" hover-class="pressed" bindtap="onDecide">拟录取</button>
          <button class="pill {{decided === 'rejected' ? 'on' : ''}}" data-d="rejected" hover-class="pressed" bindtap="onDecide">拟不录取</button>
          <button class="pill {{decided === '' ? 'on' : ''}}" data-d="" hover-class="pressed" bindtap="onDecide">先不定</button>
        </view>
        <text class="f-tip">拟录取之前要先安排面试时间；「先不定」＝清掉决定，回到待面试。</text>
      </view>

      <!-- 备注 -->
      <view class="card" wx:if="{{canReview}}">
        <view class="card-hd"><text class="hd-t">备注</text></view>
        <text class="f-label">内部备注（只有站里看得到）</text>
        <textarea class="f-area" value="{{internalNote}}" placeholder="例如：声音条件好，想安排晚时段" bindinput="onIn" />
        <text class="f-label mt">对外说明（学生查结果时能看到）</text>
        <textarea class="f-area" value="{{publicNote}}" placeholder="例如：请于周一午间到广播站试音" bindinput="onPub" />
        <button class="btn btn-primary mt-btn" hover-class="pressed" bindtap="onSaveNotes" disabled="{{saving}}">保存备注</button>
      </view>

      <view class="note" wx:if="{{!canReview}}">你没有报名审核权限，这一页只能看。</view>
    </block>
  </view>
</view>
