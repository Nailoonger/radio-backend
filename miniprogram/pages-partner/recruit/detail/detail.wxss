@import "../../../styles/recruit.wxss";

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--parchment);
}
.body {
  flex: 1;
  padding: 19rpx 35rpx 46rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}
.chev {
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--ink-2);
  border-bottom: 4rpx solid var(--ink-2);
  transform: rotate(-135deg);
  flex: none;
}
