<!-- pages-partner/recruit/index.wxml · v2（2026-11-14 照 v174 V.recruit）
     一张批次卡（上段身份 + 下段四格计数，hairline 分隔）+ 三行入口 + 页底一句说明。
     ⚠️ 这一页不放任何操作：发布 / 截止 / 生成顺序 / 发布结果 / 删除全在「批次管理」里（v170 口径）。 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">招新</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <view class="rc-hint" wx:if="{{loading}}">正在加载……</view>
    <view class="rc-hint err" wx:elif="{{err}}">{{err}}</view>

    <block wx:else>
      <!-- ① 批次卡：上段＝身份，下段＝四格 -->
      <view class="rc-layer" wx:if="{{b}}">
        <view class="rc-hero">
          <text class="today">{{b.title}}</text>
          <text class="bigd">报名时间 {{b.range}}{{b.intro ? ' · ' + b.intro : ''}}</text>
          <view class="rc-hero-tags">
            <text class="rc-tag {{b.stateCls}}">{{b.stateText}}</text>
            <text class="rc-tag {{b.resultCls}}">{{b.resultText}}</text>
          </view>
          <view class="rc-pod-stats">
            <view class="rc-ps" wx:for="{{b.numbers}}" wx:key="l">
              <text class="rc-ps-l">{{item.l}}</text>
              <text class="rc-ps-n">{{item.n}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ② 入口：三行，右端一句补充值 -->
      <view class="rc-layer">
        <view class="rc-rows">
          <view class="rc-row" wx:for="{{rows}}" wx:key="key" hover-class="pressed"
                data-key="{{item.key}}" bindtap="onRow">
            <text class="grow rc-row-t">{{item.t}}</text>
            <text class="rv">{{item.d}}</text>
            <view class="chev-r"></view>
          </view>
        </view>
      </view>

      <!-- ③ 说明 -->
      <view class="rc-layer">
        <view class="rc-note">批次由超管建立与发布；社干可以看报名、审核、看面试名单。{{canManage ? '' : '新建、配置、发布、截止、归档、删除都只有超管能做。'}}</view>
      </view>
      <view class="rc-pad"></view>
    </block>
  </view>
</view>
