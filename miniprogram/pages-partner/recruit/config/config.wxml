<!-- pages-partner/recruit/config/config.wxml · v2（2026-11-14 照 v174 V['recruit-config']）
     ① 返回条「‹ 批次管理」+ 右端状态
     ② 批次信息：名称 / 介绍 / 报名时间＝一个字段装整段（点开原地展开日历）
     ③ 固定信息：四项必填拨杆 + 年级胶囊（单选）+ 班级字段下方下拉（单选，可加可删）
     ④ 自定义问题：点整行进「问题编辑」页
     ⑤ 保存 + 批次操作（按状态位出现）
     ⚠️ 模板只取值、不取属性：选项一律读 item.opts（js 里 buildFixed 摊好的）。 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">批次配置</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <view class="rc-hint" wx:if="{{loading}}">正在加载……</view>
    <view class="rc-hint err" wx:elif="{{err}}">{{err}}</view>

    <block wx:else>
      <!-- 返回条：回批次管理 + 当前状态 -->
      <view class="rc-layer">
        <view class="rc-rows">
          <view class="rc-row" hover-class="pressed" bindtap="goBatches">
            <text class="grow rc-back">‹ 批次管理</text>
            <text class="rv">{{archived ? '已归档' : stateText}}</text>
          </view>
        </view>
      </view>

      <!-- ② 批次信息 -->
      <view class="rc-layer">
        <view class="rc-blk">
          <view class="rc-blk-h">
            <text class="t">批次信息</text>
            <text class="more">{{lockedTitle ? '名称已锁定' : '草稿可改'}}</text>
          </view>

          <!-- 已发布：给一条出路，别让人对着灰框发愣 -->
          <view class="rc-warnbar" wx:if="{{published && canManage}}">
            <text class="w">本批次已发布：名称 / 题目 / 时间锁定。</text>
            <text class="go" bindtap="goNew">新建 ›</text>
          </view>

          <text class="rc-lb">批次名称</text>
          <input class="rc-inp" value="{{title}}" disabled="{{lockedTitle || !canManage}}"
                 placeholder="例如：2026 年秋季招新" maxlength="100" bindinput="onTitle" />

          <text class="rc-lb mt">招新介绍（报名页顶部展示）</text>
          <textarea class="rc-area" value="{{intro}}" disabled="{{!canManage}}"
                    maxlength="10000" placeholder="一两句话说清这次招什么、什么时候面试"
                    bindinput="onIntro" />

          <!-- 报名时间：一个字段装整段 -->
          <view class="rc-rng mt">
            <view class="rc-rng-f {{lockedTime ? 'off' : ''}}" bindtap="onRngOpen">
              <text class="lb">报名时间</text>
              <text class="vl">{{rangeText}}</text>
              <view class="cal"></view>
            </view>

            <!-- 字段下方原地展开的日历 -->
            <view class="rc-pop" wx:if="{{rng.open}}">
              <view class="rc-pop-hd">
                <view class="rnav" data-step="-1" bindtap="onRngNav">‹</view>
                <b>{{rngMonth}}</b>
                <view class="rnav" data-step="1" bindtap="onRngNav">›</view>
              </view>
              <view class="rc-rgrid">
                <view class="rc-rw" wx:for="{{rngWeeks}}" wx:key="*this" wx:for-item="w">{{w}}</view>
                <view class="rc-rd {{item.cls}}" wx:for="{{cells}}" wx:key="index"
                      data-d="{{item.d}}" bindtap="onRngDay">{{item.d}}</view>
              </view>
              <view class="rc-rhint">{{rngHint}}</view>
              <view class="rc-rfoot">
                <button class="cbtn cancel" hover-class="pressed" bindtap="onRngClear">清空</button>
                <view class="grow"></view>
                <button class="cbtn cancel" hover-class="pressed" bindtap="onRngClose">取消</button>
                <button class="cbtn ok" hover-class="pressed" bindtap="onRngOk"
                        disabled="{{rng.a && rng.b ? false : true}}">确定</button>
              </view>
            </view>
          </view>

          <view class="rc-tip" wx:if="{{lockedTime}}">报名已开始或批次已截止，起止时间锁定。</view>
        </view>
      </view>

      <!-- ③ 固定信息 -->
      <view class="rc-layer">
        <view class="rc-blk">
          <view class="rc-blk-h"><text class="t">固定信息</text><text class="more">必填 + 选项</text></view>

          <view class="rc-fixrow" wx:for="{{fixedList}}" wx:key="key">
            <view class="rc-fixhd">
              <text class="grow rc-fixt">{{item.label}}</text>
              <text class="req">必填</text>
              <view class="rc-sw {{item.required ? 'on' : ''}} {{published ? 'off' : ''}}"
                    data-key="{{item.key}}" bindtap="onReqToggle"></view>
            </view>

            <!-- 年级：一排胶囊，单选，再点一下取消 -->
            <block wx:if="{{item.key === 'grade'}}">
              <view class="rc-ftags mt" wx:if="{{canManage && !published}}">
                <view class="rc-ftag {{item.pick === g ? 'on' : ''}}" wx:for="{{item.opts}}" wx:for-item="g"
                      wx:key="*this" data-v="{{g}}" bindtap="onGradePick">{{g}}</view>
                <view class="rc-ftag" bindtap="onGradeAdd">＋ 添加</view>
              </view>
              <view class="rc-tip" wx:if="{{!canManage || published}}">{{item.pick ? '可报年级：' + item.pick : '没配选项＝学生自己填。'}}</view>
            </block>

            <!-- 班级：字段下方下拉 -->
            <block wx:if="{{item.key === 'className'}}">
              <view class="rc-dd" wx:if="{{canManage && !published}}">
                <view class="rc-pick {{item.pick ? 'picked' : ''}} {{clsOpen ? 'open' : ''}}" bindtap="onClsOpen">
                  <text>可报班级</text>
                  <text class="v">{{item.pick || '点开选择'}}</text>
                  <view class="arw"></view>
                </view>
                <view class="rc-panel" wx:if="{{clsOpen}}">
                  <scroll-view class="rc-list" scroll-y>
                    <view class="rc-opt {{item.pick === v ? 'on' : ''}}" wx:for="{{item.opts}}" wx:for-item="v" wx:key="*this">
                      <view class="hit" data-v="{{v}}" bindtap="onClsPick">
                        <text class="t">{{v}}</text><text class="ck">✓</text>
                      </view>
                      <view class="x" data-v="{{v}}" catchtap="onClsDel">✕</view>
                    </view>
                  </scroll-view>
                  <view class="rc-opt rc-opt-add" bindtap="onClsAdd">＋ 添加班级</view>
                </view>
              </view>
              <view class="rc-tip" wx:if="{{!canManage || published}}">{{item.pick ? '可报班级：' + item.pick : '没配选项＝学生自己填。'}}</view>
            </block>
          </view>
        </view>
      </view>

      <!-- ④ 自定义问题 -->
      <view class="rc-layer">
        <view class="rc-blk">
          <view class="rc-blk-h">
            <text class="t">自定义问题</text>
            <text class="more">{{questions.length}} / 20</text>
          </view>

          <view class="rc-q" wx:for="{{questions}}" wx:key="id" hover-class="pressed"
                data-i="{{index}}" bindtap="onQEdit">
            <text class="no">{{item.no}}</text>
            <view class="grow">
              <text class="rc-q-t">{{item.title}}</text>
              <text class="rc-q-s">{{item.typeText}}{{item.required ? ' · 必填' : ' · 选填'}}{{item.optCount ? ' · ' + item.optCount + ' 个选项' : ''}}</text>
            </view>
            <text class="rc-link" wx:if="{{canManage}}">编辑</text>
            <text class="rc-del" wx:if="{{canManage}}" data-i="{{index}}" catchtap="onQDel">删除</text>
          </view>

          <view class="rc-tip" wx:if="{{!questions.length}}">还没有自定义问题</view>

          <button class="rc-btn rc-btn-ghost mt" wx:if="{{canManage}}" hover-class="pressed"
                  bindtap="onQNew">添加问题</button>
        </view>
      </view>

      <!-- ⑤ 保存 -->
      <view class="rc-layer" wx:if="{{canManage}}">
        <button class="rc-btn rc-btn-primary" hover-class="pressed" bindtap="onSave"
                disabled="{{saving || archived}}">{{lockedTitle ? '保存允许修改的配置' : '保存草稿'}}</button>
      </view>

      <!-- ⑥ 批次操作：按状态位出现（v174 的 rcOps 同条件） -->
      <view class="rc-layer" wx:if="{{canManage && !archived}}">
        <view class="rc-mh"><text class="t">批次操作</text><text class="n">超管</text></view>
        <view class="rc-rows">
          <view class="rc-row" wx:if="{{!published}}" hover-class="pressed" bindtap="onPublish">
            <view class="grow">
              <text class="rc-opt-t">发布报名</text>
              <text class="rc-opt-d">发布后开始按报名时间收报名，题目和名称随之锁定</text>
            </view>
            <text class="rc-tag ok">可执行</text>
          </view>
          <view class="rc-row" wx:if="{{published && state === 'open'}}" hover-class="pressed" bindtap="onClose">
            <view class="grow">
              <text class="rc-opt-t">截止报名</text>
              <text class="rc-opt-d">提前结束收报名（到期会自动截止）</text>
            </view>
            <text class="rc-tag ok">可执行</text>
          </view>
          <view class="rc-row" wx:if="{{published && state === 'closed' && !resultPublished}}" hover-class="pressed" bindtap="onGenerate">
            <view class="grow">
              <text class="rc-opt-t">{{orderGenerated ? '重新生成面试顺序' : '生成随机面试顺序'}}</text>
              <text class="rc-opt-d">{{orderGenerated ? '已有顺序，重新生成会覆盖（要再确认一次）' : '截止后按有效报名随机洗牌，序号固定不变'}}</text>
            </view>
            <text class="rc-tag ok">可执行</text>
          </view>
          <view class="rc-row" wx:if="{{published && state === 'closed' && !resultPublished}}" hover-class="pressed" bindtap="onResults">
            <view class="grow">
              <text class="rc-opt-t">统一发布录取结果</text>
              <text class="rc-opt-d">发布后报名者凭查询码可见结果；还有没决定的人会拦住</text>
            </view>
            <text class="rc-tag ok">可执行</text>
          </view>
          <view class="rc-row" wx:if="{{resultPublished && !archived}}" hover-class="pressed" bindtap="onArchive">
            <view class="grow">
              <text class="rc-opt-t">归档批次</text>
              <text class="rc-opt-d">归档后整批只读，移到「已归档」</text>
            </view>
            <text class="rc-tag ok">可执行</text>
          </view>
        </view>
      </view>

      <view class="rc-pad"></view>
    </block>
  </view>
</view>
