<!-- pages-partner/club-keys/create.wxml -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev-l"></view>
    </view>
    <view class="navbar-title">{{done ? (record.name || '社团密钥') : '新建社团'}}</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="cbody">

    <view class="denied" wx:if="{{denied}}">
      <view class="denied-t">{{denyText}}</view>
    </view>

    <!-- ═══════════ ① 表单态 ═══════════
         ⚠️ 三个形态用三条独立的 wx:if 判，不写 wx:elif/wx:else —— 中间夹着注释时
            兄弟链要靠编译器把注释吃掉，多一层依赖就多一种"线上莫名其妙显示两块"。 -->
    <block wx:if="{{!denied && !done}}">

      <view class="grp-t">社团 · 只有名称必填，另两项可后补</view>

      <view class="form">
        <view class="frow">
          <text class="fk">名称</text>
          <!-- ⚠️ maxlength 只是存储上限（40），不是业务字数 —— 见 create.js 头注 -->
          <input class="fv-input" model:value="{{name}}" maxlength="40"
            placeholder="社团全称，2~12 字" placeholder-class="ph" bindinput="onName" />
        </view>
        <view class="frow">
          <text class="fk">负责人</text>
          <input class="fv-input" model:value="{{ownerName}}" maxlength="60"
            placeholder="社长姓名" placeholder-class="ph" bindinput="onOwner" />
        </view>
        <view class="frow">
          <text class="fk">指导老师</text>
          <input class="fv-input" model:value="{{teacherName}}" maxlength="60"
            placeholder="老师姓名" placeholder-class="ph" bindinput="onTeacher" />
        </view>
      </view>

      <view class="fnote {{nameBad ? 'bad' : ''}}">
        <block wx:if="{{nameBad}}">名称要 2~12 个字，请改一下。</block>
        <block wx:else>名称是这家社团在系统里的唯一标识，<text class="fn-b">建好之后不能改</text>。徽标回列表点头像再换。</block>
      </view>

      <view class="fsave {{canSubmit && !busy ? 'on' : ''}}" hover-class="fsave-hover" bindtap="submit">
        {{busy ? '创建中…' : '创建并生成密钥'}}
      </view>

      <view class="hintcard">
        <view class="hint-t">点下去会发生什么</view>
        <view class="hint-li">这家社团马上出现在学生端的社团轮播里</view>
        <view class="hint-li">同时生成第一把密钥，只在下一屏显示这一次</view>
        <view class="hint-li">负责人和老师之后再改都不影响密钥</view>
      </view>

    </block>

    <!-- ═══════════ ② 结果态：第一把密钥 ═══════════
         与编辑页「重置之后」同一个形态（CSS 也是同一套，见 create.wxss 的 @import） -->
    <block wx:if="{{!denied && done}}">

      <view class="club-org">
        <view class="club-av">{{initial}}</view>
        <view class="grow">
          <view class="on1">{{record.name}}</view>
          <view class="on2">密钥 {{record.mask}} · 刚生成</view>
        </view>
        <view class="st done">有效</view>
      </view>

      <block wx:if="{{plain}}">
        <view class="codebox">
          <view class="cell" wx:for="{{cells}}" wx:key="index">{{item}}</view>
        </view>
        <view class="keyops">
          <view class="qa" bindtap="copyPlain">复制</view>
          <view class="qa ghost" bindtap="hide">隐藏</view>
        </view>
        <view class="once-tip">这一段只会显示这一次，离开页面就没了。要发给社长请先复制。</view>
      </block>

      <!-- 点过「隐藏」之后：只剩掩码（与编辑页平时的形态一致） -->
      <view class="maskbox" wx:if="{{!plain}}">
        <view class="mask-v">密钥 {{record.mask}}</view>
        <view class="mask-s">已经藏起来了。要再看只能进这个社团重置一把。</view>
      </view>

      <view class="sharebox" wx:if="{{shareText}}">
        <view class="st-t">发给社长和指导老师</view>
        <view class="st-b">{{shareText}}</view>
        <view class="st-a"><view class="qa" bindtap="copyShare">复制整段</view></view>
      </view>

      <view class="fsave on cdone" hover-class="fsave-hover" bindtap="finish">完成</view>

    </block>

  </view>
</view>
