/* pages-partner/club-keys/edit.wxss */
@import "../../styles/club.wxss";

.ke-body { padding-top: 2rpx; }

/* ══════ 「社团信息」卡**外面**的保存按钮（2026-11-07 陛下定：动作不塞进卡里） ══════
   与卡片同宽的整行胶囊，上边距 24rpx（下面 .hintcard 自带 28rpx，不用再补）。
   没改动时是淡底灰字（点了提示"内容没变"），改过才变成实心主按钮 ——
   这样「好没好」一眼可见，也不会出现「点了一下没反应」（后端会回 40001 没有要改的内容）。 */
.fsave {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  padding: 28rpx 0;
  border-radius: 999rpx;
  background: rgba(0, 102, 204, 0.06);
  color: var(--soft);
}
.fsave.on { background: var(--accent); color: #fff; }
.fsave-hover { opacity: 0.7; }

.denied { padding: 200rpx 40rpx; text-align: center; }
.denied-t { font-size: 30rpx; color: var(--muted); }

/* ══════ 六格明文（只在刚重置后出现） ══════ */
.codebox { display: flex; justify-content: center; gap: 16rpx; margin-top: 34rpx; }
.cell {
  width: 88rpx; height: 108rpx;
  border-radius: 22rpx;
  background: var(--parchment);
  color: var(--ink);
  font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-variant-numeric: tabular-nums;
}

.keyops { display: flex; justify-content: center; gap: 16rpx; margin-top: 24rpx; }
.keyops .qa { background: var(--parchment); padding: 16rpx 34rpx; }

.once-tip {
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.6;
  padding: 18rpx 30rpx 0;
}

/* ══════ 平时的掩码块 ══════ */
.maskbox {
  margin-top: 34rpx;
  background: var(--parchment);
  border-radius: 34rpx;
  padding: 36rpx 30rpx;
  text-align: center;
}
.mask-v {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.mask-s { font-size: 21rpx; color: var(--muted); margin-top: 14rpx; line-height: 1.6; }

/* ══════ 分享段 ══════ */
.sharebox { background: var(--parchment); border-radius: 34rpx; padding: 28rpx 30rpx 22rpx; margin-top: 30rpx; }
.sharebox .st-t { font-size: 21rpx; color: var(--muted); letter-spacing: 1rpx; font-weight: 600; margin-bottom: 16rpx; }
.sharebox .st-b {
  background: #fff; border-radius: 22rpx; padding: 22rpx 24rpx;
  font-size: 23rpx; line-height: 1.85; color: var(--ink-2);
  white-space: pre-wrap;
}
.sharebox .st-a { display: flex; justify-content: flex-end; margin-top: 18rpx; }

/* 表单里的裸 input */
.fv-input { flex: 1; min-width: 0; font-size: 26rpx; color: var(--ink); height: 44rpx; }
.ph { color: var(--soft); }
.fv.muted { color: var(--muted); }
