/* 伙伴端 · 值班时段配置 v2（2026-10-29 照原型重做）
   尺寸换算：设计稿 390pt → 750rpx，1px ≈ 1.923rpx
   口径：白卡 + 深色字 + 羊皮纸底；唯一强调色 --accent；胶囊分工见
   docs/specs/14-partner-hub/partner-design-spec-v1.md（本页按钮 radius 13px，非药丸） */

.page {
  min-height: 100vh;
  background: var(--parchment, #F5F5F7);
  padding-bottom: 60rpx;
}

/* ── 自定义导航 ── */
.bar { background: var(--parchment, #F5F5F7); }
.bar-in {
  height: 88rpx;
  display: flex; align-items: center;
  padding: 0 32rpx;
}
.bar-t { font-size: 34rpx; font-weight: 600; letter-spacing: -0.8rpx; color: var(--ink, #1D1D1F); }

.body { padding: 12rpx 32rpx 0; }

/* ── 报错（拉到 ≠ 没数据） ── */
.err {
  margin: 16rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--red-bg, #FDE8E8);
  display: flex; flex-direction: column; gap: 6rpx;
}
.err-t { font-size: 26rpx; font-weight: 600; color: var(--red-fg, #B42318); }
.err-d { font-size: 22rpx; line-height: 1.6; color: var(--red-fg, #B42318); }

/* ── 顶部信息区（原型 ts-top） ── */
.ts-top { display: flex; align-items: baseline; gap: 16rpx; padding: 10rpx 0 4rpx; }
.ts-top-l { display: flex; align-items: baseline; gap: 12rpx; }
.ts-top-l .ts-no { font-size: 34rpx; font-weight: 600; letter-spacing: -0.6rpx; color: var(--ink, #1D1D1F); }
.ts-top-l .ts-range { font-size: 24rpx; color: var(--muted, #7A7A7A); }
.tag {
  margin-left: auto;
  font-size: 21rpx; padding: 6rpx 16rpx; border-radius: 9999rpx; line-height: 1.2;
  background: #F0F0F3; color: var(--muted, #7A7A7A);
}
.tag.ok { background: var(--green-bg, #E7F5EC); color: var(--green-fg, #1E7A46); }
.ts-hint {
  font-size: 24rpx; line-height: 1.7; color: var(--muted, #7A7A7A);
  padding: 4rpx 0 20rpx;
}

/* ── 按钮（radius 13px=25rpx，不是药丸） ── */
.btn {
  border-radius: 25rpx;
  min-height: 88rpx;
  padding: 0 34rpx;
  font-size: 28rpx; font-weight: 500;
  line-height: 1;
  border: 0;
  box-sizing: border-box;
}
/* ⚠️⚠️ 居中必须写成 `button.btn`（元素+类），不能只写 `.btn`：
   app.wxss 里有一条 `button.btn{display:block;width:auto}`，优先级 (0,1,1)
   高过单个类 `.btn`(0,1,0)，会把 display:flex 整个压掉 ⇒ 按钮变成
   「块级 + line-height:1」，文字贴上沿、底下空一大截（陛下 2026-10-29 截图打回）。
   同优先级靠页面 wxss 后加载取胜。 */
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.btn.primary { background: var(--accent, #0066CC); color: #FFF; }
.btn.primary::after { border: 0; }
.btn.add { width: 100%; margin: 0 0 27rpx; text-align: center; justify-content: center; }

/* ── 场次卡（原型 slot-card） ── */
.cards { display: flex; flex-direction: column; }
.slot-card {
  background: var(--canvas, #FFF);
  border: 1rpx solid #E8E9EF;              /* 原型：卡带 1px 描边 */
  border-radius: 42rpx;                    /* 22px */
  box-shadow: 0 10rpx 38rpx rgba(32, 36, 49, 0.03);
  padding: 35rpx 31rpx 27rpx;
  margin-bottom: 27rpx;
}
.slot-card .hd { display: flex; align-items: center; gap: 16rpx; }
.slot-card .sc-name {
  flex: 1; min-width: 0; font-size: 34rpx; font-weight: 600; letter-spacing: -0.6rpx; color: var(--ink, #1D1D1F); }
.hd-r { margin-left: auto; flex: none; display: flex; align-items: center; gap: 20rpx; }
.badge-n {
  min-width: 72rpx; height: 72rpx; padding: 0 12rpx;
  border-radius: 9999rpx;
  background: var(--parchment, #F5F5F7);
  font-size: 22rpx; color: var(--muted, #7A7A7A);
  display: inline-flex; align-items: center; justify-content: center;
}
.lnk {
  flex: none; display: inline; background: none; border: 0; padding: 0; margin: 0; line-height: 1;
  font-size: 26rpx; color: var(--muted, #7A7A7A); font-family: inherit;
}
.lnk::after { border: 0; }

.dl { margin-top: 15rpx; font-size: 24rpx; color: var(--muted, #7A7A7A); line-height: 1.7; }
.tm {
  margin-top: 27rpx;
  display: flex; align-items: baseline; gap: 15rpx;
  font-size: 50rpx;                        /* 26px */
  font-weight: 600; letter-spacing: -1.2rpx; color: var(--ink, #1D1D1F);
  font-variant-numeric: tabular-nums;
}
.tm .tm-sep { font-style: normal; font-size: 50rpx; color: var(--muted, #7A7A7A); font-weight: 400; letter-spacing: 0; }
.hr { height: 2rpx; background: var(--divider, #F0F0F0); margin: 27rpx 0 23rpx; }
.sum { font-size: 24rpx; color: var(--ink-2, #333); margin-bottom: 16rpx; }
.dp {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx; color: var(--ink, #1D1D1F);
}

/* 删除二步确认（原型 ask） */
.ask {
  margin-top: 18rpx; padding: 20rpx;
  border-radius: 20rpx;
  background: var(--red-bg, #FDE8E8);
  font-size: 24rpx; line-height: 1.6; color: var(--red-fg, #B42318);
  display: flex; flex-direction: column; gap: 16rpx;
}
.ask-btns { display: flex; gap: 16rpx; }
.ask-btns button {
  flex: 1; min-height: 64rpx; border-radius: 20rpx; border: 0;
  background: var(--canvas, #FFF); color: var(--ink, #1D1D1F);
  font-size: 26rpx; font-family: inherit; line-height: 64rpx; padding: 0;
}
.ask-btns button.danger, .ask-btns button.ask-yes { background: var(--red-fg, #B42318); color: #FFF; }
.ask-btns button::after { border: 0; }

.empty {
  padding: 60rpx 0; text-align: center;
  font-size: 24rpx; color: var(--muted, #7A7A7A); line-height: 1.7;
}

/* ── 底部发布条（原型 actbar） ── */
.actbar { margin-top: 32rpx; }
.btn.pub { width: 100%; }
.act-note {
  margin-top: 18rpx; text-align: center;
  font-size: 21rpx; line-height: 1.7; color: var(--muted, #7A7A7A);
}
.ro-note { padding: 30rpx 0 10rpx; }

/* ── 弹层（原型 slotNewSheet / sn-body） ── */
.sheet { position: fixed; inset: 0; z-index: 300; }
.sheet-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.3); }
.sheet-body {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: var(--canvas, #FFF);
  border-radius: 42rpx 42rpx 0 0;              /* 22px */
  box-shadow: 0 -15rpx 58rpx -23rpx rgba(0, 0, 0, 0.35);
  padding: 12rpx 0 42rpx;
  max-height: 88vh; box-sizing: border-box; overflow-y: auto;
}
.sheet-grab { width: 68rpx; height: 8rpx; border-radius: 4rpx; background: transparent; margin: 0 auto 8rpx; }
/* ⚠️ 标题与说明必须各自独立一行（上一版挤成一段被陛下打回） */
.sn-hd { display: block; padding: 24rpx 35rpx 23rpx; }
.sn-hd .sn-title { display: block; font-size: 38.5rpx; font-weight: 600; letter-spacing: -0.8rpx; line-height: 1.6; color: var(--ink, #1D1D1F); }
.sn-hd .sn-desc { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; color: var(--muted, #7A7A7A); }

.sn-sec { display: block; padding: 15rpx 35rpx 12rpx; }
.sn-lab { display: block; font-size: 22rpx; color: var(--muted, #7A7A7A); margin-bottom: 13rpx; }

/* 星期几胶囊：选中 = 浅蓝底 + 蓝字（原型 sn-days） */
.sn-days { display: flex; gap: 12rpx; }
.sn-day {
  flex: 1; height: 85rpx; border-radius: 23rpx;          /* 12px */
  border: 2rpx solid var(--hairline, #E2E2E7);
  background: var(--canvas, #FFF); color: var(--ink, #1D1D1F);
  font-size: 25rpx; font-weight: 400; font-family: inherit;
  line-height: 81rpx; padding: 0; text-align: center;
}
.sn-day::after { border: 0; }
.sn-day.on { background: var(--acc-bg, #E6F0FA); border-color: var(--accent, #0066CC); color: var(--accent, #0066CC); font-weight: 600; }

.sn-inp {
  width: 100%; height: 85rpx; box-sizing: border-box;
  padding: 0 23rpx;
  border: 2rpx solid var(--hairline, #E2E2E7); border-radius: 23rpx;
  background: var(--canvas, #FFF);
  font-size: 27rpx; color: var(--ink, #1D1D1F);
}
.sn-inp:focus { border-color: var(--accent, #0066CC); }

/* 起止时间：两个大时间块 */
.sn-times { display: flex; align-items: center; gap: 20rpx; }
.sn-times picker { flex: 1; }
.sn-time {
  height: 96rpx; border-radius: 20rpx;
  background: var(--parchment, #F5F5F7);
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.sn-time .sn-time-t { font-size: 40rpx; font-weight: 600; letter-spacing: -0.6rpx; color: var(--ink, #1D1D1F); font-variant-numeric: tabular-nums; }
.sn-clock { font-size: 26rpx; color: var(--muted, #7A7A7A); }
.sn-sep { font-size: 30rpx; color: var(--soft, #C7C7CC); }

/* 部门与人数 ± */
.sn-dept {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0;
}
.sn-dept .nm { font-size: 27rpx; font-weight: 600; letter-spacing: -0.6rpx; color: var(--ink, #1D1D1F); }
.sn-dept .nm.off { color: var(--soft, #B0B0B6); }
.cnt {
  display: flex; align-items: center;
  border: 2rpx solid var(--hairline, #E2E2E7); border-radius: 19rpx;   /* 10px，整体一框 */
  overflow: hidden; background: var(--canvas, #FFF);
}
.cnt .cnt-btn {
  width: 85rpx; height: 77rpx; border: 0; padding: 0;
  background: var(--canvas, #FFF);
  font-size: 33rpx; color: var(--ink, #1D1D1F);
  font-family: inherit; line-height: 77rpx; text-align: center;
}
.cnt .cnt-btn::after { border: 0; }
.cnt .cnt-v {
  width: 85rpx; height: 77rpx;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--canvas, #FFF);
  border-left: 2rpx solid var(--hairline, #E2E2E7);
  border-right: 2rpx solid var(--hairline, #E2E2E7);
  font-size: 27rpx; font-weight: 500; color: var(--ink, #1D1D1F); font-variant-numeric: tabular-nums;
}

/* 弹层底部按钮（原型 sn-foot：取消灰 / 保存蓝） */
.sn-foot { display: flex; gap: 19rpx; padding: 27rpx 35rpx 0; }
.sn-btn {
  flex: 1; height: 88rpx; border-radius: 23rpx;                 /* 12px 方胶囊 */
  border: 2rpx solid var(--hairline, #E2E2E7);
  background: #F4F4F6; color: var(--accent, #0066CC);
  font-size: 27rpx; font-weight: 400; font-family: inherit;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}
.sn-btn::after { border: 0; }
.sn-btn.primary { background: var(--accent, #0066CC); border-color: var(--accent, #0066CC); color: #FFF; font-weight: 500; }


/* ── 返回上一级（原型导航栏左上 ›） ── */
.back {
  width: 64rpx; height: 64rpx; margin-right: 12rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 9999rpx;
}
.back-hover { background: rgba(0, 0, 0, 0.05); }
.back-ic {
  font-size: 48rpx; line-height: 1; color: var(--ink, #1D1D1F);
  margin-top: -6rpx;
}
.bar-r { width: 64rpx; flex: none; }

/* ── 危险区：重置全部时段 ──
   项目既有的危险语言（照「退出登录」那套）：白底 + 1px hairline + 红字，
   不给红底块 —— 红底会把这一页唯一的强调色抢掉。 */
/* ── 重置入口：红字 + 下划线的一行文字链，落在页面最底部（2026-10-30 陛下定，不做按钮） ── */
.reset-line {
  margin: 72rpx 0 40rpx;
  text-align: center;
}
.reset-link {
  font-size: 24rpx;
  color: var(--red-fg, #B42318);
  text-decoration: underline;
  padding: 16rpx 12rpx;      /* 文字链也要撑出点击热区，不然很难点中 */
}
