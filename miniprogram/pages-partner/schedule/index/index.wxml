<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar"><view class="navbar-spacer"></view><view class="navbar-title">{{isMember ? '我的班表' : '班表管理'}}</view><view class="navbar-spacer"></view></view>
  <view class="body">
    <view class="hint-note" wx:if="{{loading}}">正在加载班表……</view>
    <view class="err" wx:elif="{{loadError}}"><text class="err-t">班表未能加载</text><text class="err-d">{{loadError}}</text><button class="btn ghost" bindtap="load">重新加载</button></view>
    <block wx:else>
      <!-- 周切换：三端共用这一条，位置在状态条上方（先选看哪一周，再看这一周的状态）
           写法和考勤 / 请假 / 可排时间 / 排班工作台同一套 .wk-nav，别另造按钮。
           ⚠️ 这里是「本周」胶囊唯一的出口 —— 原来社干抬头里也写了一遍日期，已删。 -->
      <view class="wk-nav">
        <text class="wk-b" bindtap="onPrevWeek">‹ 上一周</text>
        <view class="wk-mid">
          <text class="wk-tag {{isThisWeek ? 'on' : 'off'}}">{{isThisWeek ? '本周' : '非本周'}}</text>
          <text class="wk-c">{{weekText || '加载中'}}</text>
        </view>
        <text class="wk-b r {{isThisWeek ? 'off' : ''}}" bindtap="onNextWeek">下一周 ›</text>
      </view>
      <view class="pl-state {{state === 'published' ? 'pub' : state === 'draft' ? 'draft' : state === 'withdrawn' ? 'wd' : 'none'}}"><text class="ps-b">{{stateText}}</text><text class="ps-s">{{stateSub}}</text></view>
      <duty-timetable week="{{week}}" my-id="{{myId}}" visible-people="{{!isMember || state === 'published'}}" slots="{{slots}}" show-head="{{false}}"/>
      <block wx:if="{{!isMember}}">
        <view class="pl-ops"><button class="btn primary" bindtap="goPlanning">进入排班工作台（可编辑）</button><text class="ts-bar-h">这一页只能看。生成草稿、换人、校验、发布、撤回都在「排班工作台」里做。</text></view>
        <view class="sc-wrap">
          <view class="sc-row" bindtap="goPlanning" hover-class="row-hover"><image class="ric" src="/assets/partner/ic-chk.png"/><text class="sc-tx">排班工作台</text><text class="sc-st">{{stateText}}{{needText}}</text><text class="sc-ar">›</text></view>
          <view class="sc-row" bindtap="goWorkload" hover-class="row-hover"><image class="ric" src="/assets/partner/ic-star.png"/><text class="sc-tx">人员轮值情况</text><text class="sc-st">本月 {{monthTotal}} 场</text><text class="sc-ar">›</text></view>
          <view class="sc-row" bindtap="goHistory" hover-class="row-hover"><image class="ric" src="/assets/partner/ic-refresh.png"/><text class="sc-tx">发布与调整记录</text><text class="sc-st">当前第 {{week.version || 0}} 版</text><text class="sc-ar">›</text></view>
          <view class="sc-row" bindtap="onExport" hover-class="row-hover"><image class="ric" src="/assets/partner/ic-pen.png"/><text class="sc-tx">导出本周班表</text><text class="sc-st">复制文本</text><text class="sc-ar">›</text></view>
        </view>
      </block>
      <view class="blk" wx:if="{{myLeaves.length}}"><view class="blk-h"><text class="t">我的请假</text><text class="more">{{leavePending}} 条待批</text></view><view class="row" wx:for="{{myLeaves}}" wx:key="id"><text class="r-text">{{item.label}}</text><text class="tag {{item.tagCls}}">{{item.statusText}}</text></view></view>
      <view class="blk" wx:if="{{isMember}}"><view class="blk-h"><text class="t">本月场次</text><text class="more">{{monthLabel}}</text></view><view class="hint-note" wx:if="{{!monthList.length && !personalError}}">本月还没有正式值班安排</view><view class="row" wx:for="{{monthList}}" wx:key="personId"><text class="r-text {{item.mine ? 'mine' : ''}}">{{item.personName}}{{item.mine ? '（我）' : ''}}</text><text class="rv">{{item.count}} 场</text></view></view>
      <view class="ts-bar"><text class="ts-bar-h">排班不使用个人权重：先满足硬条件，再按轮值均衡；没有合格的人就保留缺岗。</text></view>
    </block>
  </view>
</view>
<partner-tabbar wx:if="{{ready}}" role="{{roleKey}}" active="{{tabId}}" badges="{{badges}}" bind:switch="onTab"/>
