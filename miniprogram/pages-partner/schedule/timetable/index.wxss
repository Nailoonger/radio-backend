:host{display:block;min-width:0}.wk{background:#fff;border-radius:35rpx;padding:35rpx 31rpx 31rpx;color:#1D1D1F}.hd{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx;margin-bottom:31rpx}.title{font-size:32rpx;font-weight:600;letter-spacing:-.8rpx;font-variant-numeric:tabular-nums}.sub{font-size:21rpx;color:#76767E;flex-shrink:0}.band{display:flex;align-items:center;gap:16rpx;background:#F5F5F7;border-radius:23rpx;padding:17rpx 23rpx;margin:4rpx 0 23rpx;box-shadow:inset 0 0 0 2rpx #E3E3E8}.band-label{font-size:22rpx;color:#76767E;flex-shrink:0}.band-time{display:block;font-size:19rpx}.band-people{display:flex;gap:12rpx;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}.band-group{display:flex;gap:8rpx;flex-wrap:wrap}.grid{display:grid;grid-template-columns:112rpx repeat(5,minmax(0,1fr));gap:12rpx;align-items:center}.column{text-align:center;font-size:21rpx;color:#76767E;line-height:1.35}.column text,.row-label text{display:block}.day{font-size:23rpx;font-weight:500;color:#1D1D1F}.row-label{font-size:20rpx;color:#76767E;line-height:1.4}.row-label .tm{font-size:17rpx;letter-spacing:-.3rpx;font-variant-numeric:tabular-nums;white-space:nowrap}.cell{min-height:108rpx;display:flex;flex-direction:column;justify-content:center;gap:8rpx;min-width:0}.group{min-width:0}.chip{display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:500;font-size:21rpx;line-height:1.2;padding:15rpx 3rpx;border-radius:23rpx;background:#F5F5F7;text-align:center;box-sizing:border-box;min-width:0;word-break:break-all}.chip+.chip{margin-top:8rpx}.chip.one{padding:6rpx 17rpx;border-radius:15rpx;line-height:1.6;display:inline-block}.band-group .chip+.chip{margin-top:0}.person{display:block}.dept{font-size:17rpx;font-weight:400;line-height:1.3;color:#76767E}.me{background:#EAF3FD;color:#0066CC}.leave{background:#FDF3DC;color:#B26A00}.ok{background:#EAF7EF;color:#1E8E4E}.empty{background:transparent;color:#B3B3B8;box-shadow:inset 0 0 0 3rpx #E3E3E8}.fixed{background:#FDECEA;color:#B42318}.legend{display:flex;flex-wrap:wrap;gap:19rpx 22rpx;padding-top:27rpx;border-top:2rpx solid #E3E3E8;margin-top:31rpx}.legend>text{display:flex;align-items:center;gap:8rpx;font-size:20rpx;color:#76767E}.dot{display:inline-block;width:19rpx;height:19rpx;border-radius:7rpx;box-shadow:inset 0 0 0 2rpx currentColor}.note{display:block;font-size:20rpx;color:#999DA6;line-height:1.6;margin-top:19rpx}.no-slots{font-size:24rpx;color:#76767E;text-align:center;padding:32rpx 0}
