.page{min-height:100vh;background:#F5F5F7}.body{padding:19rpx 35rpx calc(55rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:23rpx}.chev{width:18rpx;height:18rpx;border-left:4rpx solid #333;border-bottom:4rpx solid #333;transform:rotate(45deg);margin-left:6rpx}.state{border-radius:27rpx;padding:21rpx 27rpx;font-size:23rpx;line-height:1.6;display:flex;flex-direction:column;gap:5rpx}.state-title{font-size:26rpx;font-weight:600}.state.none{background:#F0F1F4;color:#5A5A5F}.state.draft{background:#FFF4DD;color:#8A5A12}.state.published{background:#EAF3FD;color:#0066CC}.summary{display:flex;justify-content:space-around;background:#fff;border-radius:27rpx;padding:22rpx 14rpx}.summary>view{flex:1;text-align:center;display:flex;flex-direction:column;font-size:21rpx;color:#76767E}.summary>view+view{border-left:1rpx solid #E3E3E8}.number{font-size:36rpx;font-weight:600;line-height:1.5;color:#1D1D1F;font-variant-numeric:tabular-nums}.denom{font-size:23rpx;color:#76767E;font-weight:400}.ops{display:flex;flex-direction:column;gap:17rpx}.buttons{display:flex;gap:15rpx}.buttons button.btn{flex:1;min-width:0;padding:0 6rpx;font-size:24rpx}button.btn{display:flex;align-items:center;justify-content:center;width:100%;height:88rpx;border-radius:25rpx;font-size:27rpx;font-weight:500;padding:0 22rpx;line-height:1.3;margin:0;box-sizing:border-box;border:0}button.btn::after,button.mini::after,button.close::after{border:0}button.primary{background:#0066CC;color:#fff}button.ghost{background:#fff;color:#0066CC;box-shadow:inset 0 0 0 2rpx #E2E2E7}button.btn[disabled]{opacity:.45}button.mini{padding:16rpx 0;background:transparent;color:#76767E;font-size:22rpx;line-height:1.6;margin:0;width:100%;text-align:center;text-decoration:underline}button.mini[disabled]{opacity:.45}.note{display:block;font-size:21rpx;color:#76767E;line-height:1.7}.hint-note{text-align:center;font-size:23rpx;color:#76767E;padding:30rpx 0;display:block}.check,.error{background:#fff;border-radius:27rpx;padding:25rpx;display:flex;flex-direction:column;gap:16rpx}.issue{display:block;color:#B42318;font-size:23rpx;line-height:1.6}.missing{display:block;color:#8A5A12;font-size:23rpx;line-height:1.6}.links{background:#fff;border:1rpx solid #E8E9EF;border-radius:38.5rpx;box-shadow:0 10rpx 38rpx rgba(32,36,49,.03);padding:2rpx 0;margin-bottom:35rpx}
/* 原型 .pl-row：h 62px、padding 12/16、gap 12px、行间**无**分隔线 */
.link{display:flex;align-items:center;gap:23rpx;min-height:119rpx;font-size:27rpx;color:#1D1D1F;padding:23rpx 31rpx;box-sizing:border-box}
.link image{width:42rpx;height:42rpx;flex-shrink:0}
.hint{font-size:21rpx;color:#76767E;text-align:right;flex:1;min-width:0}
.link .ar{font-size:31rpx;color:#C7C7CC;flex:none}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1000;display:flex;align-items:flex-end}.sheet{background:#fff;width:100%;max-height:88vh;padding:30rpx 35rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:38rpx 38rpx 0 0;box-sizing:border-box;display:flex;flex-direction:column;gap:20rpx}.sheet-head{display:flex;align-items:center;justify-content:space-between}button.close{background:transparent;color:#0066CC;font-size:25rpx;padding:0;margin:0;line-height:1.5}.edit-title{font-size:25rpx;font-weight:500}.candidate-list{height:40vh;min-height:100rpx;flex-shrink:1}.candidate{display:flex;align-items:center;gap:18rpx;padding:22rpx 16rpx;border-radius:22rpx}.candidate+.candidate{margin-top:6rpx}.candidate.selected{background:#EAF3FD}.candidate.unavailable{color:#999DA6}.candidate-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}.candidate-name{font-size:27rpx}.candidate-note{font-size:21rpx;color:#76767E;line-height:1.5}.pick{width:35rpx;height:35rpx;border:2rpx solid #C7C7CC;border-radius:11rpx;text-align:center;font-size:25rpx;line-height:35rpx;flex-shrink:0}.selected .pick{background:#0066CC;color:#fff;border-color:#0066CC}.fixed-option{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:#76767E}.reason{height:80rpx;line-height:80rpx;padding:0 24rpx;background:#F5F5F7;border-radius:20rpx;font-size:25rpx;box-sizing:border-box;width:100%}
.state.withdrawn{background:#FDECEA;color:#B42318}.empty-note{padding:0 6rpx}
.empty-note{display:block;background:#fff;border:1rpx solid #E8E9EF;border-radius:31rpx;box-shadow:0 10rpx 38rpx rgba(32,36,49,.03);padding:23rpx 27rpx;font-size:24rpx;line-height:1.65;color:#76767E}
