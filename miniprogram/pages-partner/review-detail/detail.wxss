/* pages-partner/review-detail/detail.wxss
   ══ L1「白卡大投影」══════════════════════════════════════════════
   不引入任何新颜色，纯靠海拔差当焦点：
     · 页面底退成羊皮纸灰（--parchment）
     · 主卡（投稿人卡 / 投稿内容 / 驳回原因箱）白底 + 第 3 档投影 --sh-lift
     · 原来的 1px 描边一律去掉（描边叠影子会显脏）
     · 卡内次级块（名额条、文本域）翻过来 —— 白卡里嵌灰块
   ⚠️ --sh-lift 全是纯黑透明（三通道极差 0），是中性投影，不是彩色投影。 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--canvas);
}
/* L1 标记：本页恒为 lift —— 页面底由白退成羊皮纸灰，卡片才浮得起来 */
.page.lift { background: var(--parchment); }

/* 返回箭头 */
.chev {
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--ink-2);
  border-bottom: 4rpx solid var(--ink-2);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/* ⚠️ 这里原有一个 .navbar-quiet（顶栏右侧显示「点歌 / 文稿」）—— 已删：
   自定义导航右上角是微信胶囊的地盘，放那儿会被盖掉；类型在卡里已经写了。 */

/* 底部固定操作条要占位，否则最后一张卡会被压住。
   ⚠️ 留白 = 栏高（20 + 108 + 28 + 安全区 ≈ 214rpx）+ 渐隐带 ≈ 40rpx，宁可多给不能少给：
      2026-10-30 之前写 220rpx，正好等于栏高 ⇒ 最后一张卡和操作条贴在一起，
      看起来像被白条「切了一刀」。 */
.body {
  flex: 1;
  padding: 0 36rpx 300rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ══════════ 上一条 / 位置 / 下一条 ══════════ */
.cs-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  padding: 2rpx 4rpx 0;
  flex: none;
}
.cs-nav-b { color: var(--accent); }
.cs-nav-b.off { color: var(--soft); }
.cs-nav-c { font-size: 23rpx; color: var(--muted); }

/* ══════════ 主卡：白底 + 第 3 档投影 ══════════ */
.pod,
.card-sec,
.reject-box {
  background: var(--canvas);
  border-radius: 34rpx;
  box-shadow: var(--sh-lift);
  flex: none;
}
.pod { padding: 31rpx; }
.card-sec { padding: 0 31rpx 8rpx; }
.reject-box { padding: 0 31rpx 24rpx; }

/* ── 投稿人卡 ── */
.pod-person { display: flex; align-items: center; gap: 20rpx; }
.pod-av {
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  flex: none;
  background: var(--ink);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.grow { flex: 1; min-width: 0; }
.pod-name { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.pod-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pod-chip {
  font-size: 21rpx;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  flex: none;
  background: var(--parchment);
  color: var(--muted);
}
.pod-stats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--divider);
}
/* 三组各占 1/3 且**组内居中**。
   ⚠️ 原来是左对齐：前两组是「0」，第三组是最长的日期时间 ⇒ 整行被第三组拽偏，
      看着像三组没对齐（2026-10-30 被指出）。居中后每组以自己那一格的中线为准。
   ⚠️ 0 是 40rpx、日期是 30rpx，所以两者都用 line-height:1 + 同一个 margin-top：
      顶部对齐（v151 也是这么排的），不会一个高一个低。 */
.pod-stat { flex: 1; min-width: 0; text-align: center; }
.pod-stat-l { font-size: 22rpx; color: var(--muted); line-height: 1.2; }
.pod-stat-n {
  font-size: 40rpx; font-weight: 600; color: var(--ink);
  margin-top: 8rpx; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.pod-stat-d {
  font-size: 30rpx; font-weight: 600; color: var(--ink);
  margin-top: 8rpx; line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* ── 小节卡 ── */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 31rpx 0 23rpx;
}
.sh-t { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.sh-m { font-size: 22rpx; color: var(--muted); }

.kv { display: flex; gap: 20rpx; padding: 25rpx 0; align-items: flex-start; }
.kv + .kv { border-top: 2rpx solid var(--divider); }
.kv .k { width: 160rpx; flex: none; font-size: 23rpx; color: var(--muted); line-height: 1.55; }
.kv .v { flex: 1; min-width: 0; font-size: 23rpx; line-height: 1.6; color: var(--ink-2); }
.kv .v.strong { font-weight: 600; color: var(--ink); }

/* ── 名额条：白卡里嵌灰块 ── */
.quota { border-radius: 22rpx; background: var(--parchment); padding: 22rpx 26rpx; }
.quota-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 25rpx;
  color: var(--muted);
}
.quota-row .qb { font-size: 30rpx; color: var(--ink); font-weight: 600; }
.qbar {
  height: 10rpx;
  border-radius: 9999rpx;
  background: var(--hairline);
  margin-top: 18rpx;
  overflow: hidden;
}
.qbar-fill { height: 100%; background: var(--accent); border-radius: 9999rpx; }
.q-hint { font-size: 22rpx; color: var(--muted); margin-top: 16rpx; line-height: 1.55; }

/* ── 驳回原因箱 ── */
.rb-head { display: flex; align-items: center; justify-content: space-between; padding: 31rpx 0 23rpx; }
.rb-t { font-size: 27rpx; font-weight: 500; color: var(--ink); }
.rb-req {
  font-size: 21rpx;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background: var(--red-bg);
  color: var(--red-fg);
}
.presets { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.preset {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: var(--parchment);
  color: var(--ink-2);
  border: 2rpx solid transparent;
}
.preset.on { background: var(--accent-tint); color: var(--accent); border-color: var(--accent); }

/* 文本域：灰底嵌在白卡里 */
.ta {
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: var(--parchment);
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
  min-height: 108rpx;
}
.ta-ph { color: var(--soft); }

.warnline { display: flex; gap: 14rpx; margin-top: 20rpx; }
.warn-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: var(--red-fg);
  flex: none;
  margin-top: 12rpx;
}
.warnline > text { flex: 1; font-size: 22rpx; color: var(--muted); line-height: 1.6; }

/* ── 审核记录 ── */
.record { font-size: 24rpx; color: var(--muted); line-height: 1.75; }
.rec-line { word-break: break-all; }

/* ══════════ 底部固定操作条 ══════════
   v151 的 `.actbar` 是「贴底 + 上边缘渐隐到羊皮纸」，**不是**白条加一条分隔线：
   白条压在白卡上会被看成一刀把卡片切开（2026-10-30 被指出）。
   所以这里：fixed 钉在屏幕底 + 同一套 parchment 渐隐，按钮像浮在内容之上。

   ⚠️ 安全区写两遍：老基础库不认 `env()` 时，整条 padding 声明会失效变 0，
      按钮就贴到屏幕最底边被 home 指示条压住 —— 看起来同样是「被切」。
      先给 constant()，再给 env()，最后还有一条纯 28rpx 兜底（顺序不能反）。 */
.actionbar2 {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 36rpx 28rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 245, 247, 0) 0%, var(--parchment) 30%);
  display: flex;
  gap: 18rpx;
  z-index: 20;
}
/* 渐隐要把按钮上方的内容压淡，所以留一条往下渐变的遮罩带；
   它本身就是 .actionbar2 的背景，不再额外加一层元素（多一层会挡住点击）。 */
button.btn-lg2 {
  flex: 1;
  height: 108rpx;
  border-radius: 9999rpx;
  border: none;
  font-size: 25rpx;
  font-weight: 500;
  padding: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
button.btn-lg2::after { border: none; }
button.btn-lg2.pass { background: var(--accent); color: #fff; }
/* 次级按钮：白胶囊浮在羊皮纸上（v151 `.btn.ghost` 是白底 + 投影，不描边 ——
   手机里不要装饰性描边框，留边只给「有状态含义」的件） */
button.btn-lg2.rej {
  background: var(--canvas);
  color: var(--accent);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .06);
}
button.btn-lg2[disabled] { opacity: 0.45; }

/* ══════════ 提示行 ══════════ */
.hint-note {
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
  padding: 60rpx 0;
  flex: none;
}

.pressed { opacity: 0.72; }
