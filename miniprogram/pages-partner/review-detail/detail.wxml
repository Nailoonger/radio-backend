<!-- pages-partner/review-detail/detail.wxml
     审核处理台 —— L1「白卡大投影」：页面底是羊皮纸灰，卡片浮起来（第 3 档投影），
     描边全去；卡内的名额条 / 文本域退回灰底（白卡里嵌灰块）。 -->
<view class="page lift {{enter ? 'enter' : ''}}">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <view class="navbar">
    <view class="navbar-back" hover-class="pressed" bindtap="goBack" aria-label="返回">
      <view class="chev"></view>
    </view>
    <view class="navbar-title">审核处理台</view>
    <!-- ⚠️ 顶栏右侧一律留空（微信胶囊的地盘，见 app.js 的 navRightSpace 说明）。
         原来这里放「点歌 / 文稿」，会被胶囊盖掉；而且卡里「投稿内容（点歌）」已经写了类型，
         信息完全重复 —— 所以直接空着，和其余 8 个页面保持一致。 -->
    <view class="navbar-spacer"></view>
  </view>

  <!-- ============ 骨架层（2026-11-16 · preview/loading-skeleton-v3 口径） ============
       ⚠️ fixed 不是 absolute；伙伴端底色 #F5F5F7。
          底部操作条在骨架层之下（z-index 25 盖住它），所以骨架期间不会出现「看起来能点」的假按钮。
          「驳回原因 / 必填 / 审核记录」这些卡内标题也摆灰块 —— 卡内一律整块灰。 -->
  <view class="sklayer {{skOut ? 'sklayer-out' : ''}}" wx:if="{{sk}}">
    <view class="statusbar" style="height: {{statusBarHeight}}px"></view>
    <view class="navbar">
      <view class="navbar-back"></view>
      <view class="navbar-title">审核处理台</view>
      <view class="navbar-spacer"></view>
    </view>
    <view class="body">
      <view class="cs-nav">
        <text class="cs-nav-b">‹ 上一条</text>
        <view class="sk sk-s" style="width:240rpx"></view>
        <text class="cs-nav-b">下一条 ›</text>
      </view>
      <view class="pod">
        <view class="pod-person">
          <view class="pod-av"><view class="sk sk-c" style="width:88rpx;height:88rpx"></view></view>
          <view class="grow">
            <view class="sk sk-l" style="width:160rpx"></view>
            <view class="sk sk-s" style="width:220rpx;margin-top:10rpx"></view>
          </view>
          <view class="sk sk-r" style="width:88rpx;height:36rpx"></view>
        </view>
        <view class="pod-stats">
          <view class="pod-stat" wx:for="{{[1,2,3]}}" wx:key="*this">
            <view class="sk sk-s" style="width:80rpx"></view>
            <view class="sk sk-l" style="width:56rpx;margin-top:12rpx"></view>
          </view>
        </view>
      </view>

      <view class="card-sec">
        <view class="sk" style="width:240rpx;height:32rpx;top:0"></view>
        <view class="sk-para" style="margin-top:24rpx">
          <view class="sk sk-l" style="width:100%"></view>
          <view class="sk sk-l" style="width:100%"></view>
          <view class="sk sk-l" style="width:64%"></view>
        </view>
      </view>

      <view class="card-sec">
        <view class="sk" style="width:180rpx;height:32rpx;top:0"></view>
        <view class="presets" style="margin-top:24rpx">
          <view class="sk sk-r" style="width:132rpx;height:52rpx" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
        </view>
        <view class="sk" style="width:100%;height:132rpx;border-radius:12rpx;margin-top:18rpx;top:0"></view>
      </view>

      <view class="card-sec">
        <view class="sk" style="width:150rpx;height:32rpx;top:0"></view>
        <view class="sk sk-s" style="width:80%;margin-top:20rpx"></view>
        <view class="sk sk-s" style="width:62%;margin-top:14rpx"></view>
      </view>
    </view>
  </view>
  <block wx:if="{{!sk || skOut}}">
  <view class="body" wx:if="{{notFound}}">
    <view class="hint-note">这条{{isDraft ? '稿件' : '投稿'}}不存在，或已被删除</view>
  </view>

  <block wx:else>
    <view class="body">
      <!-- 上一条 / 位置 / 下一条 -->
      <view class="cs-nav in i0">
        <text class="cs-nav-b {{pos <= 1 ? 'off' : ''}}" bindtap="prevOne">‹ 上一条</text>
        <!-- ⚠️ 内容必须写在同一行：<text> 会保留换行，拆行写会多出一个空行把这一行撑高 -->
        <text class="cs-nav-c {{slotFull ? 'is-full' : ''}}">{{navText}}</text>
        <text class="cs-nav-b {{pos >= queueTotal ? 'off' : ''}}" bindtap="nextOne">下一条 ›</text>
      </view>

      <!-- 投稿人卡（白卡 + 大投影） -->
      <view class="pod in i1">
        <view class="pod-person">
          <view class="pod-av">{{person.initial}}</view>
          <view class="grow">
            <view class="pod-name">{{person.name}}</view>
            <view class="pod-sub">{{person.sub}}</view>
          </view>
          <text class="pod-chip">{{person.chip}}</text>
        </view>
        <!-- ⚠️ 三格由 js 的 stats 驱动：学生投稿是「历史通过/驳回/首次投稿」，
             内部稿件是「版本/字数/预计时长」—— 两套数据一样宽，模板只认数组，不写死三项。 -->
        <view class="pod-stats">
          <view class="pod-stat" wx:for="{{stats}}" wx:key="l">
            <view class="pod-stat-l">{{item.l}}</view>
            <view class="{{item.l === '首次投稿' ? 'pod-stat-d' : 'pod-stat-n'}}">{{item.n}}</view>
          </view>
        </view>
      </view>

      <!-- 内容（白卡 + 大投影） -->
      <view class="card-sec in i2">
        <view class="sec-head">
          <text class="sh-t">内容（{{kindText}}）</text>
          <!-- 内部稿件的栏目挪到这儿：正文那块已经不再挂「栏目」这一行了 -->
          <text class="sh-m" wx:if="{{isDraft}}">{{docCol}}</text>
        </view>

        <!-- 内部稿件：正文整块占满卡宽
             ⚠️ 不用 kv 行 —— 那是「160rpx 左标签列 + 右内容列」，正文越长左边白条越刺眼，
                右边内容列还被挤窄。这里第一行标题（粗体、字号大一点），第二行起是正文。 -->
        <view class="doc" wx:if="{{isDraft && doc}}">
          <view class="doc-title"><text>{{doc.title}}</text></view>
          <view class="doc-body"><text>{{doc.body}}</text></view>
        </view>

        <!-- 学生投稿：歌曲 / 希望播出时段 / 想说的话，短字段，继续用 kv 行 -->
        <block wx:else>
          <view class="kv" wx:for="{{rows}}" wx:key="k">
            <text class="k">{{item.k}}</text>
            <text class="v {{item.strong ? 'strong' : ''}}">{{item.v}}</text>
          </view>
        </block>
      </view>

      <!-- 处理结果：本周名额（仅点歌） -->
      <view class="card-sec in i3" wx:if="{{quota}}">
        <view class="sec-head"><text class="sh-t">处理结果</text></view>
        <view class="quota">
          <view class="quota-row">
            <text>本周名额</text>
            <text><text class="qb">{{quota.used}}</text> / {{quota.limit}} · 还剩 {{quota.remain}}</text>
          </view>
          <view class="qbar"><view class="qbar-fill" style="width: {{quota.pct}}%"></view></view>
          <view class="q-hint">通过会占用一个名额（日 + 周各一个）。</view>
        </view>
      </view>

      <!-- 驳回原因（白卡 + 大投影；预设胶囊保持羊皮纸灰） -->
      <view class="reject-box in i4" id="rejectBox">
        <view class="rb-head">
          <text class="rb-t">驳回原因</text>
          <text class="rb-req">必填</text>
        </view>
        <view class="presets">
          <view class="preset {{presetIndex === index ? 'on' : ''}}"
                wx:for="{{presets}}" wx:key="*this"
                data-idx="{{index}}" bindtap="tapPreset">{{item}}</view>
        </view>
        <textarea class="ta" value="{{reason}}" bindinput="inputReason"
                  placeholder="{{isDraft ? '或直接写明原因，会原样展示给作者' : '或直接写明原因，会原样展示给投稿人'}}"
                  placeholder-class="ta-ph" maxlength="200" auto-height />
        <view class="warnline">
          <view class="warn-dot"></view>
          <text>{{isDraft ? '原因会原样展示给作者' : '原因会原样展示给投稿人（小程序「我的投稿」里可见）'}}，写清理由再驳回。未填原因时「驳回」不可点。</text>
        </view>
      </view>

      <!-- 审核记录 -->
      <view class="card-sec in i5">
        <view class="sec-head"><text class="sh-t">审核记录</text></view>
        <view class="record">
          <view class="rec-line {{item.tm ? '' : 'now'}}" wx:for="{{recordLines}}" wx:key="index">
            <view class="rec-tx">
              <text wx:if="{{item.name}}" class="rec-name">{{item.name}}</text>
              <text wx:if="{{item.role}}" class="rec-role">（{{item.role}}）</text>
              <text class="rec-body">{{item.name ? ' ' : ''}}{{item.tx}}</text>
            </view>
            <text class="rec-tm">{{item.tm}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部固定操作条（白底 + 上边框，页面变灰后自然成为「操作区」） -->
    <view class="actionbar2">
      <button class="btn-lg2 rej" hover-class="pressed"
              bindtap="doReject" disabled="{{!canReject || submitting}}">驳 回</button>
      <button class="btn-lg2 pass" hover-class="pressed"
              bindtap="doApprove" disabled="{{submitting}}">{{slotFull ? '跳过满格 · 审下一条' : '通过并取下一条'}}</button>
    </view>
  </block>
  </block>
</view>
