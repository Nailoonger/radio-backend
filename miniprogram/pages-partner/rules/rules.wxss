/* pages-partner/rules/rules.wxss · v1 */
.page { min-height: 100vh; display: flex; flex-direction: column; background: #F5F5F7; }
.chev {
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--ink-2);
  border-bottom: 4rpx solid var(--ink-2);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.body { flex: 1; padding: 19rpx 35rpx 80rpx; display: flex; flex-direction: column; gap: 23rpx; }

.rows { background: #FFFFFF; border-radius: 35rpx; padding: 0 31rpx; }
.row { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 0; }
.row + .row { border-top: 2rpx solid #E3E3E8; }
.r-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.r-name { font-size: 27rpx; font-weight: 500; color: #1D1D1F; }
.r-sub { font-size: 21rpx; color: #76767E; margin-top: 6rpx; }

.stepper { display: flex; align-items: center; gap: 4rpx; flex: none; }
.st-b {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  background: #F5F5F7; color: #0066CC;
  font-size: 30rpx; line-height: 56rpx; text-align: center;
}
.st-v {
  min-width: 56rpx; text-align: center;
  font-size: 29rpx; font-weight: 600; color: #1D1D1F;
  font-variant-numeric: tabular-nums;
}
.sw { transform: scale(.8); transform-origin: right center; }

/* 非超管看到的只读数值（代替加减号那一组）：2026-11-02
   ⚠️ 只读态连开关也不给拨 —— 这一行是「值」不是控件，所以用深字不用强调色 */
.st-ro {
  flex: none;
  font-size: 29rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-variant-numeric: tabular-nums;
  margin-right: 8rpx;
}

.note { font-size: 21rpx; color: #76767E; line-height: 1.7; text-align: center; padding: 0 20rpx; }
.acts { display: flex; }
button.btn {
  flex: 1;
  height: 100rpx;
  border-radius: 9999rpx;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0; margin: 0; border: 0;
  box-sizing: border-box;
}
button.btn::after { border: 0; }
button.btn.primary { background: #0066CC; color: #FFFFFF; }
button.btn[disabled] { opacity: .45; }
.hint-note { text-align: center; font-size: 23rpx; color: #76767E; padding: 30rpx 0; }
.pressed { opacity: .72; }
