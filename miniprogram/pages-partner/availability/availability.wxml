<!-- 伙伴端 · 可排时间 / 值班时间代录（对齐 v151 `proxy` 屏）
     ⚠️⚠️ 这里**不用 <template>**：方块点不动的根因就是 template 里的
        bindtap 拿不到页面方法 / dataset（陛下 2026-10-29 两次打回）。宁可重复写两遍。
     ⚠️ 弹层用 hidden 常驻，不挂 wx:if —— 里面有 textarea，wx:if 销毁重建会吞字。
     ⚠️ 两态：能来 / 不能来，在 js 里算成 cls（on / off），模板不写嵌套三元。 -->

<view class="page">

  <!-- 顶部：返回 + 标题（2026-10-30 起顶部**不再写日期**，日期下移到周切换卡里） -->
  <view class="bar" style="padding-top:{{statusBarHeight}}px">
    <view class="bar-in">
      <view class="back" bindtap="goBack" hover-class="nav-hover">‹</view>
      <text class="bar-title">{{isMember ? '我的可排时间' : '值班时间代录'}}</text>
      <!-- 与返回键等宽的占位：没有它标题会被返回键推得偏右，不是真居中 -->
      <view class="bar-hold"></view>
    </view>
  </view>

  <!-- 周切换：左右文字链 + 中间「本周」红胶囊 + 月日（与请假 / 考勤页同一套，2026-10-30 定）
       ⚠️ 「本周」是红底白字的胶囊标签；翻到别的周就换成灰底的「非本周」（陛下 2026-10-30 定） -->
  <view class="wk-nav">
    <text class="wk-b" bindtap="onPrevWeek">‹ 上一周</text>
    <view class="wk-mid">
      <text class="wk-tag {{isThisWeek ? 'on' : 'off'}}">{{isThisWeek ? '本周' : '非本周'}}</text>
      <text class="wk-c">{{weekText || '加载中'}}</text>
    </view>
    <text class="wk-b r {{isThisWeek ? 'off' : ''}}" bindtap="onNextWeek">下一周 ›</text>
  </view>

  <!-- ══════ 站员：就地填报 ══════ -->
  <block wx:if="{{isMember}}">
    <view class="empty" wx:if="{{!loading && !ready}}">
      <text class="empty-t">本周值班时段还没发布</text>
      <text class="empty-s">等超管在「值班时段」里发布后，这里才会出现可选的时段。</text>
    </view>
    <view class="warn" wx:if="{{stale}}">
      <text class="warn-t">值班时段已更新</text>
      <text class="warn-s">你上次填的内容基于旧时段，请重新确认后提交。</text>
    </view>

    <view class="days">
      <view class="day" wx:for="{{days}}" wx:key="day" wx:for-item="d" wx:for-index="di">
        <view class="day-hd">
          <text class="day-name">{{d.name}}</text>
          <text class="day-date">{{d.dateText}}</text>
          <text class="day-cnt">{{d.onCount}} / {{d.slots.length}} 个时段</text>
        </view>
        <view class="avg">
          <view class="avslot {{s.cls}}" wx:for="{{d.slots}}" wx:for-item="s" wx:for-index="si" wx:key="slotKey"
                data-di="{{di}}" data-si="{{si}}" bindtap="onTapSlot" hover-class="avslot-hover">
            <text class="avslot-t">{{s.title}}</text>
            <text class="avslot-s">{{s.timeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="note">
      <view class="note-hd"><text class="lbl">说明</text><text class="lbl-tip">{{reasonTip}}</text></view>
      <textarea class="ta" model:value="{{reason}}" placeholder="{{reasonPh}}" placeholder-class="ta-ph" maxlength="200" auto-height></textarea>
      <text class="cnt">{{reasonLen}}/200</text>
    </view>

    <view class="confirm" bindtap="onToggleConfirm" hover-class="confirm-hover">
      <view class="cbox {{confirmed ? 'on' : ''}}"><text class="cbox-t" wx:if="{{confirmed}}">✓</text></view>
      <text class="ctext">我确认已完整填写本周可排时间。</text>
    </view>

    <view class="foot" wx:if="{{ready}}">
      <button class="btn ghost" bindtap="onReset">清空</button>
      <button class="btn primary" loading="{{submitting}}" bindtap="onSubmit">提交</button>
    </view>
  </block>

  <!-- ══════ 社干 / 超管 ══════ -->
  <block wx:else>
    <!-- 我的值班岗位：社干 / 超管自己配（2026-10-30 定稿：配岗位 + 可多选）
         ⚠️⚠️ 只配岗位，部门由后端按岗位反推（播音→播音部 / 主持→主持部 / 编辑→编辑部）。
            别再往这里加一行部门让人选 —— 同一件事选两遍必然对不上，当天就被退回过。
            库里已有的记者 / 技术不在这三格里，但保存时原样带回，不会被清掉。 -->
    <view class="rolecard">
      <view class="rc-hd">
        <text class="rc-t">我的值班岗位</text>
        <text class="rc-bd {{roleText !== '未选' ? 'on' : ''}}">{{roleText}}</text>
      </view>
      <view class="rc-chips">
        <view class="rc-chip {{item.on ? 'on' : ''}}"
              wx:for="{{roleChips}}" wx:key="label"
              data-l="{{item.label}}" bindtap="onToggleMyRole" hover-class="rc-hover">{{item.label}}</view>
      </view>
      <view class="rc-foot">
        <text class="rc-hint">{{roleHint}}</text>
        <view class="rc-save {{roleDirty ? '' : 'off'}}" bindtap="onSaveRoles">{{roleSaving ? '保存中…' : '保存'}}</view>
      </view>
    </view>

    <view class="bulk" wx:if="{{isSuper}}" bindtap="openBulk" hover-class="bulk-hover">
      <view class="bulk-l">
        <text class="bulk-t">批量代录可排时间</text>
        <text class="bulk-s">可一次替全部 {{cards.length}} 位在岗人员填同一组场次；仅超管可用。</text>
      </view>
      <text class="bulk-b">开始代录</text>
    </view>

    <view class="empty" wx:if="{{!loading && !ready}}">
      <text class="empty-t">本周值班时段还没发布</text>
      <text class="empty-s">发布之后才能收可排时间。</text>
    </view>

    <view class="pc-grid">
      <view class="pc" wx:for="{{cards}}" wx:key="personId" data-id="{{item.personId}}" bindtap="openAv" hover-class="pc-hover">
        <view class="pc-top">
          <text class="pc-av">{{item.initial}}</text>
          <view class="pc-nm">
            <text class="pc-name">{{item.name}}{{item.isMe ? '（我）' : ''}}</text>
            <text class="pc-cap">{{item.cap}}</text>
          </view>
          <text class="pc-bd {{item.confirmed ? 'blue' : 'warn'}}">{{item.confirmed ? '已提交' : '未提交'}}</text>
        </view>
        <text class="pc-p">{{item.desc}}</text>
        <view class="pc-foot">
          <text class="pc-stat">{{item.statText}}</text>
          <view class="pc-right">
            <!-- 超管替别人配值班岗位（2026-10-30）。⚠️ 必须 catchtap：
                 不然会冒泡到卡片的 bindtap，点「配岗位」变成打开代录弹层。
                 ⚠️ 自己的卡片也保留这一项 —— 超管自己没配岗位时同样选不上，得能自己补 -->
            <text class="pc-role" wx:if="{{isSuper}}"
                  data-id="{{item.personId}}" catchtap="openRoleSheet">配岗位</text>
            <text class="pc-go">{{item.isMe ? '填写我的时间' : '查看／代录'}} ›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="ts-note">代录不会绕过硬条件：请假、岗位资格、场次上限照常校验；记录里能查到「谁替谁填、什么时候、为什么」。</view>
  </block>

  <view class="pad"></view>
</view>

<!-- ══════ 单人代录弹层 ══════ -->
<view class="overlay" hidden="{{!sheetOpen}}" catchtap="closeAv">
  <view class="sheet" catchtap="stop">
    <view class="sheet-hd">
      <view class="sheet-hd-l">
        <text class="sheet-t">{{avTitle}}</text>
        <text class="sheet-sub">蓝色＝能来，灰色＝不能来；点一下切换。</text>
      </view>
      <text class="sheet-x" bindtap="closeAv">关闭</text>
    </view>

    <scroll-view class="sheet-body" scroll-y>
      <view class="av-head">
        <text class="av-head-t">点一下切换：能来 / 不能来</text>
        <text class="av-head-a" bindtap="onToggleAll">{{allOn ? '取消全选' : '全选'}} ›</text>
      </view>

      <view class="days">
        <view class="day" wx:for="{{days}}" wx:key="day" wx:for-item="d" wx:for-index="di">
          <view class="day-hd">
            <text class="day-name">{{d.name}}</text>
            <text class="day-date">{{d.dateText}}</text>
            <text class="day-cnt">{{d.onCount}} / {{d.slots.length}} 个时段</text>
          </view>
          <view class="avg">
            <view class="avslot {{s.cls}}" wx:for="{{d.slots}}" wx:for-item="s" wx:for-index="si" wx:key="slotKey"
                  data-di="{{di}}" data-si="{{si}}" bindtap="onTapSlot" hover-class="avslot-hover">
              <text class="avslot-t">{{s.title}}</text>
              <text class="avslot-s">{{s.timeText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="note">
        <view class="note-hd"><text class="lbl">说明</text><text class="lbl-tip">{{reasonTip}}</text></view>
        <textarea class="ta" model:value="{{reason}}" placeholder="{{reasonPh}}" placeholder-class="ta-ph" maxlength="200" auto-height></textarea>
        <text class="cnt">{{reasonLen}}/200</text>
      </view>

      <view class="confirm" bindtap="onToggleConfirm" hover-class="confirm-hover">
        <view class="cbox {{confirmed ? 'on' : ''}}"><text class="cbox-t" wx:if="{{confirmed}}">✓</text></view>
        <text class="ctext">我确认已完整填写本周可排时间。</text>
      </view>
      <view class="pad-sm"></view>
    </scroll-view>

    <view class="sheet-foot">
      <button class="btn ghost" bindtap="closeAv">取消</button>
      <button class="btn primary" loading="{{submitting}}" bindtap="saveAv">保存</button>
    </view>
  </view>
</view>

<!-- ══════ 批量代录弹层（仅超管） ══════ -->
<view class="overlay" hidden="{{!bulkOpen}}" catchtap="closeBulk">
  <view class="sheet" catchtap="stop">
    <view class="sheet-hd">
      <view class="sheet-hd-l">
        <text class="sheet-t">批量代录可排时间</text>
        <text class="sheet-sub">选择本周可以参加的场次；保存后这些人按这次统一覆盖。</text>
      </view>
      <text class="sheet-x" bindtap="closeBulk">关闭</text>
    </view>

    <scroll-view class="sheet-body" scroll-y>
      <view class="bsec">
        <view class="bsec-hd">
          <text class="bsec-t">选择人员（{{bulkPickCount}} / {{bulkPeople.length}}）</text>
          <text class="bsec-a" bindtap="bulkAll">全选</text>
        </view>
        <view class="chips chips-3">
          <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{bulkPeople}}" wx:key="personId"
                data-id="{{item.personId}}" bindtap="toggleBulkPerson">{{item.name}}</view>
        </view>
      </view>

      <view class="bsec">
        <view class="bsec-hd">
          <text class="bsec-t">选择场次（{{bulkEventCount}} / {{bulkEvents.length}}）</text>
        </view>
        <view class="chips chips-2">
          <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{bulkEvents}}" wx:key="id"
                data-di="{{item.di}}" data-si="{{item.si}}" bindtap="toggleBulkEvent">{{item.label}}</view>
        </view>
      </view>

      <view class="note">
        <view class="note-hd"><text class="lbl">代录说明</text><text class="lbl-tip">必填</text></view>
        <textarea class="ta" model:value="{{bulkReason}}" placeholder="说明已向哪些人核实、以及统一代录的原因。" placeholder-class="ta-ph" maxlength="200" auto-height></textarea>
      </view>
      <view class="pad-sm"></view>
    </scroll-view>

    <view class="sheet-foot">
      <button class="btn ghost" bindtap="closeBulk">取消</button>
      <button class="btn primary" loading="{{bulkSaving}}" bindtap="saveBulk">保存代录</button>
    </view>
  </view>
</view>

<!-- ══════ 超管配伙伴值班岗位（2026-10-30）
     入口在人员卡片底部的「配岗位」。⚠️ 走 PUT /partner/people/:id/duty（仅超管）。
     ⚠️⚠️ **只有岗位一个维度，可多选**。部门（播音部/主持部/编辑部）由后端按岗位反推落库：
        播音→播音部、主持→主持部、编辑→编辑部（多选时取第一个命中项当主部门）。
        排班时岗位对得上就放行部门检查，所以兼两个岗位的人两个部门的时段都能上
        （陛下 2026-10-30：「改成配岗位，而且可以多选」）。 -->
<view class="overlay" hidden="{{!roleSheetOpen}}" catchtap="closeRoleSheet">
  <view class="sheet sheet-role" catchtap="stop">
    <view class="sheet-hd">
      <view class="sheet-hd-l">
        <text class="sheet-t">{{roleTargetName}} · 值班岗位</text>
        <text class="sheet-sub">可多选。部门不用另外配，系统按岗位自动归（播音→播音部、主持→主持部、编辑→编辑部）。</text>
      </view>
      <text class="sheet-x" bindtap="closeRoleSheet">关闭</text>
    </view>

    <view class="rc-sec">
      <text class="rc-sec-t">岗位（可多选，再点一下取消）</text>
      <view class="rc-chips">
        <view class="rc-chip {{item.on ? 'on' : ''}}"
              wx:for="{{roleTargetChips}}" wx:key="label"
              data-l="{{item.label}}" bindtap="onToggleTargetRole" hover-class="rc-hover">{{item.label}}</view>
      </view>
    </view>

    <view class="sheet-foot">
      <button class="btn ghost" bindtap="closeRoleSheet">取消</button>
      <button class="btn primary" loading="{{roleTargetSaving}}" bindtap="saveTargetRoles">保存</button>
    </view>
  </view>
</view>
