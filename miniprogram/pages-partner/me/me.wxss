/* 390px 设计宽；rpx = px × 750/390。
 * 背景独立铺在介绍带和卡片下，保留首行可见的桥与水池。
 * 图片底部独立渐隐柔化；卡片仅叠加半透明白，不加磨砂。
 */
.page {
  display: block;
  min-height: 100vh;
  background: #F5F5F7;
  box-sizing: border-box;
  overflow-x: hidden;
}
.sb { position: relative; z-index: 3; background: #FFFFFF; }
.nav {
  position: relative;
  z-index: 3;
  height: 44px;
  padding: 0 170rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}
.nav-t {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1D1D1F;
}
.main { position: relative; }

/* 390 × 226，左上起点，不额外降低图片透明度。 */
.bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 434.6154rpx;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.bg-img {
  position: absolute;
  top: 0; left: 0;
  width: 750rpx;
  height: auto;
  display: block;
  opacity: 1;
}
.bg-veil {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(90deg,
    rgba(255,255,255,.82) 0%,
    rgba(255,255,255,.5) 26%,
    rgba(255,255,255,.18) 42%,
    rgba(255,255,255,0) 62%);
}
/* 柔化只作用于图片下半段，由透明遮罩逐渐增强。 */
.bg-soften {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 30%;
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000000 100%);
  mask-image: linear-gradient(180deg, transparent 0%, #000000 100%);
  pointer-events: none;
}
/* 与页面同色收尾，避免图片底边直接截断。 */
.bg-fade {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg,
    rgba(245,245,247,0) 64%,
    rgba(245,245,247,.14) 78%,
    rgba(245,245,247,.62) 91%,
    #F5F5F7 100%);
  pointer-events: none;
}
.wel {
  position: relative;
  z-index: 2;
  overflow: hidden;
  border-radius: 0;
  /* 介绍带 186px：卡片比原来下移 18px，让出完整拱桥。 */
  min-height: 357.6923rpx;
  padding: 34.6154rpx 34.6154rpx 28rpx;
  box-sizing: border-box;
}
.eb {
  display: block;
  margin-bottom: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #76767E;
  letter-spacing: .5rpx;
}
.nm {
  max-width: 420rpx;
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -1rpx;
  color: #1D1D1F;
  word-break: break-all;
}
.post {
  display: block;
  max-width: 440rpx;
  margin-top: 8rpx;
  color: #76767E;
  font-size: 25rpx;
  line-height: 1.5;
}
.ten {
  margin-top: 26rpx;
  color: #76767E;
  font-size: 24rpx;
  line-height: 1.5;
}
.ten .num {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  font-variant-numeric: tabular-nums;
}

/* 白卡上移 13px；白 .31、圆角 20px、三层中性阴影。 */
.cards {
  position: relative;
  z-index: 3;
  margin: -25rpx 34.6154rpx 0;
  overflow: hidden;
  border-radius: 38.4615rpx;
  background: rgba(255,255,255,.31);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow:
    0 23.0769rpx 65.3846rpx -26.9231rpx rgba(0,0,0,.22),
    inset 0 1.9231rpx 0 rgba(255,255,255,.75),
    0 0 0 1.9231rpx rgba(255,255,255,.55);
}
.row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 110rpx;
  padding: 18rpx 30.7692rpx;
  box-sizing: border-box;
  color: #1D1D1F;
}
.row + .row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 30.7692rpx;
  right: 30.7692rpx;
  height: 1rpx;
  background: #E3E3E8;
}
.row-hover { background: rgba(0,0,0,.035); }
.ric {
  flex: none;
  width: 38rpx;
  height: 38rpx;
}
.lb {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.5;
}
.rv {
  flex: 1;
  min-width: 0;
  margin-left: auto;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: right;
  color: #B3B3B8;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}
.chev {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-left: auto;
}
.rv + .chev { margin-left: 0; }

button.logout {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(100% - 69.2308rpx);
  min-height: 100rpx;
  margin: 25rpx auto 0;
  padding: 18rpx 26rpx;
  border: 1rpx solid #E2E2E7;
  border-radius: 9999rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #FF3B30;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}
button.logout::after { border: 0; }
.logout-hover { opacity: .8; }
.dock-gap {
  height: 210rpx;
  height: calc(210rpx + env(safe-area-inset-bottom));
}

/* ══════════ 修改密码弹窗（2026-10-31 账号密码统一） ══════════
   白色面板 + 墨字，不引入任何一种新的深色件 —— 与这一页既有的
   白卡（.cards / button.logout）同一套口径。
   ⚠️ button 的样式一律写成 `button.pwd-btn`（元素+类）：app.wxss 里有
      `button.btn{display:block;width:auto}` = 特异性 (0,1,1)，单类会被静默压掉。 */
.pwd-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 90;
  background: rgba(0, 0, 0, .45);
}
.pwd-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  padding: 36rpx 34.6154rpx 34rpx;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 38.4615rpx 38.4615rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, .12);
}
.pwd-hd { margin-bottom: 26rpx; }
.pwd-t {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1D1D1F;
}
.pwd-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #76767E;
}
.pwd-field { margin-bottom: 18rpx; }
.pwd-lb {
  display: block;
  margin-bottom: 8rpx;
  font-size: 25rpx;
  color: #76767E;
}
.pwd-inp {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #F5F5F7;
  border-radius: 16rpx;
  font-size: 29rpx;
  color: #1D1D1F;
}
.pwd-ph { color: #B3B3B8; }
.pwd-err {
  display: block;
  margin: 4rpx 0 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #FF3B30;
}
.pwd-note {
  margin: 12rpx 0 24rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #76767E;
}
.pwd-acts { display: flex; }
button.pwd-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 9999rpx;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
}
button.pwd-btn::after { border: 0; }
button.pwd-btn.ghost {
  margin-right: 18rpx;
  background: #F5F5F7;
  color: #1D1D1F;
  border: 1rpx solid #E3E3E8;
}
button.pwd-btn.primary {
  background: #0066CC;
  color: #FFFFFF;
}
.pwd-btn-hover { opacity: .86; }
