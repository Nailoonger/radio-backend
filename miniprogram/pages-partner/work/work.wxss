/* pages-partner/work/work.wxss · v1（2026-10-28 稿件模块）
   数值与 review 页同源（v151 实测，1px = 1.923rpx）：
     .stabs 文字 tab + 方块数字 + 蓝下划线；.tag 小方块四色；.rows 白卡 r18 p0 16；.row padding 16 0 行间 border-top
     .mods 2 列 gap 10px（23rpx→实际用 19rpx，与工作台一致）；.mod 圆角 17 padding 12 min-height 100 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F7;
}
.body {
  flex: 1;
  padding: 19rpx 35rpx 215rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}

/* ── 顶部两张卡（继续写 / 新建） ── */
.mods { display: flex; gap: 19rpx; }
.mod {
  flex: 1;
  min-width: 0;
  background: #FFFFFF;
  border: 1rpx solid #E7E9EE;
  border-radius: 33rpx;
  padding: 23rpx;
  min-height: 196rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.mod-t { font-size: 27rpx; font-weight: 550; line-height: 1.5; color: #1D1D1F; }
.mod-d { font-size: 21rpx; color: #76767E; line-height: 1.5; margin-top: 8rpx; }
.mod-f {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 15rpx;
  padding-top: 13rpx;
}
.mod-n {
  display: flex;
  align-items: baseline;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.1;
  color: #76767E;
  font-variant-numeric: tabular-nums;
}
.mod-n.on { color: #0066CC; }
.mod-n .u { font-size: 19rpx; font-weight: 400; color: #76767E; margin-left: 8rpx; line-height: 1; }
.mod-arrow { font-size: 35rpx; line-height: 1; color: #999DA6; }

/* ── 状态 tab ── */
.stabs {
  display: flex;
  align-items: stretch;
  border-bottom: 2rpx solid #E3E3E8;
  margin: 4rpx 0 8rpx;
}
.stab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 21rpx 8rpx 25rpx;
  font-size: 25rpx;
  color: #76767E;
  position: relative;
  box-sizing: border-box;
}
.stab .n {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #E8E8ED;
  color: #76767E;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 38rpx;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
.stab.on { color: #0066CC; font-weight: 600; }
.stab.on .n { background: #EAF3FD; color: #0066CC; }
.stab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -2rpx;
  width: calc(100% - 31rpx);
  max-width: 165rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #0066CC;
}

/* ── 列表 ── */
.rows { background: #FFFFFF; border-radius: 35rpx; padding: 0 31rpx; }
.row {
  display: flex;
  align-items: flex-start;
  gap: 19rpx;
  padding: 31rpx 0;
  box-sizing: border-box;
}
.row + .row { border-top: 2rpx solid #E3E3E8; }
.row-hover { opacity: .75; }
.r-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.r-title {
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.45;
  color: #1D1D1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.r-note { font-size: 21rpx; color: #76767E; margin-top: 10rpx; }
.r-reject { font-size: 21rpx; color: #C0392B; margin-top: 8rpx; line-height: 1.5; }
.r-export { font-size: 27rpx; color: #0066CC; font-weight: 500; }
.r-meta2 { font-size: 23rpx; color: #76767E; flex: none; }

/* ── 状态标签 ── */
.tag {
  flex: none;
  font-size: 19rpx;
  font-weight: 400;
  line-height: 1.5;
  padding: 8rpx 13rpx;
  border-radius: 13rpx;
  white-space: nowrap;
}
.tag.warn { background: #FDF3DC; color: #B26A00; }
.tag.done { background: #EAF7EF; color: #1E8E4E; }
.tag.no   { background: #FDECEA; color: #C0392B; }
.tag.gray { background: #F5F5F7; color: #76767E; }

.hint-note {
  text-align: center;
  font-size: 23rpx;
  color: #76767E;
  padding: 28rpx 0;
  flex: none;
}

/* 「写一篇新的」行前的加号图标 */
.ric2 { flex: none; width: 34rpx; height: 34rpx; }
