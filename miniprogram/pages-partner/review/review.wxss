/* pages-partner/review/review.wxss · v2（2026-10-28 审核线对齐 v151）
   ⚠️ 数值全部来自 partner-hub/app.html 的 headless Chrome 实测（.stabs / .ftags / .rows / .row /
      .tag / .sm2），1px = 1.923rpx：
        stabs   margin 2px 0 4px、底边 1px #E3E3E8、按钮 flex:1 padding 11/4/13 fs13 gap6
                .n  min-w 20 h20 padding 0 6 radius 6 bg #E8E8ED；选中 #EAF3FD + #0066CC
                选中下划线 高 2px、宽 calc(100% - 16px)、max 86px
        ftags   gap 8、按钮 padding 7/14 radius 7 fs 11.5、底 #F5F5F7、选中 #EAF3FD + 600
                ⚠️ 2026-10-29 改：底 #F5F5F7 与页面底同色 ⇒ 未选中看不见胶囊，压到 #EBEBEF、
                   fs 11.5→13、padding 7/14→7.5/15、radius 7→8（见 .ftag 处注释）
        rows    白卡 radius 18、padding 0 16
        row     padding 16px 0、gap 10、行间 border-top 1px
        tag     fs 10 padding 4/7 radius 7（warn/done/no/ok 四色）
        sm2     fs 12 padding 9/14 radius 12、底 #F5F5F7 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F7;
}

/* 返回箭头（app.wxss 的 .navbar-back 只给了圆底，箭头要自己画） */
.chev {
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--ink-2);
  border-bottom: 4rpx solid var(--ink-2);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

/* 原型 .view：padding 10 18 112 ⇒ 内容左右 35rpx */
.body {
  flex: 1;
  padding: 19rpx 35rpx 215rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;                /* .layer + .layer 12px 与 .stack gap 12px */
}

/* ══════════ 状态 tab（.stabs） ══════════ */
.stabs {
  display: flex;
  align-items: stretch;
  border-bottom: 2rpx solid #E3E3E8;
  margin: 4rpx 0 8rpx;
}
.stab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 21rpx 8rpx 25rpx;
  font-size: 25rpx;
  color: #76767E;
  position: relative;
  box-sizing: border-box;
}
.stab .n {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #E8E8ED;
  color: #76767E;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 38rpx;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
.stab.on { color: #0066CC; font-weight: 600; }
.stab.on .n { background: #EAF3FD; color: #0066CC; }
.stab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -2rpx;
  width: calc(100% - 31rpx);
  max-width: 165rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #0066CC;
}

/* ══════════ 类型标签（.ftags） ══════════
   ⚠️⚠️ 未选中也必须**看得见是一颗胶囊**：原来底是 #F5F5F7，跟页面底 #F5F5F7 一模一样，
      渲染出来就是"光秃秃四个字"，像没做样式（陛下 2026-10-29 打回）。
      灰底压到 #EBEBEF（比页面底深一档），字号 11px → 13px 再放大一级。 */
.ftags { display: flex; gap: 15rpx; }
.ftag {
  background: #EBEBEF;
  border-radius: 16rpx;
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  color: #5F5F66;
  line-height: 1;
}
.ftag.on { background: #EAF3FD; color: #0066CC; font-weight: 600; }

/* ══════════ 列表（.rows / .row） ══════════ */
.rows {
  background: #FFFFFF;
  border-radius: 35rpx;
  padding: 0 31rpx;
}
.row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 19rpx;
  padding: 31rpx 0;
  box-sizing: border-box;
}
.row + .row { border-top: 2rpx solid #E3E3E8; }
.row-hover { opacity: .75; }
.r-main { flex: 1; min-width: 0; }
.r-top { display: flex; align-items: center; gap: 13rpx; }
.r-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #1D1D1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.r-note {
  display: block;
  font-size: 21rpx;
  color: #76767E;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.r-meta {
  display: block;
  font-size: 21rpx;
  color: #76767E;
  margin-top: 6rpx;
}
.r-time {
  display: block;
  font-size: 21rpx;
  color: #B3B3B8;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

/* 待审行的动作：换满一行、右对齐（原型 flex-basis:100% + justify-content:flex-end） */
.r-act {
  flex-basis: 100%;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

/* ══════════ 类型 / 状态 小方块标签（.tag） ══════════ */
.tag {
  flex: none;
  font-size: 19rpx;              /* 10px */
  font-weight: 400;
  line-height: 1.5;
  padding: 8rpx 13rpx;           /* 4px 7px */
  border-radius: 13rpx;          /* 7px */
  white-space: nowrap;
}
.tag.warn { background: #FDF3DC; color: #B26A00; }   /* 点歌 */
.tag.ok   { background: #EAF3FD; color: #0066CC; }   /* 文稿 / 留言 */
.tag.done { background: #EAF7EF; color: #1E8E4E; }   /* 已通过 */
.tag.no   { background: #FDECEA; color: #C0392B; }   /* 已驳回 / 已屏蔽 */

/* ══════════ 行内动作按钮（.sm2） ══════════ */
button.sm2 {
  flex: none;
  font-size: 23rpx;              /* 12px */
  font-weight: 500;
  line-height: 1;
  padding: 17rpx 27rpx;          /* 9px 14px */
  border-radius: 23rpx;          /* 12px */
  background: #F5F5F7;
  color: #0066CC;
  margin: 0;
  border: 0;
}
button.sm2::after { border: 0; }
button.sm2.q { color: #76767E; font-weight: 400; }

/* ══════════ 提示行 ══════════ */
.hint-note {
  text-align: center;
  font-size: 23rpx;
  color: #76767E;
  padding: 28rpx 0;
  flex: none;
}

.pressed { opacity: 0.72; }
