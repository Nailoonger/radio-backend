<!-- pages-partner/review/review.wxml · v2（2026-10-28 审核线对齐 v151）
     事实源：partner-hub/app.html V.submissions（v89 定稿）+ headless Chrome 实测几何。
     结构：状态＝文字 tab + 小方块数字 + 选中蓝下划线（.stabs）
           类型＝小方角浅灰块（.ftags）
           列表＝白卡（.rows）+ 行内分隔线（.row），待审行底部右对齐 通过 / 驳回
     换算：1px = 1.923rpx

     类型三档照 v151「点歌 / 文稿 / 留言」；原型里的「内部稿件 / 加油稿」后端没有对应表，
     不给假入口。留言走 /admin/message/*（另一张表），状态第三档文案是「已屏蔽」。 -->
<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px"></view>

  <!-- ⚠️ 审核是**底部 tab 页**（v151 TABS），不是二级页 ⇒ 没有返回箭头，
       标题居中、底栏常驻。返回箭头只属于 review-detail / availability 这类二级页。 -->
  <view class="navbar">
    <view class="navbar-spacer"></view>
    <view class="navbar-title">审核</view>
    <view class="navbar-spacer"></view>
  </view>

  <view class="body">
    <!-- 2026-10-31：社干被超管关掉「审核权限」时的整页拒绝态。
         只给一句实话，不给空列表 —— 空列表会让人以为「今天没人投稿」。 -->
    <view class="deny" wx:if="{{denied}}">
      <text class="deny-t">{{denyReview}}</text>
      <text class="deny-d">超管没有给你开审核模块的权限。要用，找超管在「权限管理」里开一下。</text>
    </view>

    <block wx:else>
    <!-- 状态：待审核 / 已通过 / 已驳回（留言为「已屏蔽」） -->
    <view class="stabs">
      <view class="stab {{stateIdx === index ? 'on' : ''}}"
            wx:for="{{stateLabels}}" wx:key="*this"
            data-idx="{{index}}" bindtap="switchState">
        <text>{{item}}</text>
        <text class="n">{{counts[index]}}</text>
      </view>
    </view>

    <!-- 类型：点歌 / 文稿 / 留言 -->
    <view class="ftags">
      <view class="ftag {{kindIdx === index ? 'on' : ''}}"
            wx:for="{{kindLabels}}" wx:key="*this"
            data-idx="{{index}}" bindtap="switchKind">{{item}}</view>
    </view>

    <view class="hint-note" wx:if="{{loading && list.length === 0}}">正在加载……</view>

    <view class="hint-note" wx:elif="{{list.length === 0}}">
      这一类当前没有条目（换个筛选看看）
    </view>

    <view class="rows" wx:else>
      <view class="row {{item.pending ? 'tap' : ''}}"
            wx:for="{{list}}" wx:key="id"
            hover-class="row-hover"
            data-id="{{item.id}}" bindtap="onItemTap">
        <view class="r-main">
          <view class="r-top">
            <text class="tag {{item.tagCls}}">{{item.kindText}}</text>
            <text class="r-title">{{item.title}}</text>
          </view>
          <text class="r-note" wx:if="{{item.note}}">{{item.note}}</text>
          <text class="r-meta">{{item.meta}}</text>
          <text class="r-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>

        <!-- 待审：一行两个动作（原型 flex-basis 100% 换行右对齐） -->
        <view class="r-act" wx:if="{{item.pending}}">
          <button class="sm2" hover-class="pressed" catchtap="onApprove" data-id="{{item.id}}">通过</button>
          <button class="sm2 q" hover-class="pressed" catchtap="onReject" data-id="{{item.id}}">驳回</button>
        </view>
        <!-- 非待审：只给结论 -->
        <text class="tag {{item.tagCls}}" wx:else>{{item.stateText}}</text>
      </view>
    </view>

    <view class="hint-note" wx:if="{{list.length && hasMore}}">上滑加载更多</view>
    <view class="hint-note" wx:elif="{{list.length && !hasMore}}">没有更多了</view>
    </block>
  </view>
</view>

<!-- 底部导航（tab 页常驻，审核高亮） -->
<partner-tabbar wx:if="{{ready}}" role="{{roleKey}}" active="submissions" badges="{{badges}}" bind:switch="onTab"/>
