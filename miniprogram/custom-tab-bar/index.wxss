/* custom-tab-bar/index.wxss
 * 胶囊浮动底部导航。色值写死（不依赖 app.wxss 的变量），避免组件样式隔离带来的不确定性。
 * 设计稿：容器高 94px，胶囊 62px / 圆角 36px / 内边距 4px，选中项实心墨黑 + 白图标。
 * rpx = 设计px × 1.923
 * 左右内边距 40rpx 与页面 .body / .bottom-cta 对齐 → 胶囊和页面里的块级按钮等宽。
 *
 * 动效口径见 index.js 顶部「动画契约 v11」。一句话：
 *   指示器只动 transform（合成层，零重排），起点由 keyframe 写死，一次 setData 完成一次滑动。
 *   ⚠️ 不要再给 .indicator 加 left / width / scaleY 的动画 —— 那是抽搐的唯一来源。
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: transparent;   /* 容器不做任何底色 —— 只留胶囊浮着 */
  padding: 24rpx 40rpx calc(42rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 40rpx calc(42rpx + env(safe-area-inset-bottom));
}

/* 隐藏态：胶囊退到屏幕外（容器已无底色，不再存在"一块白板出现"的问题） */
.tabbar-hidden {
  pointer-events: none;
}
.tabbar-hidden .pill {
  transform: translateY(220%);
}

/* 退场：胶囊自下而上滑入 */
.tabbar-enter .pill {
  animation: pillUp 480ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes pillUp {
  from { transform: translateY(220%); }
  to   { transform: translateY(0); }
}

.pill {
  position: relative;          /* 滑动指示器的定位基准 */
  height: 124rpx;
  box-sizing: border-box;
  display: flex;
  padding: 8rpx;
  border: 2rpx solid #E6E6E8;
  border-radius: 72rpx;
  background: #FFFFFF;
  overflow: hidden;            /* 指示器滑出胶囊范围时裁掉 */
}

/* 定位空间与四个 flex Tab 的内容区域一致。 */
.indicator-track {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  right: 8rpx;
  pointer-events: none;
}

/* 指示器底盘。宽度恒为 25%，位移靠 translateX(100%) 一格一格走。
 * opacity 默认 0：实例刚建出来还不知道自己该在哪格，先不画，
 * 避免第一帧闪在默认位置 —— 页面 onShow 会立刻给它 ind-rest-<n> 或 ind-<from><to>。 */
.indicator {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 25%;
  border-radius: 999rpx;
  background: #1D1D1F;
  transform: translateX(0);
  opacity: 0;
  will-change: transform;
}

/* ── 静态落位（无动画）：页面 onShow 拿不到来源格时用 ────────────── */
.ind-rest-0 { opacity: 1; transform: translateX(0%); }
.ind-rest-1 { opacity: 1; transform: translateX(100%); }
.ind-rest-2 { opacity: 1; transform: translateX(200%); }
.ind-rest-3 { opacity: 1; transform: translateX(300%); }

/* ── 滑动 + 拖尾：12 组 from→to 全部写死 ──────────────────────────
 * 为什么不用 CSS 变量 / transition 从当前样式出发：
 *   起点必须是「用户刚才看到的那一格」，而元素的当前样式在实例复用时是脏的。
 *   把 from 写进关键帧，浏览器无条件从这一格开始，跟历史状态无关。
 * 只有 4 格 ⇒ 4×3 = 12 组，穷举比任何时序技巧都可靠。
 *
 * 拖尾（2026-11-19 补回）：前沿先冲出去、后沿滞后跟上，中途拉长再收回。
 *   旧版是靠动 left + width 拉长 —— 布局属性，每帧重排，正是抽搐的主因；
 *   这里改用 translateX + scaleX，纯合成层，一个像素都不重排。
 *   ⚠️ scaleX 的支点必须跟着方向切：向右时支点放在左边缘（transform-origin: 0 50%，
 *   后沿在左），向左时放在右边缘（100% 50%）。支点放错，被拉长的那一头就成了后沿，
 *   拖尾会整个反向 —— 看着像"先缩后伸"。
 *   四段 ease-out 是旧版的手感（每段收一次速），别改成一条连续缓动。
 *   竖向挤压（旧版的 scaleY 0.90→1.02）没有搬回来：它只在纵向上抖一下，
 *   跟横向拖尾不在一个节奏上，是"抽搐"的来源之一。 */
.ind-01 { opacity: 1; transform-origin: 0 50%;   animation: ind01 240ms ease-out both; }
.ind-02 { opacity: 1; transform-origin: 0 50%;   animation: ind02 240ms ease-out both; }
.ind-03 { opacity: 1; transform-origin: 0 50%;   animation: ind03 240ms ease-out both; }
.ind-12 { opacity: 1; transform-origin: 0 50%;   animation: ind12 240ms ease-out both; }
.ind-13 { opacity: 1; transform-origin: 0 50%;   animation: ind13 240ms ease-out both; }
.ind-23 { opacity: 1; transform-origin: 0 50%;   animation: ind23 240ms ease-out both; }
.ind-10 { opacity: 1; transform-origin: 100% 50%; animation: ind10 240ms ease-out both; }
.ind-20 { opacity: 1; transform-origin: 100% 50%; animation: ind20 240ms ease-out both; }
.ind-30 { opacity: 1; transform-origin: 100% 50%; animation: ind30 240ms ease-out both; }
.ind-21 { opacity: 1; transform-origin: 100% 50%; animation: ind21 240ms ease-out both; }
.ind-31 { opacity: 1; transform-origin: 100% 50%; animation: ind31 240ms ease-out both; }
.ind-32 { opacity: 1; transform-origin: 100% 50%; animation: ind32 240ms ease-out both; }

/* 每组的四拍：0% 原位 → 35% 前沿冲出去（宽度拉到 1+0.62d 格）→
 * 74% 后沿追上来、略微撞过终点 → 100% 归位。d = 跨了几格。 */
@keyframes ind01 {
  0%   { transform: translateX(0%)    scaleX(1); }
  35%  { transform: translateX(6%)    scaleX(1.62); }
  74%  { transform: translateX(95%)   scaleX(1.06); }
  100% { transform: translateX(100%)  scaleX(1); }
}
@keyframes ind02 {
  0%   { transform: translateX(0%)    scaleX(1); }
  35%  { transform: translateX(12%)   scaleX(2.24); }
  74%  { transform: translateX(190%)  scaleX(1.12); }
  100% { transform: translateX(200%)  scaleX(1); }
}
@keyframes ind03 {
  0%   { transform: translateX(0%)    scaleX(1); }
  35%  { transform: translateX(18%)   scaleX(2.86); }
  74%  { transform: translateX(285%)  scaleX(1.18); }
  100% { transform: translateX(300%)  scaleX(1); }
}
@keyframes ind12 {
  0%   { transform: translateX(100%)  scaleX(1); }
  35%  { transform: translateX(106%)  scaleX(1.62); }
  74%  { transform: translateX(195%)  scaleX(1.06); }
  100% { transform: translateX(200%)  scaleX(1); }
}
@keyframes ind13 {
  0%   { transform: translateX(100%)  scaleX(1); }
  35%  { transform: translateX(112%)  scaleX(2.24); }
  74%  { transform: translateX(290%)  scaleX(1.12); }
  100% { transform: translateX(300%)  scaleX(1); }
}
@keyframes ind23 {
  0%   { transform: translateX(200%)  scaleX(1); }
  35%  { transform: translateX(206%)  scaleX(1.62); }
  74%  { transform: translateX(295%)  scaleX(1.06); }
  100% { transform: translateX(300%)  scaleX(1); }
}
@keyframes ind10 {
  0%   { transform: translateX(100%)  scaleX(1); }
  35%  { transform: translateX(94%)   scaleX(1.62); }
  74%  { transform: translateX(5%)    scaleX(1.06); }
  100% { transform: translateX(0%)    scaleX(1); }
}
@keyframes ind20 {
  0%   { transform: translateX(200%)  scaleX(1); }
  35%  { transform: translateX(188%)  scaleX(2.24); }
  74%  { transform: translateX(10%)   scaleX(1.12); }
  100% { transform: translateX(0%)    scaleX(1); }
}
@keyframes ind30 {
  0%   { transform: translateX(300%)  scaleX(1); }
  35%  { transform: translateX(282%)  scaleX(2.86); }
  74%  { transform: translateX(15%)   scaleX(1.18); }
  100% { transform: translateX(0%)    scaleX(1); }
}
@keyframes ind21 {
  0%   { transform: translateX(200%)  scaleX(1); }
  35%  { transform: translateX(194%)  scaleX(1.62); }
  74%  { transform: translateX(105%)  scaleX(1.06); }
  100% { transform: translateX(100%)  scaleX(1); }
}
@keyframes ind31 {
  0%   { transform: translateX(300%)  scaleX(1); }
  35%  { transform: translateX(288%)  scaleX(2.24); }
  74%  { transform: translateX(110%)  scaleX(1.12); }
  100% { transform: translateX(100%)  scaleX(1); }
}
@keyframes ind32 {
  0%   { transform: translateX(300%)  scaleX(1); }
  35%  { transform: translateX(294%)  scaleX(1.62); }
  74%  { transform: translateX(205%)  scaleX(1.06); }
  100% { transform: translateX(200%)  scaleX(1); }
}

.tab {
  position: relative;          /* 图标/文字要压在指示器上面 */
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 52rpx;
}

/* 图标容器：按压反馈的缩放作用层 */
.tab-icon-wrap {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  transition: transform 120ms ease-out;
}

/* 常态图标与选中图标叠放，用透明度交叉淡入——
 * 替代原来的 src 切换：瞬时不翻面，也消除 iconOn 首次点击才加载的闪白。
 * 400ms 与指示器 260ms 同一段落点，视觉上像"胶囊把图标点亮"。 */
.tab-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
}

.tab-icon-on {
  opacity: 0;
  transition: opacity 400ms cubic-bezier(.22,.61,.36,1);
}

.tab-icon-on.show {
  opacity: 1;
}

/* 按下即反馈：touch-down 触发（hover-start-time=0），不等松手 */
.tab-press .tab-icon-wrap {
  transform: scale(0.9);
}

.tab-label {
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 1rpx;
  color: #7A7A7A;
  transition: color 400ms cubic-bezier(.22,.61,.36,1);
}

.tab.on .tab-label {
  color: #FFFFFF;
}

/* 选中落地的微弹：挂在 .on 上，由 class 变化自然触发，
 * 不靠 JS 打 motionClass（旧写法「先 false 再 true」两次 setData 会被合并，弹不出来）。 */
.tab.on .tab-icon-wrap {
  animation: tabIconBounce 360ms cubic-bezier(.22,.61,.36,1);
}
@keyframes tabIconBounce {
  0% { transform: scale(1); }
  22% { transform: scale(.84); }
  62% { transform: scale(1.06); }
  100% { transform: scale(1); }
}
