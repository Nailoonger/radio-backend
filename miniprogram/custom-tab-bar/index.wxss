/* custom-tab-bar/index.wxss
 * 胶囊浮动底部导航。色值写死（不依赖 app.wxss 的变量），避免组件样式隔离带来的不确定性。
 * 设计稿：容器高 94px，胶囊 62px / 圆角 36px / 内边距 4px，选中项实心墨黑 + 白图标。
 * rpx = 设计px × 1.923
 * 左右内边距 40rpx 与页面 .body / .bottom-cta 对齐 → 胶囊和页面里的块级按钮等宽。
 *
 * 动效口径见 index.js 顶部「动画契约 v11」。一句话：
 *   指示器只动 transform（合成层，零重排），起点由 keyframe 写死，一次 setData 完成一次滑动。
 *   ⚠️ 不要再给 .indicator 加 left / width / scaleY 的动画 —— 那是抽搐的唯一来源。
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: transparent;   /* 容器不做任何底色 —— 只留胶囊浮着 */
  padding: 24rpx 40rpx calc(42rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 40rpx calc(42rpx + env(safe-area-inset-bottom));
}

/* 隐藏态：胶囊退到屏幕外（容器已无底色，不再存在"一块白板出现"的问题） */
.tabbar-hidden {
  pointer-events: none;
}
.tabbar-hidden .pill {
  transform: translateY(220%);
}

/* 退场：胶囊自下而上滑入 */
.tabbar-enter .pill {
  animation: pillUp 480ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes pillUp {
  from { transform: translateY(220%); }
  to   { transform: translateY(0); }
}

.pill {
  position: relative;          /* 滑动指示器的定位基准 */
  height: 124rpx;
  box-sizing: border-box;
  display: flex;
  padding: 8rpx;
  border: 2rpx solid #E6E6E8;
  border-radius: 72rpx;
  background: #FFFFFF;
  overflow: hidden;            /* 指示器滑出胶囊范围时裁掉 */
}

/* 定位空间与四个 flex Tab 的内容区域一致。 */
.indicator-track {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  right: 8rpx;
  pointer-events: none;
}

/* 指示器底盘：一格宽，两端是标准的半圆（border-radius 999rpx 会被浏览器 clamp 到
 * 高度的一半 —— 所以宽度怎么变，两端弧度都恒等于半圆）。
 * ⚠️⚠️ 这里**必须**用 left + width 做拖尾，不能用 translateX + scaleX。
 *   scaleX 会连 border-radius 一起横向缩放 ⇒ 两端变成被拉扁的椭圆尖（2026-11-19 陛下退回）。
 *   代价是 left/width 会触发重排 —— 但这是绝对定位、无后代、无文字的单个纯色块，
 *   重排范围就这一小块；旧版抽搐的真因不是它（是两段 setData 导致起点错位 + 纵向挤压
 *   + 在错误的位置补演），那些已经修掉了。形状正确优先。
 * opacity 默认 0：实例刚建出来还不知道自己该在哪格，先不画，
 * 避免第一帧闪在默认位置 —— 页面 onShow 会立刻给它 ind-rest-<n> 或 ind-<from><to>。 */
.indicator {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 25%;
  border-radius: 999rpx;
  background: #1D1D1F;
  opacity: 0;
}

/* ── 静态落位（无动画）：页面 onShow 拿不到来源格时用 ────────────── */
.ind-rest-0 { opacity: 1; left: 0%; }
.ind-rest-1 { opacity: 1; left: 25%; }
.ind-rest-2 { opacity: 1; left: 50%; }
.ind-rest-3 { opacity: 1; left: 75%; }

/* ── 滑动 + 拖尾：12 组 from→to 全部写死 ──────────────────────────
 * 为什么不用 CSS 变量 / transition 从当前样式出发：
 *   起点必须是「用户刚才看到的那一格」，而元素的当前样式在实例复用时是脏的。
 *   把 from 写进关键帧，浏览器无条件从这一格开始，跟历史状态无关。
 * 只有 4 格 ⇒ 4×3 = 12 组，穷举比任何时序技巧都可靠。
 *
 * 四拍（d = 跨了几格）：
 *   0%   后沿在 from 格、宽 1 格
 *   35%  前沿先冲出去（右移冲 68%，左移同理），后沿只挪了 6% ⇒ 中间被拉长到 1+0.62d 格
 *   74%  后沿追上来，前沿略微撞过终点 1%
 *   100% 收成一格，落在 to 格
 * 每拍 ease-out，保留旧版那种分段收力的手感（别合成一条连续缓动）。
 * 两端弧度由 999rpx 保证，与宽度无关。 */
.ind-01 { opacity: 1; animation: ind01 240ms ease-out both; }
.ind-02 { opacity: 1; animation: ind02 240ms ease-out both; }
.ind-03 { opacity: 1; animation: ind03 240ms ease-out both; }
.ind-10 { opacity: 1; animation: ind10 240ms ease-out both; }
.ind-12 { opacity: 1; animation: ind12 240ms ease-out both; }
.ind-13 { opacity: 1; animation: ind13 240ms ease-out both; }
.ind-20 { opacity: 1; animation: ind20 240ms ease-out both; }
.ind-21 { opacity: 1; animation: ind21 240ms ease-out both; }
.ind-23 { opacity: 1; animation: ind23 240ms ease-out both; }
.ind-30 { opacity: 1; animation: ind30 240ms ease-out both; }
.ind-31 { opacity: 1; animation: ind31 240ms ease-out both; }
.ind-32 { opacity: 1; animation: ind32 240ms ease-out both; }

@keyframes ind01 {
  0%   { left: 0%; width: 25%; }
  35%  { left: 1.5%; width: 40.5%; }
  74%  { left: 23.75%; width: 26.5%; }
  100% { left: 25%; width: 25%; }
}
@keyframes ind02 {
  0%   { left: 0%; width: 25%; }
  35%  { left: 3%; width: 56%; }
  74%  { left: 47.5%; width: 28%; }
  100% { left: 50%; width: 25%; }
}
@keyframes ind03 {
  0%   { left: 0%; width: 25%; }
  35%  { left: 4.5%; width: 71.5%; }
  74%  { left: 71.25%; width: 29.5%; }
  100% { left: 75%; width: 25%; }
}
@keyframes ind10 {
  0%   { left: 25%; width: 25%; }
  35%  { left: 8%; width: 40.5%; }
  74%  { left: -0.25%; width: 26.5%; }
  100% { left: 0%; width: 25%; }
}
@keyframes ind12 {
  0%   { left: 25%; width: 25%; }
  35%  { left: 26.5%; width: 40.5%; }
  74%  { left: 48.75%; width: 26.5%; }
  100% { left: 50%; width: 25%; }
}
@keyframes ind13 {
  0%   { left: 25%; width: 25%; }
  35%  { left: 28%; width: 56%; }
  74%  { left: 72.5%; width: 28%; }
  100% { left: 75%; width: 25%; }
}
@keyframes ind20 {
  0%   { left: 50%; width: 25%; }
  35%  { left: 16%; width: 56%; }
  74%  { left: -0.5%; width: 28%; }
  100% { left: 0%; width: 25%; }
}
@keyframes ind21 {
  0%   { left: 50%; width: 25%; }
  35%  { left: 33%; width: 40.5%; }
  74%  { left: 24.75%; width: 26.5%; }
  100% { left: 25%; width: 25%; }
}
@keyframes ind23 {
  0%   { left: 50%; width: 25%; }
  35%  { left: 51.5%; width: 40.5%; }
  74%  { left: 73.75%; width: 26.5%; }
  100% { left: 75%; width: 25%; }
}
@keyframes ind30 {
  0%   { left: 75%; width: 25%; }
  35%  { left: 24%; width: 71.5%; }
  74%  { left: -0.75%; width: 29.5%; }
  100% { left: 0%; width: 25%; }
}
@keyframes ind31 {
  0%   { left: 75%; width: 25%; }
  35%  { left: 41%; width: 56%; }
  74%  { left: 24.5%; width: 28%; }
  100% { left: 25%; width: 25%; }
}
@keyframes ind32 {
  0%   { left: 75%; width: 25%; }
  35%  { left: 58%; width: 40.5%; }
  74%  { left: 49.75%; width: 26.5%; }
  100% { left: 50%; width: 25%; }
}

.tab {
  position: relative;          /* 图标/文字要压在指示器上面 */
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 52rpx;
}

/* 图标容器：按压反馈的缩放作用层 */
.tab-icon-wrap {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  transition: transform 120ms ease-out;
}

/* 常态图标与选中图标叠放，用透明度交叉淡入——
 * 替代原来的 src 切换：瞬时不翻面，也消除 iconOn 首次点击才加载的闪白。
 * 400ms 与指示器 260ms 同一段落点，视觉上像"胶囊把图标点亮"。 */
.tab-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
}

.tab-icon-on {
  opacity: 0;
  transition: opacity 400ms cubic-bezier(.22,.61,.36,1);
}

.tab-icon-on.show {
  opacity: 1;
}

/* 按下即反馈：touch-down 触发（hover-start-time=0），不等松手 */
.tab-press .tab-icon-wrap {
  transform: scale(0.9);
}

.tab-label {
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 1rpx;
  color: #7A7A7A;
  transition: color 400ms cubic-bezier(.22,.61,.36,1);
}

.tab.on .tab-label {
  color: #FFFFFF;
}

/* 选中落地的微弹：挂在 .on 上，由 class 变化自然触发，
 * 不靠 JS 打 motionClass（旧写法「先 false 再 true」两次 setData 会被合并，弹不出来）。 */
.tab.on .tab-icon-wrap {
  animation: tabIconBounce 360ms cubic-bezier(.22,.61,.36,1);
}
@keyframes tabIconBounce {
  0% { transform: scale(1); }
  22% { transform: scale(.84); }
  62% { transform: scale(1.06); }
  100% { transform: scale(1); }
}
