<!-- custom-tab-bar/index.wxml -->
<view class="tabbar {{noanim ? 'noanim' : ''}} {{hidden ? 'tabbar-hidden' : ''}} {{enter ? 'tabbar-enter' : ''}}">
  <view class="pill">
    <view class="indicator-track">
      <view class="indicator {{revealed ? '' : 'indicator-off'}}" animation="{{indicatorAnimation}}"></view>
    </view>
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab {{visualSelected === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="tab-press"
      hover-start-time="0"
      hover-stay-time="120"
    >
      <view class="tab-icon-wrap {{motionClass && visualSelected === index ? 'tab-icon-bounce' : ''}}">
        <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" />
        <image class="tab-icon tab-icon-on {{visualSelected === index ? 'show' : ''}}" src="{{item.iconOn}}" mode="aspectFit" />
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
