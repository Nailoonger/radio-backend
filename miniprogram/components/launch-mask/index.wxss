/* components/launch-mask/index.wxss
 * 方案 B「留白开场」：白底 + 彩色站徽 + 强调色声波。
 * （深色方案 A 为：深底 + 单色徽标 + 亮蓝声波，素材与色值见 Ardot 效果板 A/B 两帧）
 *
 * 踩坑记录：所有入场动画必须带 animation-fill-mode: both，
 * 否则延迟期内元素会先以"最终态"亮一下再跳回起点（可见闪烁）。
 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 1;
  transition: opacity 420ms ease, transform 420ms ease;
}

.mask.leaving {
  opacity: 0;
  transform: scale(1.035);
}

.mask.gone {
  display: none;
}

/* ---------- 品牌区 ---------- */
.brand {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 120rpx;
}

.badge {
  width: 200rpx;
  height: 200rpx;
  opacity: 0;
  transform: scale(0.86);
  animation: badgeIn 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 100ms both;
}

@keyframes badgeIn {
  0%   { opacity: 0; transform: scale(0.86); }
  65%  { opacity: 1; transform: scale(1.05); }
  100% { opacity: 1; transform: scale(1); }
}

.wordmark {
  display: flex;
  align-items: flex-end;
  /* 设计稿里五个字 = 字距 2px + 间隔 2px，漏了 gap 字距会少一半 */
  gap: 4rpx;
  margin-top: 50rpx;
}

.ch {
  font-size: 42rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: 4rpx;
  opacity: 0;
  transform: translateY(28rpx);
  animation: charIn 350ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

@keyframes charIn {
  0%   { opacity: 0; transform: translateY(28rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.tagline {
  margin-top: 26rpx;
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: #7A7A7A;
  opacity: 0;
  transform: translateY(16rpx);
  animation: fadeUp 350ms ease-out 1100ms both;
}

@keyframes fadeUp {
  0%   { opacity: 0; transform: translateY(16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* ---------- 声波（兼任加载态） ---------- */
.wave {
  height: 56rpx;
  margin-bottom: 52rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bar {
  width: 8rpx;
  border-radius: 4rpx;
  transform: scaleY(0.08);
  opacity: 0;
  animation: barIn 350ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.bar-in {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  background: #0066CC;
  animation: barPulse 640ms ease-in-out infinite;
}

@keyframes barIn {
  0%   { transform: scaleY(0.08); opacity: 0; }
  100% { transform: scaleY(1); opacity: 1; }
}

@keyframes barPulse {
  0%, 100% { transform: scaleY(1); }
  50%      { transform: scaleY(0.45); }
}

.caption {
  margin-bottom: 172rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #C7C7CC;
  opacity: 0;
  animation: fadeUp 350ms ease-out 1350ms both;
}
