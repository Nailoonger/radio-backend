# 复制成 .env.local 后按需修改（vite 只读取 VITE_ 前缀的变量）

# ── 请求通道（阶段 9）───────────────────────────────────────────────
# direct = 直连原 Express 后端（现状，走 /api 代理）
# cloud  = 走云开发的「HTTP 访问服务」，免服务器
# 不设本变量 = direct，行为与改动前完全一致（随时可切回）
VITE_REQUEST_MODE=direct

# 仅 cloud 模式需要：云开发控制台 → HTTP 访问服务 → 给 api 云函数配的触发路径
# 形如 https://<envId>-<数字>.ap-shanghai.app.tcloudbase.com/api
VITE_CLOUD_API_URL=

# ── direct 模式用 ───────────────────────────────────────────────────
# 接口前缀（默认 /api，由 vite 代理到后端）
VITE_API_BASE=/api
# vite dev 的代理目标（服务器上由 nginx 转发，一般不用改）
VITE_API_PROXY_TARGET=http://localhost:3000
