{
  "name": "radio-backend",
  "version": "1.0.0",
  "description": "菁悠广播站微信小程序后端 - 投稿/点歌/节目/公告/留言 全栈API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node src/utils/seed.js",
    "db:init": "node src/utils/init-db.js",

    "//": "云开发网关 —— 改完 cloud/ 必须 sync 再部署（见 cloud/scripts/deploy-cloud.js 头注）",
    "cloud:sync": "node cloud/scripts/sync.js",
    "cloud:selfcheck": "node cloud/scripts/selfcheck.js",
    "cloud:deploy": "node cloud/scripts/deploy-cloud.js",

    "//contract": "前后端接口对齐：check 抓路径写错，verify 抓字段漂移",
    "check:contract": "node cloud/scripts/check-contract.js",
    "verify:contract": "node cloud/scripts/verify-contract.js",
    "test:partner": "node cloud/scripts/test-partner-duty.js",
    "test:concurrency": "node cloud/scripts/test-concurrency.js",
    "check:all": "node cloud/scripts/check-contract.js && node cloud/scripts/verify-contract.js && node cloud/scripts/selfcheck.js && node cloud/scripts/test-gateway.js && node cloud/scripts/test-concurrency.js"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "school",
    "radio"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
