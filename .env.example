# ========== 服务基础配置 ==========
NODE_ENV=development
PORT=3000
# 跨域白名单，逗号分隔，* 表示全部放行
CORS_ORIGIN=*

# ========== 数据库配置 ==========
# DB_DIALECT: mysql | sqlite
DB_DIALECT=sqlite
DB_STORAGE=./data/radio.db
# MySQL 配置（生产环境使用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radio_station
DB_USER=root
DB_PASSWORD=root123

# ========== JWT 配置 ==========
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ========== 微信小程序配置 ==========
# 在微信公众平台 https://mp.weixin.qq.com 获取
WECHAT_APPID=wx_your_appid
WECHAT_SECRET=your_app_secret
# code2session 接口
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ========== 订阅消息（可选） ==========
WECHAT_SUBSCRIBE_TEMPLATE_ID=

# ========== 内容安全（可选，启用微信官方敏感词检测） ==========
WECHAT_SECURITY_CHECK=0
WECHAT_MSG_CHECK_URL=https://api.weixin.qq.com/wxa/msg_sec_check

# ========== 管理端默认超级管理员（首次启动时自动创建） ==========
INIT_ADMIN_USERNAME=teacher
INIT_ADMIN_PASSWORD=admin123456
INIT_ADMIN_NICKNAME=指导老师